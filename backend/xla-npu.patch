+          Literal destination_literal(index_shape);
+          for (int64_t row = 0; row < row_count; ++row) {
+            row_literal.Set<int32_t>({row, 0}, rows[row]);
+            destination_literal.Set<int32_t>({row, 0}, destinations[row]);
