+    if (scatter_metadata_->reduction == NpuScatterReduction::kAdd) {
+      if (shapes[0].element_type() != S32) {
+        return absl::UnimplementedError("dynamic dropped additions require s32 updates");
+      }
+      void* valid_address = scratch.addresses.back();
+      std::vector<int64_t> mask_dimensions(update_dimensions.size(), 1);
+      mask_dimensions[0] = scatter_metadata_->index_rows;
