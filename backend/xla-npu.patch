+absl::Status LegalizeNativeMatrixDot(HloModule* module) {
+  DotDecomposer decompose;
+  TF_RETURN_IF_ERROR(decompose.Run(module).status());
+  for (HloComputation* computation : module->MakeNonfusionComputations()) {
+    std::vector<HloInstruction*> dots;
+    for (HloInstruction* instruction : computation->instructions()) {
+      if (instruction->opcode() == HloOpcode::kDot) dots.push_back(instruction);
+    }
+    for (HloInstruction* instruction : dots) {
+      const auto& dimensions = instruction->dot_dimension_numbers();
+      const int64_t lhs_rank = instruction->operand(0)->shape().dimensions_size();
+      const int64_t rhs_rank = instruction->operand(1)->shape().dimensions_size();
+      const int64_t batch_rank = dimensions.lhs_batch_dimensions_size();
+      if (dimensions.rhs_batch_dimensions_size() != batch_rank ||
+          dimensions.lhs_contracting_dimensions_size() != 1 ||
+          dimensions.rhs_contracting_dimensions_size() != 1 ||
+          lhs_rank < batch_rank + 1 || lhs_rank > batch_rank + 2 ||
+          rhs_rank < batch_rank + 1 || rhs_rank > batch_rank + 2 || batch_rank > 6) {
+        return absl::UnimplementedError(
+            "Native matrix dot requires bounded canonical single-axis contraction");
+      }
+      for (int64_t axis = 0; axis < batch_rank; ++axis) {
+        if (dimensions.lhs_batch_dimensions(axis) != axis ||
+            dimensions.rhs_batch_dimensions(axis) != axis) {
+          return absl::UnimplementedError("Native matrix dot requires leading batch axes");
+        }
+      }
+      const int64_t lhs_axis = dimensions.lhs_contracting_dimensions(0);
+      const int64_t rhs_axis = dimensions.rhs_contracting_dimensions(0);
+      std::vector<HloInstruction*> operands;
+      std::vector<int64_t> output_dimensions;
+      for (int64_t axis = 0; axis < batch_rank; ++axis) {
+        output_dimensions.push_back(instruction->operand(0)->shape().dimensions(axis));
+      }
+      for (int64_t operand_index = 0; operand_index < 2; ++operand_index) {
+        const int64_t rank = operand_index == 0 ? lhs_rank : rhs_rank;
+        const int64_t axis = operand_index == 0 ? lhs_axis : rhs_axis;
+        const int64_t expected = operand_index == 0 ? rank - 1 : batch_rank;
+        if (axis < batch_rank || axis >= rank) {
+          return absl::UnimplementedError("Invalid native matrix dot contraction axis");
+        }
+        HloInstruction* operand = instruction->mutable_operand(operand_index);
+        if (axis != expected) {
+          std::vector<int64_t> permutation;
+          for (int64_t dimension = 0; dimension < rank; ++dimension) permutation.push_back(dimension);
+          std::swap(permutation[rank - 2], permutation[rank - 1]);
+          operand = computation->AddInstruction(HloInstruction::CreateTranspose(
+              ShapeUtil::PermuteDimensions(permutation, operand->shape()), operand, permutation));
+        }
+        std::vector<int64_t> matrix_dimensions(operand->shape().dimensions().begin(),
+                                              operand->shape().dimensions().end());
+        if (rank == batch_rank + 1) {
+          const int64_t singleton_axis = operand_index == 0 ? batch_rank : batch_rank + 1;
+          matrix_dimensions.insert(matrix_dimensions.begin() + singleton_axis, 1);
+          std::vector<int64_t> promoted_layout;
+          for (int64_t dimension : operand->shape().layout().minor_to_major()) {
+            promoted_layout.push_back(dimension < singleton_axis ? dimension : dimension + 1);
+          }
+          promoted_layout.push_back(singleton_axis);
+          operand = computation->AddInstruction(HloInstruction::CreateReshape(
+              ShapeUtil::MakeShapeWithDenseLayout(operand->shape().element_type(),
+                                                  matrix_dimensions, promoted_layout), operand));
+        }
+        output_dimensions.push_back(matrix_dimensions[operand_index == 0 ? batch_rank : batch_rank + 1]);
+        operands.push_back(operand);
+      }
+      DotDimensionNumbers normalized;
+      for (int64_t axis = 0; axis < batch_rank; ++axis) {
+        normalized.add_lhs_batch_dimensions(axis);
+        normalized.add_rhs_batch_dimensions(axis);
+      }
+      normalized.add_lhs_contracting_dimensions(0);
+      normalized.add_rhs_contracting_dimensions(0);
+      normalized.set_lhs_contracting_dimensions(0, batch_rank + 1);
+      normalized.set_rhs_contracting_dimensions(0, batch_rank);
+      std::vector<int64_t> output_axes;
+      for (int64_t axis = 0; axis < batch_rank; ++axis) output_axes.push_back(axis);
+      if (lhs_rank == batch_rank + 2) output_axes.push_back(batch_rank);
+      if (rhs_rank == batch_rank + 2) output_axes.push_back(batch_rank + 1);
+      std::vector<int64_t> output_layout;
+      for (int64_t axis : instruction->shape().layout().minor_to_major()) {
+        output_layout.push_back(output_axes[axis]);
+      }
+      if (lhs_rank == batch_rank + 1) output_layout.push_back(batch_rank);
+      if (rhs_rank == batch_rank + 1) output_layout.push_back(batch_rank + 1);
+      HloInstruction* dot = computation->AddInstruction(HloInstruction::CreateDot(
+          ShapeUtil::MakeShapeWithDenseLayout(instruction->shape().element_type(),
+                                              output_dimensions, output_layout),
+          operands[0], operands[1], normalized, instruction->precision_config()));
+      TF_RETURN_IF_ERROR(computation->ReplaceWithNewInstruction(instruction,
+          HloInstruction::CreateReshape(instruction->shape(), dot)));
+    }
+  }
+  return absl::OkStatus();
+}
