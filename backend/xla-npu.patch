+absl::Status LegalizeNativeStaticDuplicateScatterAdd(HloModule* module) {
+  for (auto* computation : module->computations()) {
+    for (auto* instruction : computation->MakeInstructionPostOrder()) {
+      if (instruction->opcode() != HloOpcode::kScatter || instruction->operand_count() != 3) continue;
+      const auto* scatter = Cast<HloScatterInstruction>(instruction);
+      const auto& dimensions = scatter->scatter_dimension_numbers();
+      const Shape& input = instruction->operand(0)->shape();
+      const auto* indices = instruction->operand(1);
+      const Shape& updates = instruction->operand(2)->shape();
+      if (!input.IsArray() || input.element_type() != F32 || input.dimensions_size() < 1 ||
+          input.dimensions_size() > 8 || !ShapeUtil::Equal(input, instruction->shape()) ||
+          indices->opcode() != HloOpcode::kConstant || indices->shape().element_type() != S32 ||
+          indices->shape().dimensions_size() != 2 || indices->shape().dimensions(1) != 1 ||
+          indices->shape().dimensions(0) < 2 || indices->shape().dimensions(0) > (1 << 20) ||
+          !updates.IsArray() || updates.element_type() != F32 || updates.dimensions_size() != input.dimensions_size() ||
+          updates.dimensions(0) != indices->shape().dimensions(0) ||
+          dimensions.update_window_dims_size() != input.dimensions_size() - 1 ||
+          dimensions.inserted_window_dims_size() != 1 || dimensions.inserted_window_dims(0) != 0 ||
+          dimensions.scatter_dims_to_operand_dims_size() != 1 || dimensions.scatter_dims_to_operand_dims(0) != 0 ||
+          dimensions.index_vector_dim() != 1 || dimensions.input_batching_dims_size() != 0 ||
+          dimensions.scatter_indices_batching_dims_size() != 0) continue;
+      bool supported = true;
+      for (int64_t axis = 0; axis < input.dimensions_size(); ++axis) {
+        if (input.is_dynamic_dimension(axis) || updates.is_dynamic_dimension(axis) ||
+            (axis > 0 && (updates.dimensions(axis) != input.dimensions(axis) ||
+                         dimensions.update_window_dims(axis - 1) != axis))) supported = false;
+      }
+      const auto* update_computation = scatter->to_apply();
+      const auto* root = update_computation->root_instruction();
+      if (!supported || update_computation->num_parameters() != 2 || update_computation->instruction_count() != 3 ||
+          root->opcode() != HloOpcode::kAdd || root->operand_count() != 2 ||
+          !((root->operand(0) == update_computation->parameter_instruction(0) &&
+             root->operand(1) == update_computation->parameter_instruction(1)) ||
+            (root->operand(1) == update_computation->parameter_instruction(0) &&
+             root->operand(0) == update_computation->parameter_instruction(1)))) continue;
+      std::vector<int32_t> values(indices->literal().data<int32_t>().begin(), indices->literal().data<int32_t>().end());
+      auto sorted_values = values;
+      std::sort(sorted_values.begin(), sorted_values.end());
+      if (std::adjacent_find(sorted_values.begin(), sorted_values.end()) == sorted_values.end()) continue;
+      HloInstruction* accumulated = instruction->mutable_operand(0);
+      if (values.size() > 256) {
+        bool dense_static_rows = true;
+        for (const Shape* shape : {&input, &indices->shape(), &updates, &instruction->shape()}) {
+          if (!shape->has_layout() || !LayoutUtil::IsDenseArray(*shape) ||
+              !LayoutUtil::IsMonotonicWithDim0Major(shape->layout()) || shape->layout().tiles_size() != 0) {
+            dense_static_rows = false;
+          }
+          for (int64_t axis = 0; axis < shape->dimensions_size(); ++axis) {
+            if (shape->is_dynamic_dimension(axis) || shape->dimensions(axis) <= 0) dense_static_rows = false;
+          }
+        }
+        if (!dense_static_rows) continue;
+        constexpr int64_t kMaxDuplicateOccurrences = 8;
+        std::array<std::vector<int32_t>, kMaxDuplicateOccurrences> bucket_rows;
+        std::array<std::vector<int32_t>, kMaxDuplicateOccurrences> bucket_destinations;
+        std::vector<uint8_t> occurrences(sorted_values.size(), 0);
+        bool bounded_duplicates = true;
+        for (int64_t row = 0; row < values.size(); ++row) {
