+absl::Status LegalizeNativeStaticZeroWindowScatter(HloModule* module) {
+  for (auto* computation : module->computations()) {
+    for (auto* instruction : computation->MakeInstructionPostOrder()) {
+      if (instruction->opcode() != HloOpcode::kScatter || instruction->operand_count() != 3) continue;
+      const auto* scatter = Cast<HloScatterInstruction>(instruction);
+      const auto& dimensions = scatter->scatter_dimension_numbers();
+      const Shape& input = instruction->operand(0)->shape();
+      const Shape& updates = instruction->operand(2)->shape();
+      const auto* indices = instruction->operand(1);
+      if (!input.IsArray() || !updates.IsArray() || !indices->shape().IsArray() || input.element_type() != F32 ||
+          updates.element_type() != F32 || input.dimensions_size() != 2 || updates.dimensions_size() != 2 ||
+          !ShapeUtil::Equal(input, instruction->shape()) || !input.has_layout() || input.layout().tiles_size() != 0 ||
+          !LayoutUtil::IsMonotonicWithDim0Major(input.layout()) || input.dimensions(0) <= 0 || input.dimensions(1) <= 0 ||
+          input.dimensions(0) > (1 << 20) / input.dimensions(1) ||
+          indices->shape().element_type() != S32 || indices->shape().dimensions_size() != 2 ||
+          indices->shape().dimensions(1) != 2 || indices->shape().dimensions(0) != updates.dimensions(0) ||
+          dimensions.update_window_dims_size() != 1 || dimensions.update_window_dims(0) != 1 ||
+          dimensions.inserted_window_dims_size() != 1 || dimensions.inserted_window_dims(0) != 0 ||
+          dimensions.scatter_dims_to_operand_dims_size() != 2 || dimensions.scatter_dims_to_operand_dims(0) != 0 ||
+          dimensions.scatter_dims_to_operand_dims(1) != 1 || dimensions.index_vector_dim() != 1 ||
+          dimensions.input_batching_dims_size() != 0 || dimensions.scatter_indices_batching_dims_size() != 0) continue;
+      const auto* zero = instruction->operand(2);
+      if (zero->opcode() == HloOpcode::kBroadcast) zero = zero->operand(0);
+      const auto* updater = scatter->to_apply();
+      if (zero->opcode() != HloOpcode::kConstant || !ShapeUtil::IsScalar(zero->shape()) ||
+          zero->shape().element_type() != F32 || zero->literal().GetFirstElement<float>() != 0 ||
+          updater->num_parameters() != 2 || updater->instruction_count() != 2 ||
+          updater->root_instruction()->opcode() != HloOpcode::kParameter ||
+          updater->root_instruction()->parameter_number() != 1) continue;
+      bool bounded_static = true;
+      for (int64_t axis = 0; axis < 2; ++axis) {
+        bounded_static &= !input.is_dynamic_dimension(axis) && !updates.is_dynamic_dimension(axis) &&
+                          !indices->shape().is_dynamic_dimension(axis);
+      }
+      std::vector<const HloInstruction*> pending{indices};
+      std::unordered_set<const HloInstruction*> seen;
+      while (!pending.empty() && bounded_static) {
+        const auto* producer = pending.back();
+        pending.pop_back();
+        if (!seen.insert(producer).second) continue;
+        if (seen.size() > 128 || producer->HasSideEffect() ||
+            producer->opcode() == HloOpcode::kParameter || producer->opcode() == HloOpcode::kWhile ||
+            producer->opcode() == HloOpcode::kCustomCall || producer->opcode() == HloOpcode::kCall ||
+            !producer->called_computations().empty() || !producer->shape().IsArray() ||
+            ShapeUtil::ElementsIn(producer->shape()) > (1 << 20) ||
+            (producer->shape().element_type() != S32 && producer->shape().element_type() != S64 &&
+             producer->shape().element_type() != PRED)) {
+          bounded_static = false;
+          break;
+        }
+        for (const auto* operand : producer->operands()) pending.push_back(operand);
+      }
+      if (!bounded_static) continue;
+      HloEvaluator evaluator(0);
+      Literal literal;
+      if (!evaluator.TryEvaluate(indices, &literal, true) ||
+          !ShapeUtil::Compatible(literal.shape(), indices->shape())) continue;
+      const int64_t width = updates.dimensions(1);
+      if (width <= 0 || width > input.dimensions(1)) continue;
+      Literal mask = LiteralUtil::CreateFull<bool>({input.dimensions(0), input.dimensions(1)}, false);
+      bool valid = true;
+      for (int64_t index = 0; index < indices->shape().dimensions(0); ++index) {
+        const int32_t row = literal.Get<int32_t>({index, 0});
+        const int32_t column = literal.Get<int32_t>({index, 1});
+        if (row < 0 || row >= input.dimensions(0) || column < 0 || column > input.dimensions(1) - width) {
+          valid = false;
+          break;
+        }
+        for (int64_t offset = 0; offset < width; ++offset) mask.Set<bool>({row, column + offset}, true);
+      }
+      if (!valid) continue;
+      auto* predicate = computation->AddInstruction(HloInstruction::CreateConstant(std::move(mask)));
+      auto* scalar = computation->AddInstruction(HloInstruction::CreateConstant(
+          LiteralUtil::CreateR0<float>(zero->literal().GetFirstElement<float>())));
+      auto* zeros = computation->AddInstruction(HloInstruction::CreateBroadcast(input, scalar, {}));
+      auto* replacement = computation->AddInstruction(HloInstruction::CreateTernary(
+          input, HloOpcode::kSelect, predicate, zeros, instruction->mutable_operand(0)));
+      instruction->SetupDerivedInstruction(replacement);
+      TF_ASSIGN_OR_RETURN(bool replaced, computation->ReplaceInstruction(instruction, replacement, true, true));
+      if (!replaced) return absl::InternalError("Native static zero window replacement was rejected");
+    }
+  }
+  return absl::OkStatus();
+}
