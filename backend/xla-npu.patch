+#ifndef XLA_XLA_NPU_BACKEND_RUNTIME_NPU_COPY_THUNK_H_
+#define XLA_XLA_NPU_BACKEND_RUNTIME_NPU_COPY_THUNK_H_
+
+#include <cstdint>
+#include <utility>
+
+#include "xla/xla_npu/backend/runtime/npu_thunk.h"
+
+namespace xla {
+
+class NpuCopyThunk : public NpuThunk {
+ public:
+  NpuCopyThunk(ThunkInfo info, BufferAllocation::Slice source,
+               BufferAllocation::Slice destination, uint64_t bytes)
+      : NpuThunk(Kind::kCopy, std::move(info)), source_(source),
+        destination_(destination), bytes_(bytes) {}
+
+  absl::Status ExecuteOnStream(const ExecuteParams& params) override;
+  BufferUses buffer_uses() const override {
+    return {BufferUse::Read(source_), BufferUse::Write(destination_)};
+  }
+
+ private:
+  BufferAllocation::Slice source_;
+  BufferAllocation::Slice destination_;
+  uint64_t bytes_;
+};
+
+}
+
+#endif
