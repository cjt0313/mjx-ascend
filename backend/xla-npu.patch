+absl::Status LegalizeNativeColumnRowScatter(HloModule* module) {
+  for (auto* computation : module->computations()) {
+    for (auto* instruction : computation->MakeInstructionPostOrder()) {
+      if (instruction->opcode() != HloOpcode::kScatter || instruction->operand_count() != 3) continue;
+      const auto* scatter = Cast<HloScatterInstruction>(instruction);
+      const auto& dimensions = scatter->scatter_dimension_numbers();
+      const Shape& input = instruction->operand(0)->shape();
+      const Shape& indices = instruction->operand(1)->shape();
+      const Shape& updates = instruction->operand(2)->shape();
+      if (!input.IsArray() || !indices.IsArray() || !updates.IsArray() ||
+          input.dimensions_size() != 2 || updates.dimensions_size() != 2 ||
+          indices.dimensions_size() != 2 || indices.dimensions(1) != 1 ||
+          indices.element_type() != S32 || !ShapeUtil::Equal(input, instruction->shape()) ||
+          input.element_type() != updates.element_type() ||
+          updates.dimensions(0) != input.dimensions(0) || updates.dimensions(1) != indices.dimensions(0) ||
+          dimensions.update_window_dims_size() != 1 || dimensions.update_window_dims(0) != 0 ||
+          dimensions.inserted_window_dims_size() != 1 || dimensions.inserted_window_dims(0) != 1 ||
+          dimensions.scatter_dims_to_operand_dims_size() != 1 || dimensions.scatter_dims_to_operand_dims(0) != 1 ||
+          dimensions.index_vector_dim() != 1 || dimensions.input_batching_dims_size() != 0 ||
+          dimensions.scatter_indices_batching_dims_size() != 0) continue;
+      bool dynamic = false;
+      for (int64_t axis = 0; axis < 2; ++axis) {
+        dynamic |= input.is_dynamic_dimension(axis) || updates.is_dynamic_dimension(axis) ||
+                   indices.is_dynamic_dimension(axis);
+      }
+      if (dynamic) continue;
+      const std::vector<int64_t> permutation{1, 0};
+      auto* transposed_input = computation->AddInstruction(HloInstruction::CreateTranspose(
+          ShapeUtil::MakeShape(input.element_type(), {input.dimensions(1), input.dimensions(0)}),
+          instruction->mutable_operand(0), permutation));
+      auto* transposed_updates = computation->AddInstruction(HloInstruction::CreateTranspose(
+          ShapeUtil::MakeShape(updates.element_type(), {updates.dimensions(1), updates.dimensions(0)}),
+          instruction->mutable_operand(2), permutation));
+      ScatterDimensionNumbers normalized;
+      normalized.add_update_window_dims(1);
+      normalized.add_inserted_window_dims(0);
+      normalized.add_scatter_dims_to_operand_dims(0);
+      normalized.set_index_vector_dim(1);
+      auto* scattered = computation->AddInstruction(HloInstruction::CreateScatter(
+          transposed_input->shape(), transposed_input, instruction->mutable_operand(1),
+          transposed_updates, scatter->to_apply(), normalized, scatter->indices_are_sorted(),
+          scatter->unique_indices()));
+      auto* replacement = computation->AddInstruction(HloInstruction::CreateTranspose(
+          instruction->shape(), scattered, permutation));
+      instruction->SetupDerivedInstruction(replacement);
+      TF_ASSIGN_OR_RETURN(bool replaced,
+          computation->ReplaceInstruction(instruction, replacement, true, true));
+      if (!replaced) return absl::InternalError("Native column row scatter replacement was rejected");
+    }
+  }
+  return absl::OkStatus();
+}
