+absl::Status NormalizeNativeBatchedIntegerColumnGather(HloModule* module) {
+  TF_RETURN_IF_ERROR(NormalizeNativeBatchedIntegerColumnQueries(module));
+  for (HloComputation* computation : module->MakeNonfusionComputations()) {
+    std::vector<HloInstruction*> gathers;
+    for (HloInstruction* instruction : computation->instructions()) {
+      if (instruction->opcode() == HloOpcode::kGather) gathers.push_back(instruction);
+    }
+    for (HloInstruction* instruction : gathers) {
+      const auto& dimensions = instruction->gather_dimension_numbers();
+      const Shape& operand = instruction->operand(0)->shape();
+      const Shape& indices = instruction->operand(1)->shape();
+      const Shape& output = instruction->shape();
+      const int64_t operand_rank = operand.dimensions_size();
+      const bool integer_columns = operand_rank == 3 && operand.element_type() == S32;
+      const bool float_coordinates = operand_rank == 4 && operand.element_type() == F32;
+      if ((!integer_columns && !float_coordinates) || indices.dimensions_size() != 3 ||
+          output.dimensions_size() != operand_rank || indices.element_type() != S32 ||
+          output.element_type() != operand.element_type() ||
+          dimensions.operand_batching_dims_size() != 1 ||
+          dimensions.operand_batching_dims(0) != 0 ||
+          dimensions.start_indices_batching_dims_size() != 1 ||
+          dimensions.start_indices_batching_dims(0) != 0 ||
+          dimensions.index_vector_dim() != 2 ||
+          dimensions.start_index_map_size() != 1 || dimensions.start_index_map(0) != 2 ||
+          dimensions.collapsed_slice_dims_size() != 1 || dimensions.collapsed_slice_dims(0) != 2 ||
+          dimensions.offset_dims_size() != operand_rank - 2 || dimensions.offset_dims(0) != 1 ||
+          instruction->gather_slice_sizes().size() != operand_rank ||
+          instruction->gather_slice_sizes()[0] != 1 ||
+          instruction->gather_slice_sizes()[1] != operand.dimensions(1) ||
+          instruction->gather_slice_sizes()[2] != 1 ||
+          indices.dimensions(0) != operand.dimensions(0) || indices.dimensions(2) != 1 ||
+          output.dimensions(0) != operand.dimensions(0) ||
+          output.dimensions(1) != operand.dimensions(1) ||
+          output.dimensions(2) != indices.dimensions(1) || operand.dimensions(0) > (1 << 24)) {
+        continue;
+      }
+      if (float_coordinates &&
+          (dimensions.offset_dims(1) != 3 ||
+           instruction->gather_slice_sizes()[3] != operand.dimensions(3) ||
+           output.dimensions(3) != operand.dimensions(3))) {
+        continue;
+      }
+      bool bounded_static = true;
+      for (const Shape* shape : {&operand, &indices, &output}) {
+        if (!shape->has_layout() || !LayoutUtil::IsDenseArray(*shape) ||
+            !LayoutUtil::IsMonotonicWithDim0Major(shape->layout()) ||
+            shape->layout().tiles_size() != 0) {
+          bounded_static = false;
+        }
+        for (int64_t axis = 0; axis < shape->dimensions_size(); ++axis) {
+          if (shape->is_dynamic_dimension(axis) || shape->dimensions(axis) <= 0) {
+            bounded_static = false;
+          }
+        }
+      }
+      if (!bounded_static) continue;
+      std::vector<int64_t> permutation = {0, 2, 1};
+      std::vector<int64_t> operand_dimensions = {
+          operand.dimensions(0), operand.dimensions(2), operand.dimensions(1)};
+      std::vector<int64_t> output_dimensions = {
+          output.dimensions(0), output.dimensions(2), output.dimensions(1)};
+      std::vector<int64_t> slice_sizes = {1, 1, operand.dimensions(1)};
+      if (float_coordinates) {
+        permutation.push_back(3);
+        operand_dimensions.push_back(operand.dimensions(3));
+        output_dimensions.push_back(output.dimensions(3));
+        slice_sizes.push_back(operand.dimensions(3));
+      }
+      HloInstruction* transposed_operand = computation->AddInstruction(HloInstruction::CreateTranspose(
+          ShapeUtil::MakeShape(operand.element_type(), operand_dimensions),
+          instruction->mutable_operand(0), permutation));
+      GatherDimensionNumbers normalized;
+      normalized.add_operand_batching_dims(0);
+      normalized.add_start_indices_batching_dims(0);
+      normalized.add_start_index_map(1);
+      normalized.add_collapsed_slice_dims(1);
+      normalized.add_offset_dims(2);
+      if (float_coordinates) normalized.add_offset_dims(3);
+      normalized.set_index_vector_dim(2);
+      HloInstruction* gathered = computation->AddInstruction(HloInstruction::CreateGather(
+          ShapeUtil::MakeShape(output.element_type(), output_dimensions),
+          transposed_operand, instruction->mutable_operand(1), normalized,
+          slice_sizes, false));
+      TF_RETURN_IF_ERROR(computation->ReplaceWithNewInstruction(instruction,
+          HloInstruction::CreateTranspose(output, gathered, permutation)));
+    }
+  }
+  return absl::OkStatus();
+}
