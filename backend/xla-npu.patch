+absl::Status FoldNativeStaticScatterIndices(HloModule* module) {
+  for (auto* computation : module->computations()) {
+    for (auto* instruction : computation->MakeInstructionPostOrder()) {
+      if (instruction->opcode() != HloOpcode::kScatter || instruction->operand_count() != 3) continue;
+      const auto* indices = instruction->operand(1);
+      const bool single_points = indices->shape().dimensions_size() == 2 && indices->shape().dimensions(1) == 1;
+      const bool batched_points = indices->shape().dimensions_size() == 3 && indices->shape().dimensions(2) == 1;
+      if (!indices->shape().IsArray() || indices->shape().element_type() != S32 ||
+          (!single_points && !batched_points) || ShapeUtil::ElementsIn(indices->shape()) > 4096) continue;
+      const auto* scatter = Cast<HloScatterInstruction>(instruction);
+      const auto& dimensions = scatter->scatter_dimension_numbers();
+      std::vector<const HloInstruction*> pending{indices};
+      std::unordered_set<const HloInstruction*> seen;
+      bool bounded_static = true;
+      while (!pending.empty() && bounded_static) {
+        const auto* producer = pending.back();
+        pending.pop_back();
+        if (!seen.insert(producer).second) continue;
+        if (seen.size() > 4096 || producer->HasSideEffect() ||
+            producer->opcode() == HloOpcode::kParameter || producer->opcode() == HloOpcode::kWhile ||
+            producer->opcode() == HloOpcode::kCustomCall || producer->opcode() == HloOpcode::kCall) {
+          bounded_static = false;
+          break;
+        }
+        ShapeUtil::ForEachSubshape(producer->shape(), [&](const Shape& shape, const ShapeIndex&) {
+          if (shape.IsArray() && (ShapeUtil::ElementsIn(shape) > 4096 ||
+              (shape.element_type() != S32 && shape.element_type() != S64 && shape.element_type() != PRED))) {
+            bounded_static = false;
+          }
+        });
+        for (const auto* called : producer->called_computations()) {
+          if ((producer->opcode() != HloOpcode::kReduce && producer->opcode() != HloOpcode::kReduceWindow &&
+               producer->opcode() != HloOpcode::kScatter && producer->opcode() != HloOpcode::kSort) ||
+              called->instruction_count() > 16) {
+            bounded_static = false;
+            break;
+          }
+          for (const auto* nested : called->instructions()) {
+            seen.insert(nested);
+            if (seen.size() > 4096 || nested->HasSideEffect() || !nested->called_computations().empty() ||
+                !nested->shape().IsArray() || ShapeUtil::ElementsIn(nested->shape()) > 4096 ||
+                (nested->shape().element_type() != S32 && nested->shape().element_type() != S64 &&
+                 nested->shape().element_type() != PRED)) bounded_static = false;
+          }
+        }
+        for (const auto* operand : producer->operands()) pending.push_back(operand);
+      }
+      if (!bounded_static) continue;
+      HloEvaluator evaluator(0);
+      Literal literal;
+      if (!evaluator.TryEvaluate(indices, &literal, true) ||
+          !ShapeUtil::Compatible(literal.shape(), indices->shape())) continue;
+      std::vector<int32_t> values(literal.data<int32_t>().begin(), literal.data<int32_t>().end());
+      std::sort(values.begin(), values.end());
+      bool unit_indexed_window = single_points && dimensions.index_vector_dim() == 1 &&
+          dimensions.scatter_dims_to_operand_dims_size() == 1 &&
+          dimensions.input_batching_dims_size() == 0 && dimensions.scatter_indices_batching_dims_size() == 0;
+      if (unit_indexed_window) {
+        const int64_t indexed_axis = dimensions.scatter_dims_to_operand_dims(0);
+        unit_indexed_window = std::find(dimensions.inserted_window_dims().begin(),
+            dimensions.inserted_window_dims().end(), indexed_axis) != dimensions.inserted_window_dims().end();
+      }
+      const bool unique = unit_indexed_window &&
+          std::adjacent_find(values.begin(), values.end()) == values.end();
+      auto* constant = computation->AddInstruction(HloInstruction::CreateConstant(std::move(literal)));
+      auto* replacement = computation->AddInstruction(HloInstruction::CreateScatter(
+          instruction->shape(), instruction->mutable_operand(0), constant, instruction->mutable_operand(2),
+          scatter->to_apply(), scatter->scatter_dimension_numbers(), scatter->indices_are_sorted(),
+          scatter->unique_indices() || unique));
+      instruction->SetupDerivedInstruction(replacement);
+      TF_ASSIGN_OR_RETURN(bool replaced,
+          computation->ReplaceInstruction(instruction, replacement, true, true));
+      if (!replaced) return absl::InternalError("Native static scatter index replacement was rejected");
+    }
+  }
+  return absl::OkStatus();
+}
