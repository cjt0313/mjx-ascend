+  std::unique_ptr<aclScalar, decltype(destroy_scalar)> step(
+      dep::aclCreateScalar(&step_value, ACL_INT64), destroy_scalar);
+  if (!output || !start || !end || !step) {
+    return absl::InternalError("Iota Arange descriptor creation failed");
+  }
+  uint64_t workspace_size = 0;
+  aclOpExecutor* executor = nullptr;
+  aclnnStatus status = dep::aclnnArangeGetWorkspaceSize(
+      start.get(), end.get(), step.get(), output.get(), &workspace_size, &executor);
+  if (status != ACL_SUCCESS) {
+    return absl::InternalError("Iota Arange workspace query failed");
+  }
+  auto stream = static_cast<aclrtStream>(params.stream->platform_specific_handle().stream);
+  TF_RETURN_IF_ERROR(ExecuteAclnn(stream, workspace_size, executor, dep::aclnnArange));
+  return SyncStreamIfEnabled(params.stream);
+}
 
