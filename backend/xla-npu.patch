+absl::Status LegalizeNativeRowGather(HloModule* module) {
+  for (HloComputation* computation : module->MakeNonfusionComputations()) {
+    std::vector<HloInstruction*> gathers;
+    for (HloInstruction* instruction : computation->instructions()) {
+      if (instruction->opcode() == HloOpcode::kGather) gathers.push_back(instruction);
+    }
+    for (HloInstruction* instruction : gathers) {
+    const auto& dimensions = instruction->gather_dimension_numbers();
+    const Shape& operand = instruction->operand(0)->shape();
+    const Shape& indices = instruction->operand(1)->shape();
+    const int64_t rank = operand.dimensions_size();
+    const int64_t index_rank = indices.dimensions_size();
+    const int64_t vector_axis = dimensions.index_vector_dim();
+    if (rank < 1 || rank > 8 || index_rank < 1 || index_rank > 8 ||
+        !LayoutUtil::IsMonotonicWithDim0Major(instruction->shape().layout()) ||
+        instruction->shape().layout().tiles_size() != 0 ||
+        indices.element_type() != S32 || vector_axis != index_rank - 1 ||
+        dimensions.start_index_map_size() != indices.dimensions(vector_axis) ||
+        dimensions.collapsed_slice_dims_size() > 1 ||
+        (dimensions.collapsed_slice_dims_size() == 1 &&
+         dimensions.collapsed_slice_dims(0) != 0) ||
+        dimensions.operand_batching_dims_size() != 0 ||
+        dimensions.start_indices_batching_dims_size() != 0 ||
+        instruction->gather_slice_sizes().size() != rank ||
+        instruction->gather_slice_sizes()[0] != 1 ||
+        operand.dimensions(0) <= 0 || operand.dimensions(0) > INT32_MAX) {
+      return absl::UnimplementedError(absl::StrCat(
+          "Native gather requires bounded S32 full-row indexing: ", instruction->ToString()));
+    }
+    for (const Shape* shape : {&operand, &indices, &instruction->shape()}) {
+      for (int64_t axis = 0; axis < shape->dimensions_size(); ++axis) {
+        if (shape->is_dynamic_dimension(axis) || shape->dimensions(axis) <= 0) {
+          return absl::UnimplementedError("Native row gather requires positive static dimensions");
+        }
+      }
+    }
+    const int64_t batch_rank = index_rank - 1;
+    const int64_t retained_rank = rank - dimensions.collapsed_slice_dims_size();
+    if (dimensions.offset_dims_size() != retained_rank) {
+      return absl::UnimplementedError("Native row gather requires batch-leading output");
+    }
+    for (int64_t axis = 0; axis < retained_rank; ++axis) {
+      if (dimensions.offset_dims(axis) != batch_rank + axis) {
+        return absl::UnimplementedError("Native row gather requires ordered trailing offsets");
+      }
+    }
+    for (int64_t axis = 1; axis < rank; ++axis) {
+      if (instruction->gather_slice_sizes()[axis] != operand.dimensions(axis)) {
+        return absl::UnimplementedError(absl::StrCat(
+            "Native row gather cannot truncate nonindexed axes: ", instruction->ToString()));
+      }
+    }
+    int64_t row_component = -1;
+    for (int64_t component = 0; component < dimensions.start_index_map_size(); ++component) {
+      if (dimensions.start_index_map(component) == 0) row_component = component;
+    }
+    if (row_component < 0) {
+      return absl::UnimplementedError("Native row gather requires an explicit row index");
+    }
+    std::vector<int64_t> starts(index_rank, 0);
+    std::vector<int64_t> limits(indices.dimensions().begin(), indices.dimensions().end());
+    std::vector<int64_t> strides(index_rank, 1);
+    starts.back() = row_component;
+    limits.back() = row_component + 1;
+    std::vector<int64_t> index_dimensions(indices.dimensions().begin(), indices.dimensions().end());
+    index_dimensions.back() = 1;
+    const Shape row_shape = ShapeUtil::MakeShape(S32, index_dimensions);
+    HloInstruction* row = computation->AddInstruction(HloInstruction::CreateSlice(
+        row_shape, instruction->mutable_operand(1), starts, limits, strides));
+    auto bound = [&](int32_t value) {
+      HloInstruction* scalar = computation->AddInstruction(HloInstruction::CreateConstant(
+          LiteralUtil::CreateR0<int32_t>(value)));
+      return computation->AddInstruction(HloInstruction::CreateBroadcast(row_shape, scalar, {}));
+    };
+    HloInstruction* clamped = computation->AddInstruction(HloInstruction::CreateBinary(
+        row_shape, HloOpcode::kMaximum, row, bound(0)));
+    clamped = computation->AddInstruction(HloInstruction::CreateBinary(
+        row_shape, HloOpcode::kMinimum, clamped, bound(operand.dimensions(0) - 1)));
+    std::vector<int64_t> output_dimensions(index_dimensions.begin(), index_dimensions.end() - 1);
+    output_dimensions.insert(output_dimensions.end(), operand.dimensions().begin() + 1,
+                             operand.dimensions().end());
+    GatherDimensionNumbers normalized;
+    normalized.add_start_index_map(0);
+    normalized.add_collapsed_slice_dims(0);
+    normalized.set_index_vector_dim(vector_axis);
+    for (int64_t axis = 1; axis < rank; ++axis) {
+      normalized.add_offset_dims(batch_rank + axis - 1);
+    }
+    HloInstruction* gathered = computation->AddInstruction(HloInstruction::CreateGather(
+        ShapeUtil::MakeShape(operand.element_type(), output_dimensions),
+        instruction->mutable_operand(0), clamped, normalized,
+        instruction->gather_slice_sizes(), false));
+    TF_RETURN_IF_ERROR(computation->ReplaceWithNewInstruction(instruction,
+        HloInstruction::CreateReshape(instruction->shape(), gathered)));
+    }
+  }
+  return absl::OkStatus();
+}
