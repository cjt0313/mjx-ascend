+absl::Status NpuIrEmitterUnnested::EmitWhile(const HloInstruction* instr) {
+  const auto* condition = instr->while_condition();
+  const auto* body = instr->while_body();
+  if (!ShapeUtil::IsScalar(condition->root_instruction()->shape()) ||
+      condition->root_instruction()->shape().element_type() != PRED) {
+    return absl::InvalidArgumentError("While condition must return scalar PRED");
+  }
+  TF_RETURN_IF_ERROR(ShapeUtil::ForEachSubshapeWithStatus(
+      instr->shape(), [&](const Shape& shape, const ShapeIndex& index) -> absl::Status {
+        if (!shape.IsArray()) return absl::OkStatus();
+        TF_ASSIGN_OR_RETURN(auto output, GetAllocationSliceForHlo(instr, index));
+        const std::vector<const HloInstruction*> carried_values = {
+            instr->operand(0), condition->parameter_instruction(0),
+            body->parameter_instruction(0), body->root_instruction()};
+        for (const auto* value : carried_values) {
+          TF_ASSIGN_OR_RETURN(auto carry, GetAllocationSliceForHlo(value, index));
+          if (output != carry) {
+            return absl::InternalError("While carried buffers must alias at every array leaf");
+          }
+        }
+        return absl::OkStatus();
+      }));
+  auto condition_emitter = NpuIrEmitterUnnested::Create(ir_emitter_context_);
+  auto body_emitter = NpuIrEmitterUnnested::Create(ir_emitter_context_);
+  TF_RETURN_IF_ERROR(condition_emitter->EmitHloComputation(condition));
+  TF_RETURN_IF_ERROR(body_emitter->EmitHloComputation(body));
+  TF_ASSIGN_OR_RETURN(auto predicate, GetAllocationSliceForHlo(condition->root_instruction()));
+  AddThunkToThunkSequence(std::make_unique<NpuWhileThunk>(
+      NpuThunk::ThunkInfo::WithProfileAnnotation(instr, ir_emitter_context_->GetNextThunkId()),
+      predicate, condition_emitter->ConsumeThunkSequence(), body_emitter->ConsumeThunkSequence()));
+  return absl::OkStatus();
+}
+
+absl::Status NpuIrEmitterUnnested::EmitConditional(const HloInstruction* instr) {
+  const auto& selector_shape = instr->operand(0)->shape();
+  const bool selector_is_pred = selector_shape.element_type() == PRED;
+  if (!ShapeUtil::IsScalar(selector_shape) ||
+      (!selector_is_pred && selector_shape.element_type() != S32) ||
+      instr->branch_count() < 1 || (selector_is_pred && instr->branch_count() != 2)) {
+    return absl::InvalidArgumentError("Conditional requires scalar PRED or S32 selector");
+  }
+  std::vector<std::unique_ptr<NpuSequentialThunk>> branches;
+  for (int64_t branch_index = 0; branch_index < instr->branch_count(); ++branch_index) {
+    const auto* computation = instr->branch_computations()[branch_index];
+    TF_RETURN_IF_ERROR(ShapeUtil::ForEachSubshapeWithStatus(
+        instr->shape(), [&](const Shape& shape, const ShapeIndex& index) -> absl::Status {
+          if (!shape.IsArray()) return absl::OkStatus();
+          TF_ASSIGN_OR_RETURN(auto output, GetAllocationSliceForHlo(instr, index));
+          TF_ASSIGN_OR_RETURN(auto root, GetAllocationSliceForHlo(computation->root_instruction(), index));
+          if (output != root) {
+            return absl::InternalError("Conditional output must alias branch root");
+          }
+          return absl::OkStatus();
+        }));
+    const auto* operand = instr->operand(branch_index + 1);
+    TF_RETURN_IF_ERROR(ShapeUtil::ForEachSubshapeWithStatus(
+        operand->shape(), [&](const Shape& shape, const ShapeIndex& index) -> absl::Status {
+          if (!shape.IsArray()) return absl::OkStatus();
+          TF_ASSIGN_OR_RETURN(auto input, GetAllocationSliceForHlo(operand, index));
+          TF_ASSIGN_OR_RETURN(auto parameter, GetAllocationSliceForHlo(computation->parameter_instruction(0), index));
+          if (input != parameter) {
+            return absl::InternalError("Conditional parameter must alias branch operand");
+          }
+          return absl::OkStatus();
+        }));
+    auto branch_emitter = NpuIrEmitterUnnested::Create(ir_emitter_context_);
+    TF_RETURN_IF_ERROR(branch_emitter->EmitHloComputation(computation));
+    branches.push_back(branch_emitter->ConsumeThunkSequence());
+  }
+  TF_ASSIGN_OR_RETURN(auto selector, GetAllocationSliceForHlo(instr->operand(0)));
+  AddThunkToThunkSequence(std::make_unique<NpuConditionalThunk>(
+      NpuThunk::ThunkInfo::WithProfileAnnotation(instr, ir_emitter_context_->GetNextThunkId()),
+      selector, std::move(branches), selector_is_pred));
+  return absl::OkStatus();
+}
