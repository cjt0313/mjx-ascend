+    void* safe_index_address = scratch.addresses.back();
+    TF_ASSIGN_OR_RETURN(auto nonnegative, allocate_tensor(flat_dimensions, PRED));
+    TF_ASSIGN_OR_RETURN(auto below_extent, allocate_tensor(flat_dimensions, PRED));
+    TF_ASSIGN_OR_RETURN(valid, allocate_tensor(flat_dimensions, PRED));
+    int64_t lower_bound = 0;
+    int64_t extent = shapes[0].dimensions(0);
+    int64_t upper_bound = extent - 1;
+    auto destroy_scalar = [](aclScalar* scalar) { dep::aclDestroyScalar(scalar); };
+    std::unique_ptr<aclScalar, decltype(destroy_scalar)> lower(
+        dep::aclCreateScalar(&lower_bound, ACL_INT64), destroy_scalar);
+    std::unique_ptr<aclScalar, decltype(destroy_scalar)> upper(
+        dep::aclCreateScalar(&upper_bound, ACL_INT64), destroy_scalar);
+    std::unique_ptr<aclScalar, decltype(destroy_scalar)> limit(
+        dep::aclCreateScalar(&extent, ACL_INT64), destroy_scalar);
+    if (!lower || !upper || !limit) return absl::InternalError("scatter bounds scalar creation failed");
