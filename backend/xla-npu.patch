+absl::Status LegalizeNativeLogicalReshape(HloModule* module) {
+  for (HloComputation* computation : module->MakeNonfusionComputations()) {
+    for (HloInstruction* instruction : computation->MakeInstructionPostOrder()) {
+      if (instruction->opcode() != HloOpcode::kReshape || instruction->operand_count() != 1) continue;
+      const Shape& input = instruction->operand(0)->shape();
+      const Shape& output = instruction->shape();
+      if (input.IsArray() && output.IsArray() && input.has_layout() && output.has_layout() &&
+          LayoutUtil::IsDenseArray(input) && LayoutUtil::IsDenseArray(output) &&
+          input.layout().tiles_size() == 0 && output.layout().tiles_size() == 0 &&
+          input.layout().element_size_in_bits() == 0 && output.layout().element_size_in_bits() == 0 &&
+          ShapeUtil::ReshapeIsBitcast(input, output)) continue;
+      bool supported = true;
+      for (const Shape* shape : {&input, &output}) {
+        if (!shape->IsArray() || shape->dimensions_size() > 8 || !shape->has_layout() ||
+            !LayoutUtil::IsDenseArray(*shape) || shape->layout().tiles_size() != 0 ||
+            shape->layout().element_size_in_bits() != 0) {
+          supported = false;
+          continue;
+        }
+        int64_t elements = 1;
+        for (int64_t axis = 0; axis < shape->dimensions_size(); ++axis) {
+          if (shape->is_dynamic_dimension(axis) || shape->dimensions(axis) < 1 ||
+              shape->dimensions(axis) > (1 << 24) / elements) {
+            supported = false;
+            break;
+          }
+          elements *= shape->dimensions(axis);
+        }
+      }
+      if (!supported) return absl::UnimplementedError("Logical reshape requires bounded static dense untiled tensors");
+      if (input.element_type() != output.element_type() ||
+          ShapeUtil::ElementsIn(input) != ShapeUtil::ElementsIn(output)) {
+        return absl::InvalidArgumentError("Logical reshape must preserve element type and count");
+      }
+      if (ShapeUtil::ReshapeIsBitcast(input, output)) continue;
+      if (input.element_type() != F32 && input.element_type() != S32 &&
+          input.element_type() != S64 && input.element_type() != PRED) {
+        return absl::UnimplementedError("Logical reshape data movement requires F32, S32, S64 or PRED");
+      }
+      HloInstruction* logical_input = instruction->mutable_operand(0);
+      if (!LayoutUtil::IsMonotonicWithDim0Major(input.layout())) {
+        std::vector<int64_t> physical_axes(input.layout().minor_to_major().rbegin(),
+                                            input.layout().minor_to_major().rend());
+        std::vector<int64_t> physical_dimensions;
+        std::vector<int64_t> inverse_axes(input.dimensions_size());
+        for (int64_t axis = 0; axis < physical_axes.size(); ++axis) {
+          physical_dimensions.push_back(input.dimensions(physical_axes[axis]));
+          inverse_axes[physical_axes[axis]] = axis;
+        }
+        const Shape physical_shape = ShapeUtil::MakeShape(input.element_type(), physical_dimensions);
+        HloInstruction* physical_input = computation->AddInstruction(
+            HloInstruction::CreateBitcast(physical_shape, logical_input));
+        logical_input = computation->AddInstruction(HloInstruction::CreateTranspose(
+            ShapeUtil::MakeShape(input.element_type(), input.dimensions()), physical_input, inverse_axes));
+      }
+      const Shape logical_output_shape = ShapeUtil::MakeShape(output.element_type(), output.dimensions());
+      HloInstruction* replacement = computation->AddInstruction(
+          HloInstruction::CreateReshape(logical_output_shape, logical_input));
+      if (!LayoutUtil::IsMonotonicWithDim0Major(output.layout())) {
+        std::vector<int64_t> physical_axes(output.layout().minor_to_major().rbegin(),
+                                            output.layout().minor_to_major().rend());
+        std::vector<int64_t> physical_dimensions;
+        for (int64_t axis : physical_axes) physical_dimensions.push_back(output.dimensions(axis));
+        const Shape physical_shape = ShapeUtil::MakeShape(output.element_type(), physical_dimensions);
+        HloInstruction* physical_output = computation->AddInstruction(
+            HloInstruction::CreateTranspose(physical_shape, replacement, physical_axes));
+        replacement = computation->AddInstruction(HloInstruction::CreateBitcast(output, physical_output));
+      }
+      instruction->SetupDerivedInstruction(replacement);
+      TF_ASSIGN_OR_RETURN(bool replaced,
+          computation->ReplaceInstruction(instruction, replacement, true, true));
+      if (!replaced) return absl::InternalError("Logical reshape replacement was rejected");
+    }
+  }
+  return absl::OkStatus();
+}
