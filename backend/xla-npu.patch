+absl::Status FoldNativeStaticIntegerExpressions(HloModule* module) {
+  for (auto* computation : module->computations()) {
+    std::unordered_set<const HloInstruction*> candidates;
+    std::vector<const HloInstruction*> pending;
+    for (const auto* instruction : computation->instructions()) {
+      if (instruction->opcode() == HloOpcode::kRemainder) {
+        for (const auto* operand : instruction->operands()) pending.push_back(operand);
+      }
+    }
+    while (!pending.empty()) {
+      const auto* producer = pending.back();
+      pending.pop_back();
+      if (!candidates.insert(producer).second) continue;
+      if (!producer->shape().IsArray() || producer->HasSideEffect() ||
+          !producer->called_computations().empty() ||
+          (producer->shape().element_type() != S32 &&
+           producer->shape().element_type() != PRED)) continue;
+      for (const auto* operand : producer->operands()) pending.push_back(operand);
+    }
+    for (auto* instruction : computation->MakeInstructionPostOrder()) {
+      if (candidates.find(instruction) == candidates.end()) continue;
+      const Shape& shape = instruction->shape();
+      if (!shape.IsArray() || shape.is_dynamic() ||
+          (shape.element_type() != S32 && shape.element_type() != PRED) ||
+          ShapeUtil::ElementsIn(shape) > 4096 || instruction->HasSideEffect() ||
+          !instruction->called_computations().empty()) continue;
+      switch (instruction->opcode()) {
+        case HloOpcode::kBroadcast:
+        case HloOpcode::kReshape:
+        case HloOpcode::kTranspose:
+        case HloOpcode::kSlice:
+        case HloOpcode::kConcatenate:
+        case HloOpcode::kCompare:
+        case HloOpcode::kSelect:
+        case HloOpcode::kAnd:
+        case HloOpcode::kOr:
+        case HloOpcode::kNot:
+        case HloOpcode::kAdd:
+        case HloOpcode::kSubtract:
+        case HloOpcode::kMultiply:
+        case HloOpcode::kMinimum:
+        case HloOpcode::kMaximum:
+        case HloOpcode::kIota:
+          break;
+        default:
+          continue;
+      }
+      bool constants = true;
+      for (const auto* operand : instruction->operands()) {
+        if (operand->opcode() != HloOpcode::kConstant ||
+            !operand->shape().IsArray() || operand->shape().is_dynamic() ||
+            ShapeUtil::ElementsIn(operand->shape()) > 4096 ||
+            (operand->shape().element_type() != S32 &&
+             operand->shape().element_type() != PRED)) constants = false;
+      }
+      if (!constants) continue;
+      HloEvaluator evaluator(0);
+      Literal literal;
+      if (!evaluator.TryEvaluate(instruction, &literal, false) ||
+          !ShapeUtil::Compatible(shape, literal.shape())) continue;
+      auto* replacement = computation->AddInstruction(
+          HloInstruction::CreateConstant(std::move(literal)));
+      instruction->SetupDerivedInstruction(replacement);
+      TF_ASSIGN_OR_RETURN(bool replaced,
+          computation->ReplaceInstruction(instruction, replacement, true, true));
+      if (!replaced) return absl::InternalError("Native static integer folding was rejected");
+    }
+  }
+  return absl::OkStatus();
+}
