+NpuThunk::BufferUses NpuAclnnThunk::buffer_uses() const {
+  BufferUses uses;
+  uses.reserve(args_.size());
+  for (size_t argument = 0; argument < args_.size(); ++argument) {
+    bool output = argument >= output_args_.size() || output_args_[argument];
+    uses.push_back(output ? BufferUse::Write(args_[argument])
+                          : BufferUse::Read(args_[argument]));
+  }
+  return uses;
+}
+
+absl::Status NpuAclnnThunk::ExecuteIota(const ExecuteParams& params) {
+  const auto& shapes = thunk_info().param_shapes;
+  const auto& dimensions = thunk_info().dimensions;
+  if (args_.size() != 1 || shapes.size() != 1 ||
+      output_args_.size() != 1 || !output_args_[0] ||
+      dimensions.size() != 1 || dimensions[0] != 0) {
+    return absl::UnimplementedError("Iota requires one output and typed axis zero");
+  }
+  const Shape& shape = shapes[0];
+  if (!shape.IsArray() || (shape.element_type() != S32 && shape.element_type() != F32) ||
+      shape.dimensions_size() != 1 || shape.is_dynamic_dimension(0) ||
+      !shape.has_layout() || !LayoutUtil::IsDenseArray(shape) ||
+      shape.layout().tiles_size() != 0 ||
+      shape.layout().element_size_in_bits() != 0 ||
+      shape.layout().minor_to_major_size() != 1 ||
+      shape.layout().minor_to_major(0) != 0) {
+    return absl::UnimplementedError("Iota requires static dense untiled rank-one s32/f32 layout {0}");
+  }
+  int64_t extent = shape.dimensions(0);
+  if (extent < 0 || extent > (1LL << 24)) {
+    return absl::UnimplementedError("Iota extent exceeds exact bounded Arange scope");
+  }
+  int64_t bytes = ShapeUtil::ByteSizeOf(shape);
+  if (args_[0].size() < bytes) {
+    return absl::InvalidArgumentError("Iota output allocation is too small");
+  }
+  if (extent == 0) return absl::OkStatus();
+  auto address = params.buffer_allocations->GetDeviceAddress(args_[0]);
+  if (address.opaque() == nullptr) {
+    return absl::InvalidArgumentError("Iota output address is null");
+  }
+  auto destroy_tensor = [](aclTensor* tensor) { dep::aclDestroyTensor(tensor); };
+  auto destroy_scalar = [](aclScalar* scalar) { dep::aclDestroyScalar(scalar); };
+  std::unique_ptr<aclTensor, decltype(destroy_tensor)> output(
+      NpuTool::CreateAclTensorPtr(shape, shape.element_type(), address.opaque()), destroy_tensor);
+  int64_t start_value = 0;
+  int64_t end_value = extent;
+  int64_t step_value = 1;
