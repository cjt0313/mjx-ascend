+absl::Status NpuArgIndexThunk::ExecuteOnStream(const ExecuteParams& params) {
+  const auto& shapes = thunk_info().param_shapes;
+  if (params.stream == nullptr || params.buffer_allocations == nullptr ||
+      shapes.size() != 5 || !shapes.back().IsTuple() ||
+      shapes.back().tuple_shapes_size() != 2) {
+    return absl::InvalidArgumentError(
+        "ArgIndex requires a stream and canonical five-shape tuple reduction");
+  }
+  const Shape& input_shape = shapes.front();
+  const Shape& output_shape = shapes.back().tuple_shapes(1);
+  bool is_integer = input_shape.element_type() == S32;
+  if (!IsStaticDensePermutation(input_shape) ||
+      !IsStaticDensePermutation(output_shape) ||
+      (input_shape.element_type() != F32 && !is_integer) ||
+      output_shape.element_type() != S32) {
+    return absl::UnimplementedError(
+        "ArgIndex requires static dense untiled f32/s32 input/s32 output");
+  }
+  int64_t rank = input_shape.dimensions_size();
+  if (rank < 1 || rank > 8 || axis_ < 0 || axis_ >= rank ||
+      output_shape.dimensions_size() != rank - 1) {
+    return absl::UnimplementedError("ArgIndex rank/axis/output rank is unsupported");
+  }
+  if (is_integer && (rank != 2 || axis_ != 1)) {
+    return absl::UnimplementedError("S32 ArgIndex requires rank two and axis one");
+  }
+  if (is_integer) {
+    const Shape& value_shape = shapes.back().tuple_shapes(0);
+    if (!IsStaticDensePermutation(shapes[1]) || shapes[1].element_type() != S32 ||
+        !ShapeUtil::SameDimensions(input_shape, shapes[1]) ||
+        !IsStaticDensePermutation(value_shape) || value_shape.element_type() != S32 ||
+        !ShapeUtil::SameDimensions(value_shape, output_shape) ||
+        !ShapeUtil::IsScalar(shapes[2]) || shapes[2].element_type() != S32 ||
+        !ShapeUtil::IsScalar(shapes[3]) || shapes[3].element_type() != S32) {
+      return absl::UnimplementedError("S32 ArgIndex requires canonical integer tuple shapes");
+    }
+  }
+  int64_t input_elements = 1;
+  int64_t output_dimension = 0;
+  for (int64_t dimension = 0; dimension < rank; ++dimension) {
+    int64_t extent = input_shape.dimensions(dimension);
+    if (extent <= 0 || (is_integer && extent > 64) ||
+        input_elements > (1LL << 24) / extent) {
+      return absl::UnimplementedError("ArgIndex exceeds positive bounded tensor scope");
+    }
+    input_elements *= extent;
+    if (dimension != axis_) {
+      if (output_shape.dimensions(output_dimension) != extent) {
+        return absl::InvalidArgumentError("ArgIndex output must remove exactly the axis");
+      }
+      ++output_dimension;
+    }
+  }
+  int64_t output_elements = input_elements / input_shape.dimensions(axis_);
+  int64_t input_bytes = input_elements *
+      static_cast<int64_t>(is_integer ? sizeof(int32_t) : sizeof(float));
+  int64_t output_bytes = output_elements * static_cast<int64_t>(sizeof(int32_t));
+  if (input_.size() < input_bytes || output_.size() < output_bytes ||
+      input_.offset() < 0 || output_.offset() < 0) {
+    return absl::InvalidArgumentError("ArgIndex payload exceeds allocation slice");
+  }
+  if (input_.index() == output_.index()) {
+    bool overlap = input_.offset() <= output_.offset()
+        ? output_.offset() - input_.offset() < input_.size()
+        : input_.offset() - output_.offset() < output_.size();
+    if (overlap) {
+      return absl::InvalidArgumentError("ArgIndex input/output slices overlap");
+    }
+  }
+  auto stream = static_cast<aclrtStream>(
+      params.stream->platform_specific_handle().stream);
+  if (stream == nullptr) {
+    return absl::InvalidArgumentError("ArgIndex device stream is null");
+  }
+  auto input_address = params.buffer_allocations->GetDeviceAddress(input_);
+  auto output_address = params.buffer_allocations->GetDeviceAddress(output_);
+  if (input_address.opaque() == nullptr || output_address.opaque() == nullptr) {
+    return absl::InvalidArgumentError("ArgIndex device address is null");
+  }
+  uintptr_t input_address_value = reinterpret_cast<uintptr_t>(input_address.opaque());
+  uintptr_t output_address_value = reinterpret_cast<uintptr_t>(output_address.opaque());
+  bool address_overlap = input_address_value < output_address_value
+      ? output_address_value - input_address_value < static_cast<uint64_t>(input_bytes)
+      : input_address_value - output_address_value < static_cast<uint64_t>(output_bytes);
+  if (address_overlap) {
+    return absl::InvalidArgumentError("ArgIndex input/output device payloads overlap");
+  }
+  auto* pool = NpuWorkspaceMemoryPool::GetInstance();
+  if (pool == nullptr) return absl::InternalError("ArgIndex workspace pool unavailable");
+  const auto aligned = [](size_t bytes) {
+    return (bytes + kWorkspaceMemoryAlignment - 1) & ~(kWorkspaceMemoryAlignment - 1);
+  };
+  if (is_integer) {
+    size_t canonical_offset = aligned(static_cast<size_t>(output_elements) * sizeof(int64_t));
+    size_t scratch_bytes = canonical_offset + aligned(static_cast<size_t>(input_bytes));
+    TF_ASSIGN_OR_RETURN(void* scratch,
+                        pool->AllocateForStream(stream, scratch_bytes));
+    if (scratch == nullptr) return absl::InternalError("S32 ArgIndex scratch is null");
+    auto destroy_tensor = [](aclTensor* tensor) { dep::aclDestroyTensor(tensor); };
+    std::unique_ptr<aclTensor, decltype(destroy_tensor)> input_tensor(
+        CreateDenseTensor(input_shape, ACL_INT32, input_address.opaque()), destroy_tensor);
+    std::unique_ptr<aclTensor, decltype(destroy_tensor)> wide_indices_tensor(
+        CreateDenseTensor(output_shape, ACL_INT64, scratch), destroy_tensor);
+    std::unique_ptr<aclTensor, decltype(destroy_tensor)> indices_tensor(
+        CreateDenseTensor(output_shape, ACL_INT32, output_address.opaque()), destroy_tensor);
+    Shape canonical_shape = input_shape;
+    *canonical_shape.mutable_layout() = LayoutUtil::GetDefaultLayoutForRank(rank);
+    std::unique_ptr<aclTensor, decltype(destroy_tensor)> canonical_input(
+        CreateDenseTensor(canonical_shape, ACL_INT32,
+                          static_cast<char*>(scratch) + canonical_offset), destroy_tensor);
+    if (!input_tensor || !wide_indices_tensor || !indices_tensor || !canonical_input) {
+      return absl::InternalError("S32 ArgIndex tensor descriptor creation failed");
+    }
+    uint64_t workspace_size = 0;
+    aclOpExecutor* executor = nullptr;
+    const auto execute = [&](aclnnStatus query_status, auto operation) -> absl::Status {
+      if (query_status != ACL_SUCCESS || executor == nullptr) {
+        return absl::InternalError("S32 ArgIndex workspace query failed");
+      }
+      if (workspace_size > kWorkspaceMemoryPerStream - scratch_bytes) {
+        return absl::ResourceExhaustedError("S32 ArgIndex scratch/workspace exceeds stream pool");
+      }
+      TF_ASSIGN_OR_RETURN(void* combined,
+                          pool->AllocateForStream(stream, scratch_bytes + workspace_size));
+      if (combined != scratch) return absl::InternalError("S32 ArgIndex scratch base changed");
+      void* workspace = workspace_size == 0
+          ? nullptr : static_cast<char*>(scratch) + scratch_bytes;
+      if (operation(workspace, workspace_size, executor, stream) != ACL_SUCCESS) {
+        return absl::InternalError("S32 ArgIndex native execution failed");
+      }
+      return absl::OkStatus();
+    };
+    if (is_max_) {
+      TF_RETURN_IF_ERROR(execute(dep::aclnnBitwiseNotGetWorkspaceSize(
+          input_tensor.get(), canonical_input.get(), &workspace_size, &executor),
+          dep::aclnnBitwiseNot));
+    } else {
+      TF_RETURN_IF_ERROR(execute(dep::aclnnInplaceCopyGetWorkspaceSize(
+          canonical_input.get(), input_tensor.get(), &workspace_size, &executor),
+          dep::aclnnInplaceCopy));
+    }
+    TF_RETURN_IF_ERROR(execute(dep::aclnnArgMinGetWorkspaceSize(
+        canonical_input.get(), axis_, false, wide_indices_tensor.get(),
+        &workspace_size, &executor), dep::aclnnArgMin));
+    TF_RETURN_IF_ERROR(execute(dep::aclnnCastGetWorkspaceSize(
+        wide_indices_tensor.get(), ACL_INT32, indices_tensor.get(),
+        &workspace_size, &executor), dep::aclnnCast));
+    return absl::OkStatus();
+  }
+  size_t values_bytes = static_cast<size_t>(output_elements) * sizeof(float);
+  size_t normalized_offset = aligned(values_bytes);
+  size_t canonical_offset = normalized_offset + aligned(static_cast<size_t>(input_bytes));
+  size_t mask_offset = canonical_offset + aligned(static_cast<size_t>(input_bytes));
+  size_t zero_offset = mask_offset + aligned(static_cast<size_t>(input_elements));
+  size_t scratch_bytes = zero_offset + kWorkspaceMemoryAlignment;
+  TF_ASSIGN_OR_RETURN(void* scratch,
+                      pool->AllocateForStream(stream, scratch_bytes));
+  if (scratch == nullptr) return absl::InternalError("ArgIndex scratch is null");
+  auto destroy_tensor = [](aclTensor* tensor) { dep::aclDestroyTensor(tensor); };
+  std::unique_ptr<aclTensor, decltype(destroy_tensor)> input_tensor(
+      CreateDenseTensor(input_shape, ACL_FLOAT, input_address.opaque()), destroy_tensor);
+  std::unique_ptr<aclTensor, decltype(destroy_tensor)> values_tensor(
+      CreateDenseTensor(output_shape, ACL_FLOAT, scratch), destroy_tensor);
+  std::unique_ptr<aclTensor, decltype(destroy_tensor)> indices_tensor(
+      CreateDenseTensor(output_shape, ACL_INT32, output_address.opaque()), destroy_tensor);
+  Shape normalized_shape = input_shape;
+  *normalized_shape.mutable_layout() = LayoutUtil::GetDefaultLayoutForRank(rank);
+  std::unique_ptr<aclTensor, decltype(destroy_tensor)> canonical_input(
+      CreateDenseTensor(normalized_shape, ACL_FLOAT, static_cast<char*>(scratch) + canonical_offset),
+      destroy_tensor);
+  std::unique_ptr<aclTensor, decltype(destroy_tensor)> normalized_tensor(
+      CreateDenseTensor(normalized_shape, ACL_FLOAT, static_cast<char*>(scratch) + normalized_offset),
+      destroy_tensor);
+  std::unique_ptr<aclTensor, decltype(destroy_tensor)> zero_mask(
+      CreateDenseTensor(normalized_shape, ACL_BOOL, static_cast<char*>(scratch) + mask_offset),
+      destroy_tensor);
+  std::unique_ptr<aclTensor, decltype(destroy_tensor)> zero_tensor(
+      CreateDenseTensor(ShapeUtil::MakeShape(F32, {}), ACL_FLOAT,
+                        static_cast<char*>(scratch) + zero_offset), destroy_tensor);
+  if (!input_tensor || !values_tensor || !indices_tensor || !normalized_tensor ||
+      !zero_mask || !zero_tensor || !canonical_input) {
+    return absl::InternalError("ArgIndex tensor descriptor creation failed");
+  }
+  float zero_value = 0.f;
+  auto destroy_scalar = [](aclScalar* scalar) { dep::aclDestroyScalar(scalar); };
+  std::unique_ptr<aclScalar, decltype(destroy_scalar)> zero_scalar(
+      dep::aclCreateScalar(&zero_value, ACL_FLOAT), destroy_scalar);
+  if (!zero_scalar) return absl::InternalError("ArgIndex zero scalar creation failed");
+  uint64_t workspace_size = 0;
+  aclOpExecutor* executor = nullptr;
+  const auto execute = [&](aclnnStatus query_status, auto operation) -> absl::Status {
+    if (query_status != ACL_SUCCESS || executor == nullptr) {
+      return absl::InternalError("ArgIndex zero normalization workspace query failed");
+    }
+    if (workspace_size > kWorkspaceMemoryPerStream - scratch_bytes) {
+      return absl::ResourceExhaustedError("ArgIndex normalization exceeds stream pool");
+    }
+    TF_ASSIGN_OR_RETURN(void* combined,
+                        pool->AllocateForStream(stream, scratch_bytes + workspace_size));
+    if (combined != scratch) return absl::InternalError("ArgIndex scratch base changed");
+    void* workspace = workspace_size == 0
+        ? nullptr : static_cast<char*>(scratch) + scratch_bytes;
+    if (operation(workspace, workspace_size, executor, stream) != ACL_SUCCESS) {
+      return absl::InternalError("ArgIndex native zero normalization failed");
+    }
+    return absl::OkStatus();
+  };
+  TF_RETURN_IF_ERROR(execute(dep::aclnnInplaceCopyGetWorkspaceSize(
+      canonical_input.get(), input_tensor.get(), &workspace_size, &executor),
+      dep::aclnnInplaceCopy));
+  TF_RETURN_IF_ERROR(execute(dep::aclnnInplaceFillScalarGetWorkspaceSize(
+      zero_tensor.get(), zero_scalar.get(), &workspace_size, &executor),
+      dep::aclnnInplaceFillScalar));
+  TF_RETURN_IF_ERROR(execute(dep::aclnnEqScalarGetWorkspaceSize(
+      canonical_input.get(), zero_scalar.get(), zero_mask.get(), &workspace_size, &executor),
+      dep::aclnnEqScalar));
+  TF_RETURN_IF_ERROR(execute(dep::aclnnSWhereGetWorkspaceSize(
+      zero_mask.get(), zero_tensor.get(), canonical_input.get(), normalized_tensor.get(),
+      &workspace_size, &executor), dep::aclnnSWhere));
+  aclnnStatus status = is_max_
+      ? dep::aclnnMaxDimGetWorkspaceSize(normalized_tensor.get(), axis_, false,
+          values_tensor.get(), indices_tensor.get(), &workspace_size, &executor)
+      : dep::aclnnMinDimGetWorkspaceSize(normalized_tensor.get(), axis_, false,
+          values_tensor.get(), indices_tensor.get(), &workspace_size, &executor);
+  if (status != ACL_SUCCESS || executor == nullptr) {
+    return absl::InternalError(absl::StrFormat("ArgIndex workspace query failed: %d", status));
+  }
+  if (workspace_size > kWorkspaceMemoryPerStream - scratch_bytes) {
+    return absl::ResourceExhaustedError("ArgIndex scratch/workspace exceeds stream pool");
+  }
+  size_t total_bytes = scratch_bytes + static_cast<size_t>(workspace_size);
+  TF_ASSIGN_OR_RETURN(void* combined,
+                      pool->AllocateForStream(stream, total_bytes));
+  if (combined != scratch) {
+    return absl::InternalError("ArgIndex stream pool changed scratch base");
+  }
+  void* workspace = workspace_size == 0
+      ? nullptr : static_cast<char*>(scratch) + scratch_bytes;
+  status = is_max_
+      ? dep::aclnnMaxDim(workspace, workspace_size, executor, stream)
+      : dep::aclnnMinDim(workspace, workspace_size, executor, stream);
+  if (status != ACL_SUCCESS) {
+    return absl::InternalError(absl::StrFormat("ArgIndex native execution failed: %d", status));
+  }
+  return absl::OkStatus();
+}
+
+}
