diff --git a/xla_npu/backend/runtime/npu_scatter_metadata.h b/xla_npu/backend/runtime/npu_scatter_metadata.h
new file mode 100644
index 0000000..1f2fbec
--- /dev/null
+++ b/xla_npu/backend/runtime/npu_scatter_metadata.h
@@ -0,0 +1,116 @@
+#ifndef XLA_XLA_NPU_BACKEND_RUNTIME_NPU_SCATTER_METADATA_H_
+#define XLA_XLA_NPU_BACKEND_RUNTIME_NPU_SCATTER_METADATA_H_
+
+#include <cstdint>
+#include <limits>
+#include <string>
+#include <vector>
+
+namespace xla {
+
+enum class NpuScatterReduction { kSet, kAdd, kUnsupported };
+enum class NpuScatterElementType { kF32, kS32, kS64, kPred, kUnsupported };
+
+struct NpuScatterSpec {
+  std::vector<int64_t> operand_dims;
+  std::vector<int64_t> indices_dims;
+  std::vector<int64_t> updates_dims;
+  std::vector<int64_t> update_window_dims;
+  std::vector<int64_t> inserted_window_dims;
+  std::vector<int64_t> scatter_dims_to_operand_dims;
+  int64_t index_vector_dim = -1;
+  bool has_batching = false;
+  bool indices_in_bounds = false;
+  bool unique_indices = false;
+  NpuScatterReduction reduction = NpuScatterReduction::kSet;
+  NpuScatterElementType element_type = NpuScatterElementType::kF32;
+};
+
+struct NpuScatterMetadata {
+  NpuScatterReduction reduction = NpuScatterReduction::kUnsupported;
+  int64_t index_rows = 0;
+  bool needs_bounds_mask = false;
+};
+
+inline std::string ValidateNpuScatter(const NpuScatterSpec& spec,
+                                     NpuScatterMetadata* metadata) {
+  if (metadata == nullptr) return "scatter metadata destination is null";
+  if (spec.operand_dims.empty() || spec.operand_dims.size() > 8 ||
+      spec.has_batching || spec.inserted_window_dims != std::vector<int64_t>{0} ||
+      spec.scatter_dims_to_operand_dims != std::vector<int64_t>{0}) {
+    return "scatter supports only unbatched leading-axis full-row updates";
+  }
+  int64_t operand_elements = 1;
+  for (int64_t dimension : spec.operand_dims) {
+    if (dimension <= 0) return "scatter requires nonempty static operand dimensions";
+    if (operand_elements > std::numeric_limits<int64_t>::max() / dimension) {
+      return "scatter operand size overflows metadata arithmetic";
+    }
+    operand_elements *= dimension;
+  }
+  int64_t rows;
+  bool has_update_batch;
+  if (spec.indices_dims == std::vector<int64_t>{1} && spec.index_vector_dim == 0) {
+    rows = 1;
+    has_update_batch = false;
+  } else if (spec.indices_dims.size() == 2 && spec.indices_dims[1] == 1 &&
+             spec.indices_dims[0] >= 0 && spec.index_vector_dim == 1) {
+    rows = spec.indices_dims[0];
+    has_update_batch = true;
+  } else {
+    return "scatter requires indices [1] or [N,1] with explicit scalar index vectors";
+  }
+  int64_t row_elements = operand_elements / spec.operand_dims[0];
+  if (rows != 0 && row_elements > std::numeric_limits<int64_t>::max() / rows) {
+    return "scatter update size overflows metadata arithmetic";
+  }
+  std::vector<int64_t> expected_updates;
+  std::vector<int64_t> expected_window;
+  if (has_update_batch) expected_updates.push_back(rows);
+  for (size_t dimension = 1; dimension < spec.operand_dims.size(); ++dimension) {
+    expected_window.push_back(expected_updates.size());
+    expected_updates.push_back(spec.operand_dims[dimension]);
+  }
+  if (spec.updates_dims != expected_updates ||
+      spec.update_window_dims != expected_window) {
+    return "scatter update shape/window does not describe full leading-axis rows";
+  }
+  if (rows != 0 && !spec.indices_in_bounds) {
+    if (!((spec.reduction == NpuScatterReduction::kSet && rows == 1) ||
+          (spec.reduction == NpuScatterReduction::kAdd &&
+           spec.element_type == NpuScatterElementType::kS32))) {
+      return "scatter dynamic drop semantics support only single replacement or s32 addition";
+    }
+  }
+  if (spec.reduction == NpuScatterReduction::kSet) {
+    if (rows > 1 && !spec.unique_indices) {
+      return "scatter replacement with duplicate indices is unsupported";
+    }
+    if (spec.element_type != NpuScatterElementType::kF32 &&
+        spec.element_type != NpuScatterElementType::kS32 &&
+        spec.element_type != NpuScatterElementType::kS64 &&
+        spec.element_type != NpuScatterElementType::kPred) {
+      return "InplaceScatter supports only bounded f32/s32/s64/pred in this backend";
+    }
+  } else if (spec.reduction == NpuScatterReduction::kAdd) {
+    if (spec.element_type != NpuScatterElementType::kS32 &&
+        spec.element_type != NpuScatterElementType::kF32) {
+      return "TfScatterAdd supports only bounded s32/f32 in this backend";
+    }
+    if (spec.element_type == NpuScatterElementType::kF32 && rows > 1 &&
+        !spec.unique_indices) {
+      return "floating scatter-add duplicates lack CPU-consistent accumulation order";
+    }
+  } else {
+    return "scatter update computation is neither scalar replacement nor scalar addition";
+  }
+  if (operand_elements > (1LL << 24) || rows > (1LL << 20) ||
+      rows * row_elements > (1LL << 24)) {
+    return "scatter exceeds bounded tensor/update size limits";
+  }
+  *metadata = {spec.reduction, rows, rows != 0 && !spec.indices_in_bounds};
+  return {};
+}
+
+}
+#endif
