diff --git a/xla_npu/backend/runtime/npu_reduction_thunk.cc b/xla_npu/backend/runtime/npu_reduction_thunk.cc
new file mode 100644
index 0000000..e4113f4
--- /dev/null
+++ b/xla_npu/backend/runtime/npu_reduction_thunk.cc
@@ -0,0 +1,221 @@
+#include "xla/xla_npu/backend/runtime/npu_reduction_thunk.h"
+
+#include <cstdint>
+#include <limits>
+#include <memory>
+#include <vector>
+
+#include "absl/status/status.h"
+#include "absl/strings/str_format.h"
+#include "xla/layout_util.h"
+#include "xla/shape_util.h"
+#include "xla/tsl/platform/statusor.h"
+#include "xla/xla_npu/backend/runtime/npu_workspace_memory_pool.h"
+#include "xla/xla_npu/common/npu_tool.h"
+#include "xla/xla_npu/dependency/interface/acl_interface.h"
+#include "xla/xla_npu/dependency/interface/acl_nn_interface.h"
+#include "xla/xla_npu/dependency/interface/acl_nn_op_interface.h"
+
+namespace xla {
+namespace {
+
+bool IsStaticDenseArray(const Shape& shape) {
+  if (!shape.IsArray() || !shape.has_layout() ||
+      !LayoutUtil::IsDenseArray(shape) || shape.layout().tiles_size() != 0 ||
+      shape.layout().element_size_in_bits() != 0 ||
+      shape.layout().minor_to_major_size() != shape.dimensions_size()) {
+    return false;
+  }
+  int64_t rank = shape.dimensions_size();
+  std::vector<bool> seen(rank, false);
+  for (int64_t dimension = 0; dimension < rank; ++dimension) {
+    if (shape.is_dynamic_dimension(dimension)) return false;
+    int64_t axis = shape.layout().minor_to_major(dimension);
+    if (axis < 0 || axis >= rank || seen[axis]) {
+      return false;
+    }
+    seen[axis] = true;
+  }
+  return true;
+}
+
+bool SupportsReductionType(NpuReductionKind kind, PrimitiveType type) {
+  switch (kind) {
+    case NpuReductionKind::kSum:
+      return type == F32 || type == S32;
+    case NpuReductionKind::kMinimum:
+    case NpuReductionKind::kMaximum:
+      return type == F32 || type == S32;
+    case NpuReductionKind::kAll:
+    case NpuReductionKind::kAny:
+      return type == PRED;
+    default:
+      return false;
+  }
+}
+
+}
+
+NpuThunk::BufferUses NpuReductionThunk::buffer_uses() const {
+  return {BufferUse::Read(input_), BufferUse::Write(output_)};
+}
+
+absl::Status NpuReductionThunk::ExecuteOnStream(const ExecuteParams& params) {
+  const auto& shapes = thunk_info().param_shapes;
+  if (params.stream == nullptr || params.buffer_allocations == nullptr ||
+      shapes.size() != 3) {
+    return absl::InvalidArgumentError("Reduction requires stream and three canonical shapes");
+  }
+  const Shape& input_shape = shapes.front();
+  const Shape& output_shape = shapes.back();
+  PrimitiveType type = input_shape.element_type();
+  if (!IsStaticDenseArray(input_shape) || !IsStaticDenseArray(output_shape) ||
+      !SupportsReductionType(kind_, type) || output_shape.element_type() != type ||
+      !shapes[1].IsArray() || shapes[1].dimensions_size() != 0 ||
+      shapes[1].element_type() != type) {
+    return absl::UnimplementedError("Reduction dtype/static dense untiled contract is unsupported");
+  }
+  int64_t rank = input_shape.dimensions_size();
+  const auto& axes = thunk_info().dimensions;
+  if (rank < 1 || rank > 8 || axes.empty() || axes.size() > static_cast<size_t>(rank)) {
+    return absl::UnimplementedError("Reduction requires rank 1..8 and nonempty bounded axes");
+  }
+  std::vector<bool> reduced(rank, false);
+  for (int64_t axis : axes) {
+    if (axis < 0 || axis >= rank || reduced[axis]) {
+      return absl::InvalidArgumentError("Reduction axes must be unique and within rank");
+    }
+    reduced[axis] = true;
+  }
+  int64_t input_elements = 1;
+  const int64_t max_input_elements =
+      type == F32 && (kind_ == NpuReductionKind::kMinimum || kind_ == NpuReductionKind::kMaximum)
+          ? (1LL << 26) : (1LL << 24);
+  int64_t output_elements = 1;
+  int64_t output_dimension = 0;
+  for (int64_t dimension = 0; dimension < rank; ++dimension) {
+    int64_t extent = input_shape.dimensions(dimension);
+    if (extent <= 0 || input_elements > max_input_elements / extent) {
+      return absl::UnimplementedError(absl::StrFormat(
+          "Reduction input exceeds positive bounded tensor scope: rank=%d dimension=%d extent=%d partial_elements=%d operation=%s",
+          rank, dimension, extent, input_elements, thunk_info().op_name));
+    }
+    input_elements *= extent;
+    if (!reduced[dimension]) {
+      if (output_dimension >= output_shape.dimensions_size() ||
+          output_shape.dimensions(output_dimension) != extent) {
+        return absl::InvalidArgumentError("Reduction output must remove exactly the axes");
+      }
+      output_elements *= extent;
+      ++output_dimension;
+    }
+  }
+  if (output_dimension != output_shape.dimensions_size() ||
+      output_elements > (1LL << 24)) {
+    return absl::InvalidArgumentError("Reduction output shape/element bound is invalid");
+  }
+  int64_t element_bytes = ShapeUtil::ByteSizeOfPrimitiveType(type);
+  int64_t input_bytes = input_elements * element_bytes;
+  int64_t output_bytes = output_elements * element_bytes;
+  if (input_.size() < input_bytes || output_.size() < output_bytes ||
+      input_.offset() < 0 || output_.offset() < 0 ||
+      input_.offset() > std::numeric_limits<int64_t>::max() - input_.size() ||
+      output_.offset() > std::numeric_limits<int64_t>::max() - output_.size()) {
+    return absl::InvalidArgumentError("Reduction payload exceeds or invalidates allocation slice");
+  }
+  if (input_.index() == output_.index()) {
+    bool overlap = input_.offset() <= output_.offset()
+        ? output_.offset() - input_.offset() < input_.size()
+        : input_.offset() - output_.offset() < output_.size();
+    if (overlap) return absl::InvalidArgumentError("Reduction input/output slices overlap");
+  }
+  auto stream = static_cast<aclrtStream>(params.stream->platform_specific_handle().stream);
+  if (stream == nullptr) return absl::InvalidArgumentError("Reduction device stream is null");
+  auto input_address = params.buffer_allocations->GetDeviceAddress(input_);
+  auto output_address = params.buffer_allocations->GetDeviceAddress(output_);
+  if (input_address.opaque() == nullptr || output_address.opaque() == nullptr) {
+    return absl::InvalidArgumentError("Reduction device address is null");
+  }
+  uintptr_t input_address_value = reinterpret_cast<uintptr_t>(input_address.opaque());
+  uintptr_t output_address_value = reinterpret_cast<uintptr_t>(output_address.opaque());
+  bool overlap = input_address_value < output_address_value
+      ? output_address_value - input_address_value < static_cast<uint64_t>(input_bytes)
+      : input_address_value - output_address_value < static_cast<uint64_t>(output_bytes);
+  if (overlap) return absl::InvalidArgumentError("Reduction input/output device payloads overlap");
+  auto destroy_tensor = [](aclTensor* tensor) { dep::aclDestroyTensor(tensor); };
+  auto destroy_dims = [](aclIntArray* dims) { dep::aclDestroyIntArray(dims); };
+  std::unique_ptr<aclTensor, decltype(destroy_tensor)> input_tensor(
+      NpuTool::CreateAclTensorPtr(input_shape, type, input_address.opaque()), destroy_tensor);
+  std::unique_ptr<aclTensor, decltype(destroy_tensor)> output_tensor(
+      NpuTool::CreateAclTensorPtr(output_shape, type, output_address.opaque()), destroy_tensor);
+  std::unique_ptr<aclIntArray, decltype(destroy_dims)> dimensions(
+      dep::aclCreateIntArray(axes.data(), axes.size()), destroy_dims);
+  if (!input_tensor || !output_tensor || !dimensions) {
+    return absl::InternalError("Reduction descriptor creation failed");
+  }
+  uint64_t workspace_size = 0;
+  aclOpExecutor* executor = nullptr;
+  aclnnStatus status = ACL_SUCCESS;
+  switch (kind_) {
+    case NpuReductionKind::kSum:
+      status = dep::aclnnReduceSumGetWorkspaceSize(input_tensor.get(), dimensions.get(), false,
+          NpuTool::ConvertXlaType2AclDataType(type), output_tensor.get(), &workspace_size, &executor);
+      break;
+    case NpuReductionKind::kMinimum:
+      status = dep::aclnnAminGetWorkspaceSize(input_tensor.get(), dimensions.get(), false,
+          output_tensor.get(), &workspace_size, &executor);
+      break;
+    case NpuReductionKind::kMaximum:
+      status = dep::aclnnAmaxGetWorkspaceSize(input_tensor.get(), dimensions.get(), false,
+          output_tensor.get(), &workspace_size, &executor);
+      break;
+    case NpuReductionKind::kAll:
+      status = dep::aclnnAllGetWorkspaceSize(input_tensor.get(), dimensions.get(), false,
+          output_tensor.get(), &workspace_size, &executor);
+      break;
+    case NpuReductionKind::kAny:
+      status = dep::aclnnAnyGetWorkspaceSize(input_tensor.get(), dimensions.get(), false,
+          output_tensor.get(), &workspace_size, &executor);
+      break;
+    default:
+      return absl::UnimplementedError("Unknown reduction kind");
+  }
+  if (status != ACL_SUCCESS || executor == nullptr) {
+    return absl::InternalError(absl::StrFormat("Reduction workspace query failed: %d", status));
+  }
+  if (workspace_size > kWorkspaceMemoryPerStream) {
+    return absl::ResourceExhaustedError("Reduction workspace exceeds stream pool");
+  }
+  void* workspace = nullptr;
+  if (workspace_size != 0) {
+    auto* pool = NpuWorkspaceMemoryPool::GetInstance();
+    if (pool == nullptr) return absl::InternalError("Reduction workspace pool unavailable");
+    TF_ASSIGN_OR_RETURN(workspace, pool->AllocateForStream(stream, workspace_size));
+    if (workspace == nullptr) return absl::InternalError("Reduction workspace is null");
+  }
+  switch (kind_) {
+    case NpuReductionKind::kSum:
+      status = dep::aclnnReduceSum(workspace, workspace_size, executor, stream);
+      break;
+    case NpuReductionKind::kMinimum:
+      status = dep::aclnnAmin(workspace, workspace_size, executor, stream);
+      break;
+    case NpuReductionKind::kMaximum:
+      status = dep::aclnnAmax(workspace, workspace_size, executor, stream);
+      break;
+    case NpuReductionKind::kAll:
+      status = dep::aclnnAll(workspace, workspace_size, executor, stream);
+      break;
+    case NpuReductionKind::kAny:
+      status = dep::aclnnAny(workspace, workspace_size, executor, stream);
+      break;
+    default:
+      return absl::UnimplementedError("Unknown reduction kind");
+  }
+  if (status != ACL_SUCCESS) {
+    return absl::InternalError(absl::StrFormat("Reduction native execution failed: %d", status));
+  }
+  return absl::OkStatus();
+}
+
+}
