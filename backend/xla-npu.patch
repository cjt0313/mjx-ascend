+absl::Status LegalizeNativeRowWindowGather(HloModule* module) {
+  for (HloComputation* computation : module->MakeNonfusionComputations()) {
+    std::vector<HloInstruction*> gathers;
+    for (HloInstruction* instruction : computation->instructions()) {
+      if (instruction->opcode() == HloOpcode::kGather && instruction->gather_slice_sizes()[0] > 1 &&
+          instruction->gather_dimension_numbers().start_index_map_size() == 1 &&
+          instruction->gather_dimension_numbers().start_index_map(0) == 0) {
+        gathers.push_back(instruction);
+      }
+    }
+    for (HloInstruction* instruction : gathers) {
+      const auto& dimensions = instruction->gather_dimension_numbers();
+      const Shape& operand = instruction->operand(0)->shape();
+      const Shape& indices = instruction->operand(1)->shape();
+      const int64_t operand_rank = operand.dimensions_size();
+      const int64_t index_rank = indices.dimensions_size();
+      const int64_t batch_rank = index_rank - 1;
+      const int64_t width = instruction->gather_slice_sizes()[0];
+      if (operand_rank != 1 || index_rank != 2 ||
+          !LayoutUtil::IsMonotonicWithDim0Major(indices.layout()) ||
+          !LayoutUtil::IsMonotonicWithDim0Major(instruction->shape().layout()) ||
+          indices.layout().tiles_size() != 0 || instruction->shape().layout().tiles_size() != 0 ||
+          dimensions.index_vector_dim() != index_rank - 1 || indices.dimensions(index_rank - 1) != 1 ||
+          indices.element_type() != S32 || dimensions.collapsed_slice_dims_size() != 0 ||
+          dimensions.operand_batching_dims_size() != 0 || dimensions.start_indices_batching_dims_size() != 0 ||
+          dimensions.offset_dims_size() != operand_rank || width > operand.dimensions(0) ||
+          width > (1 << 24) || operand.dimensions(0) > INT32_MAX) {
+        return absl::UnimplementedError("Native row windows require bounded explicit contiguous slices");
+      }
+      for (int64_t axis = 0; axis < operand_rank; ++axis) {
+        if (dimensions.offset_dims(axis) != batch_rank + axis ||
+            (axis > 0 && instruction->gather_slice_sizes()[axis] != operand.dimensions(axis))) {
+          return absl::UnimplementedError("Native row windows require ordered full trailing slices");
+        }
+      }
+      auto bound = [&](int32_t value) {
+        HloInstruction* scalar = computation->AddInstruction(HloInstruction::CreateConstant(
+            LiteralUtil::CreateR0<int32_t>(value)));
+        return computation->AddInstruction(HloInstruction::CreateBroadcast(indices, scalar, {}));
+      };
+      HloInstruction* starts = computation->AddInstruction(HloInstruction::CreateBinary(
+          indices, HloOpcode::kMaximum, instruction->mutable_operand(1), bound(0)));
+      starts = computation->AddInstruction(HloInstruction::CreateBinary(
+          indices, HloOpcode::kMinimum, starts, bound(operand.dimensions(0) - width)));
+      std::vector<int64_t> batch_dimensions(indices.dimensions().begin(), indices.dimensions().end() - 1);
+      starts = computation->AddInstruction(HloInstruction::CreateReshape(
+          ShapeUtil::MakeShape(S32, batch_dimensions), starts));
+      std::vector<int64_t> window_dimensions = batch_dimensions;
+      window_dimensions.push_back(width);
+      const Shape window_shape = ShapeUtil::MakeShape(S32, window_dimensions);
+      std::vector<int64_t> broadcast_dimensions;
+      for (int64_t axis = 0; axis < batch_rank; ++axis) broadcast_dimensions.push_back(axis);
+      starts = computation->AddInstruction(HloInstruction::CreateBroadcast(window_shape, starts, broadcast_dimensions));
+      HloInstruction* offsets = computation->AddInstruction(HloInstruction::CreateIota(
+          ShapeUtil::MakeShape(S32, {width}), 0));
+      offsets = computation->AddInstruction(HloInstruction::CreateBroadcast(window_shape, offsets, {batch_rank}));
+      HloInstruction* rows = computation->AddInstruction(HloInstruction::CreateBinary(
+          window_shape, HloOpcode::kAdd, starts, offsets));
+      window_dimensions.push_back(1);
+      rows = computation->AddInstruction(HloInstruction::CreateReshape(ShapeUtil::MakeShape(S32, window_dimensions), rows));
+      GatherDimensionNumbers normalized;
+      normalized.add_start_index_map(0);
+      normalized.add_collapsed_slice_dims(0);
+      normalized.set_index_vector_dim(index_rank);
+      std::vector<int64_t> slice_sizes(operand.dimensions().begin(), operand.dimensions().end());
+      slice_sizes[0] = 1;
+      for (int64_t axis = 1; axis < operand_rank; ++axis) normalized.add_offset_dims(batch_rank + axis);
+      TF_RETURN_IF_ERROR(computation->ReplaceWithNewInstruction(instruction,
+          HloInstruction::CreateGather(instruction->shape(), instruction->mutable_operand(0), rows,
+                                       normalized, slice_sizes, false)));
+    }
+  }
+  return absl::OkStatus();
+}
