+              HloInstruction::CreateConstant(std::move(row_literal)));
+          HloInstruction* destination_indices = computation->AddInstruction(
+              HloInstruction::CreateConstant(std::move(destination_literal)));
+          std::vector<int64_t> gathered_dimensions(updates.dimensions().begin(), updates.dimensions().end());
+          gathered_dimensions[0] = row_count;
+          HloInstruction* gathered = computation->AddInstruction(HloInstruction::CreateGather(
+              ShapeUtil::MakeShape(F32, gathered_dimensions), instruction->mutable_operand(2), row_indices,
+              gather_dimensions, slice_sizes, true));
+          const bool sorted = std::is_sorted(destinations.begin(), destinations.end());
