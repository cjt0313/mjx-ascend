+absl::Status NpuAclnnThunk::ExecuteScatter(const ExecuteParams& params) {
+  const auto& shapes = thunk_info().param_shapes;
+  if (!scatter_metadata_ || args_.size() != 4 || shapes.size() != 4 ||
+      scatter_metadata_->index_rows < 0 ||
+      (scatter_metadata_->reduction != NpuScatterReduction::kSet &&
+       scatter_metadata_->reduction != NpuScatterReduction::kAdd)) {
+    return absl::UnimplementedError("scatter requires validated compile-time metadata and four buffers");
+  }
+  for (size_t argument = 0; argument < 3; ++argument) {
+    if (args_[argument].index() == args_[3].index() &&
+        args_[argument].offset() < args_[3].offset() + args_[3].size() &&
+        args_[3].offset() < args_[argument].offset() + args_[argument].size()) {
+      return absl::UnimplementedError("scatter output must not overlap operand, indices, or updates");
+    }
+  }
+  if (!ShapeUtil::Equal(shapes[0], shapes[3])) {
+    return absl::InvalidArgumentError("scatter operand and output shapes differ");
+  }
+  for (size_t argument = 0; argument < shapes.size(); ++argument) {
+    if (ShapeUtil::ByteSizeOf(shapes[argument]) < 0 ||
+        args_[argument].size() < ShapeUtil::ByteSizeOf(shapes[argument])) {
+      return absl::InvalidArgumentError("scatter tensor allocation is too small");
+    }
+  }
+  const auto* allocations = params.buffer_allocations;
+  auto input = allocations->GetDeviceAddress(args_[0]);
+  auto output = allocations->GetDeviceAddress(args_[3]);
+  int64_t bytes = ShapeUtil::ByteSizeOf(shapes[0]);
+  if (bytes < 0 || args_[0].size() < bytes || args_[3].size() < bytes) {
+    return absl::InvalidArgumentError("scatter operand/output allocation is too small");
+  }
+  TF_RETURN_IF_ERROR(params.stream->Memcpy(&output, input, bytes));
+  if (scatter_metadata_->index_rows == 0) {
+    return SyncStreamIfEnabled(params.stream);
+  }
+  TF_ASSIGN_OR_RETURN(auto tensors, ExtractAclInputOutTensorPtr(allocations, shapes));
+  auto stream = static_cast<aclrtStream>(params.stream->platform_specific_handle().stream);
+  struct ScratchBuffers {
+    aclrtStream stream;
+    std::vector<void*> addresses;
+    bool synchronized = false;
+    ~ScratchBuffers() {
+      if (addresses.empty()) return;
+      if (!synchronized && dep::aclrtSynchronizeStream(stream) != ACL_SUCCESS) {
+        NPU_LOG_PRINT(ERROR, "scatter cleanup synchronization failed; retaining scratch buffers");
+        return;
+      }
+      for (void* address : addresses) dep::aclrtFree(address);
+    }
+  } scratch{stream, {}, false};
+  auto destroy_tensor = [](aclTensor* tensor) { dep::aclDestroyTensor(tensor); };
+  std::vector<std::unique_ptr<aclTensor, decltype(destroy_tensor)>> owners;
+  for (aclTensor* tensor : tensors) owners.emplace_back(tensor, destroy_tensor);
+  auto make_view = [&](const std::vector<int64_t>& dimensions,
+                       PrimitiveType type, void* address,
+                       const std::vector<int64_t>& storage_dimensions,
+                       std::vector<int64_t> strides = {}) {
+    bool contiguous = strides.empty();
+    if (contiguous) strides.resize(dimensions.size());
+    int64_t stride = 1;
+    if (contiguous) {
+      for (size_t dimension = dimensions.size(); dimension > 0; --dimension) {
+        strides[dimension - 1] = stride;
+        stride *= dimensions[dimension - 1];
+      }
+    }
+    return dep::aclCreateTensor(
+        dimensions.data(), dimensions.size(),
+        NpuTool::ConvertXlaType2AclDataType(type),
+        strides.data(), 0, aclFormat::ACL_FORMAT_ND,
