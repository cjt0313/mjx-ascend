+absl::Status LegalizeNativeStaticMaskScatter(HloModule* module) {
+  auto scalar_predicate = [](const HloInstruction* value) -> std::optional<bool> {
+    if (value->opcode() == HloOpcode::kBroadcast) value = value->operand(0);
+    if (value->opcode() != HloOpcode::kConstant || value->shape().element_type() != PRED ||
+        !ShapeUtil::IsScalar(value->shape())) return std::nullopt;
+    return value->literal().GetFirstElement<bool>();
+  };
+  for (auto* computation : module->computations()) {
+    for (auto* instruction : computation->MakeInstructionPostOrder()) {
+      if (instruction->opcode() != HloOpcode::kScatter || instruction->operand_count() != 3 ||
+          !instruction->shape().IsArray() || instruction->shape().element_type() != PRED ||
+          instruction->shape().dimensions_size() != 2) continue;
+      const auto* scatter = Cast<HloScatterInstruction>(instruction);
+      const auto& dimensions = scatter->scatter_dimension_numbers();
+      const auto* indices = instruction->operand(1);
+      auto initial = scalar_predicate(instruction->operand(0));
+      auto update = scalar_predicate(instruction->operand(2));
+      const auto& shape = instruction->shape();
+      if (!initial.has_value() || !update.has_value() || shape.dimensions(0) <= 0 || shape.dimensions(1) <= 0 ||
+          shape.dimensions(0) > (1 << 20) / shape.dimensions(1) ||
+          !LayoutUtil::IsMonotonicWithDim0Major(shape.layout()) || shape.layout().tiles_size() != 0 ||
+          dimensions.update_window_dims_size() != 0 || dimensions.inserted_window_dims_size() != 2 ||
+          dimensions.inserted_window_dims(0) != 0 || dimensions.inserted_window_dims(1) != 1 ||
+          dimensions.scatter_dims_to_operand_dims_size() != 2 || dimensions.scatter_dims_to_operand_dims(0) != 0 ||
+          dimensions.scatter_dims_to_operand_dims(1) != 1 || dimensions.index_vector_dim() != 1 ||
+          dimensions.input_batching_dims_size() != 0 || dimensions.scatter_indices_batching_dims_size() != 0 ||
+          indices->opcode() != HloOpcode::kConstant || indices->shape().dimensions_size() != 2 ||
+          indices->shape().dimensions(1) != 2 || indices->shape().element_type() != S32 ||
+          scatter->to_apply()->instruction_count() != 2 ||
+          scatter->to_apply()->root_instruction()->opcode() != HloOpcode::kParameter ||
+          scatter->to_apply()->root_instruction()->parameter_number() != 1) continue;
+      Literal mask = LiteralUtil::CreateFull<bool>({shape.dimensions(0), shape.dimensions(1)}, *initial);
+      for (int64_t index = 0; index < indices->shape().dimensions(0); ++index) {
+        const int32_t row = indices->literal().Get<int32_t>({index, 0});
+        const int32_t column = indices->literal().Get<int32_t>({index, 1});
+        if (row >= 0 && row < shape.dimensions(0) && column >= 0 && column < shape.dimensions(1)) {
+          mask.Set<bool>({row, column}, *update);
+        }
+      }
+      TF_RETURN_IF_ERROR(computation->ReplaceWithNewInstruction(instruction,
+          HloInstruction::CreateConstant(std::move(mask))));
+    }
+  }
+  return absl::OkStatus();
+}
