+absl::Status NpuIrEmitterUnnested::EmitPrefixSum(const HloInstruction* instr) {
+  const auto& shape = instr->shape();
+  if (!shape.IsArray() || shape.element_type() != S32 || shape.dimensions_size() != 1 ||
+      instr->operand_count() != 2 || !ShapeUtil::Equal(shape, instr->operand(0)->shape()) ||
+      !ShapeUtil::IsScalar(instr->operand(1)->shape()) ||
+      instr->operand(1)->shape().element_type() != S32 ||
+      instr->operand(1)->opcode() != HloOpcode::kConstant ||
+      instr->operand(1)->literal().GetFirstElement<int32_t>() != 0) {
+    return absl::UnimplementedError("ReduceWindow supports only zero-initialized rank-one s32 prefix sum");
+  }
+  int64_t extent = shape.dimensions(0);
+  const auto& window = instr->window();
+  if (extent < 1 || extent > (1LL << 24) || window.dimensions_size() != 1) {
+    return absl::UnimplementedError("Prefix sum requires one bounded nonempty window axis");
+  }
+  const auto& dimension = window.dimensions(0);
+  if (dimension.size() != extent || dimension.padding_low() != extent - 1 ||
+      dimension.padding_high() != 0 || dimension.stride() != 1 ||
+      dimension.base_dilation() != 1 || dimension.window_dilation() != 1 ||
+      dimension.window_reversal()) {
+    return absl::UnimplementedError("ReduceWindow geometry is not an inclusive forward prefix sum");
+  }
+  const auto* reducer = instr->to_apply();
+  const auto* root = reducer->root_instruction();
+  if (reducer->num_parameters() != 2 || reducer->instruction_count() != 3 ||
+      root->opcode() != HloOpcode::kAdd || root->operand_count() != 2 ||
+      !ShapeUtil::IsScalar(root->shape()) || root->shape().element_type() != S32 ||
+      !((root->operand(0) == reducer->parameter_instruction(0) &&
+         root->operand(1) == reducer->parameter_instruction(1)) ||
+        (root->operand(0) == reducer->parameter_instruction(1) &&
+         root->operand(1) == reducer->parameter_instruction(0)))) {
+    return absl::UnimplementedError("ReduceWindow reducer is not scalar s32 addition");
+  }
+  TF_ASSIGN_OR_RETURN(auto input, GetAllocationSliceForHlo(instr->operand(0)));
+  TF_ASSIGN_OR_RETURN(auto output, GetAllocationSliceForHlo(instr));
+  AddThunkToThunkSequence(std::make_unique<NpuCumsumThunk>(
+      NpuThunk::ThunkInfo::WithProfileAnnotation(instr, ir_emitter_context_->GetNextThunkId()),
+      input, output));
+  return absl::OkStatus();
+}
+
+absl::Status NpuIrEmitterUnnested::EmitReduction(const HloInstruction* instr) {
+  const auto unsupported = [&]() {
+    return absl::UnimplementedError(absl::StrCat(
+        "Reduce requires a canonical identity-initialized scalar reducer: ", instr->name(),
+        " type=", PrimitiveType_Name(instr->shape().element_type()),
+        " reducer=", HloOpcodeString(instr->to_apply()->root_instruction()->opcode())));
+  };
+  if (!instr->shape().IsArray() || instr->operand_count() != 2 ||
+      !instr->operand(0)->shape().IsArray() || !ShapeUtil::IsScalar(instr->operand(1)->shape()) ||
+      instr->operand(1)->opcode() != HloOpcode::kConstant) return unsupported();
+  PrimitiveType type = instr->shape().element_type();
+  if (instr->operand(0)->shape().element_type() != type ||
+      instr->operand(1)->shape().element_type() != type) return unsupported();
+  const auto* reducer = instr->to_apply();
+  const auto* root = reducer->root_instruction();
+  if (reducer->num_parameters() != 2 || reducer->instruction_count() != 3 ||
+      root->operand_count() != 2 || !ShapeUtil::IsScalar(root->shape()) ||
+      root->shape().element_type() != type) return unsupported();
+  const auto* first = reducer->parameter_instruction(0);
+  const auto* second = reducer->parameter_instruction(1);
+  if (!ShapeUtil::IsScalar(first->shape()) || !ShapeUtil::IsScalar(second->shape()) ||
+      first->shape().element_type() != type || second->shape().element_type() != type ||
+      !((root->operand(0) == first && root->operand(1) == second) ||
+        (root->operand(0) == second && root->operand(1) == first))) return unsupported();
+  std::optional<NpuReductionKind> kind;
+  const auto& initial = instr->operand(1)->literal();
+  if (type == F32) {
+    float value = initial.GetFirstElement<float>();
+    if (root->opcode() == HloOpcode::kAdd && value == 0.f && !std::signbit(value)) {
+      kind = NpuReductionKind::kSum;
+    } else if (root->opcode() == HloOpcode::kMinimum && std::isinf(value) && !std::signbit(value)) {
+      kind = NpuReductionKind::kMinimum;
+    } else if (root->opcode() == HloOpcode::kMaximum && std::isinf(value) && std::signbit(value)) {
+      kind = NpuReductionKind::kMaximum;
+    }
+  } else if (type == S32) {
+    int32_t value = initial.GetFirstElement<int32_t>();
+    if (root->opcode() == HloOpcode::kAdd && value == 0) kind = NpuReductionKind::kSum;
+    if (root->opcode() == HloOpcode::kMinimum && value == std::numeric_limits<int32_t>::max()) {
+      kind = NpuReductionKind::kMinimum;
+    }
+    if (root->opcode() == HloOpcode::kMaximum && value == std::numeric_limits<int32_t>::min()) {
+      kind = NpuReductionKind::kMaximum;
+    }
+  } else if (type == PRED) {
+    bool value = initial.GetFirstElement<bool>();
+    if (root->opcode() == HloOpcode::kAnd && value) kind = NpuReductionKind::kAll;
+    if (root->opcode() == HloOpcode::kOr && !value) kind = NpuReductionKind::kAny;
+  }
+  if (!kind.has_value()) return unsupported();
+  TF_ASSIGN_OR_RETURN(auto input, GetAllocationSliceForHlo(instr->operand(0)));
+  TF_ASSIGN_OR_RETURN(auto output, GetAllocationSliceForHlo(instr));
+  AddThunkToThunkSequence(std::make_unique<NpuReductionThunk>(
+      NpuThunk::ThunkInfo::WithProfileAnnotation(instr, ir_emitter_context_->GetNextThunkId()),
+      input, output, *kind));
+  return absl::OkStatus();
+}
+
+absl::Status NpuIrEmitterUnnested::EmitArgIndex(const HloInstruction* instr) {
+  const auto unsupported = [&](absl::string_view reason = "reducer graph") {
+    return absl::UnimplementedError(absl::StrCat(
+        "Tuple Reduce requires canonical index-only f32/s32 argmin or argmax: ",
+        reason, " instruction=", instr->ToString(), " index_source=",
+        instr->operand_count() > 1 ? instr->operand(1)->ToString() : "none"));
+  };
+  if (!instr->shape().IsTuple() || instr->shape().tuple_shapes_size() != 2 ||
+      instr->operand_count() != 4 || instr->dimensions().size() != 1 ||
+      instr->user_count() == 0 || instr == instr->parent()->root_instruction()) {
+    return unsupported("tuple arity/axis/root");
+  }
+  for (const auto* user : instr->users()) {
+    if (user->opcode() != HloOpcode::kGetTupleElement || user->tuple_index() != 1) {
+      return unsupported("observable non-index user");
+    }
+  }
+  const auto& input = instr->operand(0)->shape();
+  const auto& indices = instr->operand(1)->shape();
+  int64_t axis = instr->dimensions()[0];
+  bool is_integer = input.element_type() == S32;
+  if (!input.IsArray() || (input.element_type() != F32 && !is_integer) || !indices.IsArray() ||
+      indices.element_type() != S32 || axis < 0 || axis >= input.dimensions_size() ||
+      !ShapeUtil::SameDimensions(input, indices) ||
+      instr->shape().tuple_shapes(0).element_type() != input.element_type() ||
+      instr->shape().tuple_shapes(1).element_type() != S32) {
+    return unsupported("input/output types or dimensions");
+  }
+  if (is_integer) {
+    if (input.dimensions_size() != 2 || axis != 1) {
+      return unsupported("integer rank/axis");
+    }
+    for (int64_t dimension = 0; dimension < 2; ++dimension) {
+      if (input.is_dynamic_dimension(dimension) || indices.is_dynamic_dimension(dimension) ||
+          input.dimensions(dimension) < 1 || input.dimensions(dimension) > 64) {
+        return unsupported("integer static bounded dimensions");
+      }
+    }
+    for (const auto& output : instr->shape().tuple_shapes()) {
+      if (!output.IsArray() || output.dimensions_size() != 1 ||
+          output.dimensions(0) != input.dimensions(0) || output.is_dynamic_dimension(0) ||
+          output.element_type() != input.element_type()) {
+        return unsupported("integer output dimensions");
+      }
+    }
+  }
+  const HloInstruction* index_source = instr->operand(1);
+  if (index_source->opcode() == HloOpcode::kReshape) {
+    const auto* original = index_source->operand(0);
+    if (ShapeUtil::ElementsIn(indices) != indices.dimensions(axis) ||
+        original->shape().dimensions_size() != 1 ||
+        original->shape().dimensions(0) != indices.dimensions(axis) ||
+        original->opcode() != HloOpcode::kIota ||
+        Cast<HloIotaInstruction>(original)->iota_dimension() != 0) {
+      return unsupported("reshaped iota index source");
+    }
+  } else if (index_source->opcode() == HloOpcode::kBroadcast) {
+    const auto* original = index_source->operand(0);
+    if (index_source->dimensions().size() != 1 || index_source->dimensions()[0] != axis ||
+        original->shape().dimensions_size() != 1 ||
+        original->opcode() != HloOpcode::kIota ||
+        Cast<HloIotaInstruction>(original)->iota_dimension() != 0 ||
+        (is_integer && (original->shape().element_type() != S32 ||
+                        original->shape().dimensions(0) != indices.dimensions(axis) ||
+                        original->shape().is_dynamic_dimension(0)))) {
+      return unsupported("broadcast index source");
+    }
+  } else if (index_source->opcode() != HloOpcode::kIota ||
+             Cast<HloIotaInstruction>(index_source)->iota_dimension() != axis) {
+    return unsupported("iota index source");
+  }
+  const auto* value_init = instr->operand(2);
+  const auto* index_init = instr->operand(3);
+  if (!ShapeUtil::IsScalar(value_init->shape()) ||
+      value_init->shape().element_type() != input.element_type() ||
+      value_init->opcode() != HloOpcode::kConstant ||
+      !ShapeUtil::IsScalar(index_init->shape()) || index_init->shape().element_type() != S32 ||
+      index_init->opcode() != HloOpcode::kConstant ||
+      index_init->literal().GetFirstElement<int32_t>() != 0) {
+    return unsupported("scalar constant initializers");
+  }
+  bool is_max;
+  if (is_integer) {
+    int32_t initial = value_init->literal().GetFirstElement<int32_t>();
+    is_max = initial == std::numeric_limits<int32_t>::min();
+    if (!is_max && initial != std::numeric_limits<int32_t>::max()) {
+      return unsupported("integer value initializer");
+    }
+  } else {
+    float initial = value_init->literal().GetFirstElement<float>();
+    if (!std::isinf(initial)) return unsupported("non-infinite value initializer");
+    is_max = std::signbit(initial);
+  }
+  const auto* reducer = instr->to_apply();
+  const auto* root = reducer->root_instruction();
+  if (reducer->num_parameters() != 4 ||
+      (is_integer ? reducer->instruction_count() != 12 : reducer->instruction_count() != 14) ||
+      root->opcode() != HloOpcode::kTuple || root->operand_count() != 2) {
+    return unsupported("reducer arity/count/root");
+  }
+  const auto* lhs = reducer->parameter_instruction(0);
+  const auto* lhs_index = reducer->parameter_instruction(1);
+  const auto* rhs = reducer->parameter_instruction(2);
+  const auto* rhs_index = reducer->parameter_instruction(3);
+  for (const auto* parameter : {lhs, lhs_index, rhs, rhs_index}) {
+    if (!ShapeUtil::IsScalar(parameter->shape())) return unsupported();
+  }
+  if (lhs->shape().element_type() != input.element_type() ||
+      rhs->shape().element_type() != input.element_type() ||
+      lhs_index->shape().element_type() != S32 || rhs_index->shape().element_type() != S32) {
+    return unsupported();
+  }
+  const auto matches_binary = [](const HloInstruction* node, HloOpcode opcode,
+                                 const HloInstruction* first, const HloInstruction* second) {
+    return node->opcode() == opcode && node->operand_count() == 2 &&
+           node->operand(0) == first && node->operand(1) == second;
+  };
+  const auto matches_compare = [&](const HloInstruction* node, const HloInstruction* first,
+                                  const HloInstruction* second, ComparisonDirection direction) {
+    return matches_binary(node, HloOpcode::kCompare, first, second) &&
+           node->comparison_direction() == direction &&
+           (!is_integer ||
+            Cast<HloCompareInstruction>(node)->type() == Comparison::Type::kSigned);
+  };
+  const auto* values = root->operand(0);
+  const auto* result_indices = root->operand(1);
+  if (values->opcode() != HloOpcode::kSelect || values->operand_count() != 3 ||
+      values->operand(1) != lhs || values->operand(2) != rhs ||
+      result_indices->opcode() != HloOpcode::kSelect || result_indices->operand_count() != 3 ||
+      result_indices->operand(1) != lhs_index || result_indices->operand(2) != rhs_index) {
+    return unsupported();
+  }
+  const auto* value_predicate = values->operand(0);
+  const auto* index_predicate = result_indices->operand(0);
+  if (index_predicate->opcode() != HloOpcode::kOr || index_predicate->operand_count() != 2 ||
+      index_predicate->operand(0) != value_predicate) {
+    return unsupported();
+  }
+  if (is_integer) {
+    if (!matches_compare(value_predicate, lhs, rhs,
+                         is_max ? ComparisonDirection::kGt : ComparisonDirection::kLt)) {
+      return unsupported("integer value comparator");
+    }
+  } else if (value_predicate->opcode() != HloOpcode::kOr ||
+             value_predicate->operand_count() != 2 ||
+             !matches_compare(value_predicate->operand(0), lhs, rhs,
+                              is_max ? ComparisonDirection::kGt : ComparisonDirection::kLt) ||
+             !matches_compare(value_predicate->operand(1), lhs, lhs, ComparisonDirection::kNe)) {
+    return unsupported();
+  }
+  const auto* tie = index_predicate->operand(1);
+  if (tie->opcode() != HloOpcode::kAnd || tie->operand_count() != 2 ||
+      !matches_compare(tie->operand(0), lhs, rhs, ComparisonDirection::kEq) ||
+      !matches_compare(tie->operand(1), lhs_index, rhs_index, ComparisonDirection::kLt)) {
+    return unsupported();
+  }
+  TF_ASSIGN_OR_RETURN(auto input_slice, GetAllocationSliceForHlo(instr->operand(0)));
+  TF_ASSIGN_OR_RETURN(auto output_slice, GetAllocationSliceForHlo(instr, {1}));
+  AddThunkToThunkSequence(std::make_unique<NpuArgIndexThunk>(
+      NpuThunk::ThunkInfo::WithProfileAnnotation(instr, ir_emitter_context_->GetNextThunkId()),
+      input_slice, output_slice, axis, is_max));
+  return absl::OkStatus();
+}
