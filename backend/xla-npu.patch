+absl::Status LegalizeNativeDynamicRowSlice(HloModule* module) {
+  for (HloComputation* computation : module->MakeNonfusionComputations()) {
+    std::vector<HloInstruction*> slices;
+    for (HloInstruction* instruction : computation->instructions()) {
+      if (instruction->opcode() == HloOpcode::kDynamicSlice) slices.push_back(instruction);
+    }
+    for (HloInstruction* instruction : slices) {
+      const Shape& operand = instruction->operand(0)->shape();
+      const Shape& output = instruction->shape();
+      const int64_t rank = operand.dimensions_size();
+      if (rank < 1 || rank > 8 || output.dimensions(0) != 1 ||
+          instruction->operand_count() != rank + 1 ||
+          !LayoutUtil::IsMonotonicWithDim0Major(output.layout()) || output.layout().tiles_size() != 0) {
+        return absl::UnimplementedError("Native dynamic slice requires a single full row");
+      }
+      for (int64_t axis = 0; axis < rank; ++axis) {
+        const Shape& index = instruction->operand(axis + 1)->shape();
+        if (!ShapeUtil::IsScalar(index) || index.element_type() != S32 ||
+            (axis > 0 && output.dimensions(axis) != operand.dimensions(axis))) {
+          return absl::UnimplementedError("Native dynamic slice requires scalar S32 full-row starts");
+        }
+      }
+      HloInstruction* index = computation->AddInstruction(HloInstruction::CreateReshape(
+          ShapeUtil::MakeShape(S32, {1, 1}), instruction->mutable_operand(1)));
+      GatherDimensionNumbers dimensions;
+      dimensions.add_start_index_map(0);
+      dimensions.add_collapsed_slice_dims(0);
+      dimensions.set_index_vector_dim(1);
+      for (int64_t axis = 1; axis < rank; ++axis) dimensions.add_offset_dims(axis);
+      std::vector<int64_t> slice_sizes(output.dimensions().begin(), output.dimensions().end());
+      TF_RETURN_IF_ERROR(computation->ReplaceWithNewInstruction(instruction,
+          HloInstruction::CreateGather(output, instruction->mutable_operand(0), index,
+                                       dimensions, slice_sizes, false)));
+    }
+  }
+  return absl::OkStatus();
+}
+
+absl::Status NormalizeNativeBatchedRowWindowGather(HloModule* module) {
+  for (HloComputation* computation : module->MakeNonfusionComputations()) {
+    std::vector<HloInstruction*> gathers;
+    for (HloInstruction* instruction : computation->instructions()) {
+      if (instruction->opcode() == HloOpcode::kGather) gathers.push_back(instruction);
+    }
+    for (HloInstruction* instruction : gathers) {
+      const auto& dimensions = instruction->gather_dimension_numbers();
+      const Shape& operand = instruction->operand(0)->shape();
+      const Shape& indices = instruction->operand(1)->shape();
+      const Shape& output = instruction->shape();
+      if (operand.dimensions_size() != 3 || indices.dimensions_size() != 3 ||
+          output.dimensions_size() != 4 || operand.element_type() != F32 ||
+          indices.element_type() != S32 || output.element_type() != F32 ||
+          dimensions.operand_batching_dims_size() != 1 || dimensions.operand_batching_dims(0) != 0 ||
+          dimensions.start_indices_batching_dims_size() != 1 ||
+          dimensions.start_indices_batching_dims(0) != 0 || dimensions.index_vector_dim() != 2 ||
+          dimensions.start_index_map_size() != 2 || dimensions.start_index_map(0) != 1 ||
+          dimensions.start_index_map(1) != 2 || dimensions.collapsed_slice_dims_size() != 0 ||
+          dimensions.offset_dims_size() != 2 || dimensions.offset_dims(0) != 2 ||
+          dimensions.offset_dims(1) != 3 || instruction->gather_slice_sizes().size() != 3 ||
+          instruction->gather_slice_sizes()[0] != 1 || instruction->gather_slice_sizes()[1] != 1 ||
+          instruction->gather_slice_sizes()[2] != operand.dimensions(2) ||
+          indices.dimensions(0) != operand.dimensions(0) || indices.dimensions(2) != 2 ||
+          output.dimensions(0) != operand.dimensions(0) || output.dimensions(1) != indices.dimensions(1) ||
+          output.dimensions(2) != 1 || output.dimensions(3) != operand.dimensions(2) ||
+          operand.dimensions(0) > (1 << 24)) {
+        continue;
+      }
+      bool bounded_static = true;
+      for (const Shape* shape : {&operand, &indices, &output}) {
+        if (!shape->has_layout() || !LayoutUtil::IsDenseArray(*shape) ||
+            !LayoutUtil::IsMonotonicWithDim0Major(shape->layout()) || shape->layout().tiles_size() != 0) {
+          bounded_static = false;
+        }
+        for (int64_t axis = 0; axis < shape->dimensions_size(); ++axis) {
+          if (shape->is_dynamic_dimension(axis) || shape->dimensions(axis) <= 0) bounded_static = false;
+        }
+      }
+      if (!bounded_static) continue;
+      HloInstruction* rows = computation->AddInstruction(HloInstruction::CreateSlice(
+          ShapeUtil::MakeShape(S32, {indices.dimensions(0), indices.dimensions(1), 1}),
+          instruction->mutable_operand(1),
+          {0, 0, 0}, {indices.dimensions(0), indices.dimensions(1), 1}, {1, 1, 1}));
+      GatherDimensionNumbers normalized;
+      normalized.add_operand_batching_dims(0);
+      normalized.add_start_indices_batching_dims(0);
+      normalized.add_start_index_map(1);
+      normalized.add_collapsed_slice_dims(1);
+      normalized.add_offset_dims(2);
+      normalized.set_index_vector_dim(2);
+      HloInstruction* gathered = computation->AddInstruction(HloInstruction::CreateGather(
+          ShapeUtil::MakeShape(F32, {output.dimensions(0), output.dimensions(1), output.dimensions(3)}),
+          instruction->mutable_operand(0), rows, normalized, instruction->gather_slice_sizes(), false));
+      TF_RETURN_IF_ERROR(computation->ReplaceWithNewInstruction(instruction,
+          HloInstruction::CreateReshape(output, gathered)));
+    }
+  }
+  return absl::OkStatus();
+}
