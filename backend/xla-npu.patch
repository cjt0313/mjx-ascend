diff --git a/xla_npu/backend/runtime/npu_while_thunk.cc b/xla_npu/backend/runtime/npu_while_thunk.cc
new file mode 100644
index 0000000..fc6b4bb
--- /dev/null
+++ b/xla_npu/backend/runtime/npu_while_thunk.cc
@@ -0,0 +1,83 @@
+#include "xla/xla_npu/backend/runtime/npu_while_thunk.h"
+
+#include <cstdint>
+#include <utility>
+
+#include "xla/tsl/platform/statusor.h"
+
+namespace xla {
+
+NpuWhileThunk::NpuWhileThunk(
+    ThunkInfo info, BufferAllocation::Slice predicate,
+    std::unique_ptr<NpuSequentialThunk> condition,
+    std::unique_ptr<NpuSequentialThunk> body)
+    : NpuThunk(Kind::kWhile, std::move(info)), predicate_(predicate),
+      condition_(std::move(condition)), body_(std::move(body)) {}
+
+absl::Status NpuWhileThunk::Prepare(
+    const PrepareParams& params, ResourceRequestsInterface& requests) {
+  TF_RETURN_IF_ERROR(condition_->Prepare(params, requests));
+  return body_->Prepare(params, requests);
+}
+
+absl::Status NpuWhileThunk::Initialize(const InitializeParams& params) {
+  TF_RETURN_IF_ERROR(condition_->Initialize(params));
+  return body_->Initialize(params);
+}
+
+absl::Status NpuWhileThunk::ExecuteOnStream(const ExecuteParams& params) {
+  if (predicate_.size() != sizeof(uint8_t)) {
+    return absl::InvalidArgumentError("While predicate must be one byte");
+  }
+  auto predicate_buffer = params.buffer_allocations->GetDeviceAddress(predicate_);
+  while (true) {
+    TF_RETURN_IF_ERROR(condition_->ExecuteOnStream(params));
+    TF_RETURN_IF_ERROR(params.stream->BlockHostUntilDone());
+    uint8_t predicate = 0;
+    TF_RETURN_IF_ERROR(params.stream->Memcpy(&predicate, predicate_buffer, sizeof(predicate)));
+    if (predicate > 1) {
+      return absl::InternalError("While predicate has invalid PRED encoding");
+    }
+    if (predicate == 0) return absl::OkStatus();
+    TF_RETURN_IF_ERROR(body_->ExecuteOnStream(params));
+  }
+}
+
+NpuThunk::BufferUses NpuWhileThunk::buffer_uses() const {
+  BufferUses uses{BufferUse::Read(predicate_)};
+  for (const auto* sequence : {condition_.get(), body_.get()}) {
+    for (const auto& thunk : sequence->thunks()) {
+      auto nested = thunk->buffer_uses();
+      uses.insert(uses.end(), nested.begin(), nested.end());
+    }
+  }
+  return uses;
+}
+
+void NpuWhileThunk::ForAllThunks(
+    absl::FunctionRef<void(const NpuThunk*)> function) const {
+  function(this);
+  condition_->ForAllThunks(function);
+  body_->ForAllThunks(function);
+}
+
+void NpuWhileThunk::ForAllThunksMutable(
+    absl::FunctionRef<void(NpuThunk*)> function) {
+  function(this);
+  condition_->ForAllThunksMutable(function);
+  body_->ForAllThunksMutable(function);
+}
+
+absl::Status NpuWhileThunk::TransformAllNestedThunks(
+    absl::FunctionRef<absl::StatusOr<std::unique_ptr<NpuThunk>>(
+        std::unique_ptr<NpuThunk>)> function) {
+  for (auto* sequence : {&condition_, &body_}) {
+    std::unique_ptr<NpuThunk> nested = std::move(*sequence);
+    TF_RETURN_IF_ERROR(nested->TransformAllNestedThunks(function));
+    TF_ASSIGN_OR_RETURN(nested, function(std::move(nested)));
+    *sequence = NpuSequentialThunk::FromThunk(std::move(nested));
+  }
+  return absl::OkStatus();
+}
+
+}
