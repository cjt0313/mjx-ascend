+bool IsStaticDensePermutation(const Shape& shape) {
+  if (!shape.IsArray() || !shape.has_layout() ||
+      !LayoutUtil::IsDenseArray(shape) || shape.layout().tiles_size() != 0 ||
+      shape.layout().element_size_in_bits() != 0 ||
+      shape.layout().minor_to_major_size() != shape.dimensions_size()) {
+    return false;
+  }
+  std::vector<bool> seen(shape.dimensions_size(), false);
+  for (int64_t dimension = 0; dimension < shape.dimensions_size(); ++dimension) {
+    int64_t minor = shape.layout().minor_to_major(dimension);
+    if (shape.is_dynamic_dimension(dimension) ||
+        minor < 0 || minor >= shape.dimensions_size() || seen[minor]) {
+      return false;
+    }
+    seen[minor] = true;
+  }
+  return true;
+}
+
+aclTensor* CreateDenseTensor(const Shape& shape, aclDataType data_type,
+                             void* address) {
+  std::vector<int64_t> dimensions(shape.dimensions().begin(),
+                                  shape.dimensions().end());
+  std::vector<int64_t> strides(dimensions.size(), 1);
+  int64_t stride = 1;
+  for (int64_t dimension = 0; dimension < shape.dimensions_size(); ++dimension) {
+    int64_t minor = shape.layout().minor_to_major(dimension);
+    strides[minor] = stride;
+    stride *= dimensions[minor];
+  }
+  return dep::aclCreateTensor(dimensions.data(), dimensions.size(), data_type,
+                              strides.data(), 0, ACL_FORMAT_ND, dimensions.data(),
+                              dimensions.size(), address);
+}
