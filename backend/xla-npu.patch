+          (multiple_points && updates.is_dynamic_dimension(1))) continue;
+      const auto& literal = Cast<HloConstantInstruction>(instruction->operand(1))->literal();
+      Literal flat_indices(ShapeUtil::MakeShape(S32, {rows * points, 1}));
+      bool valid = true;
+      bool sorted = true;
+      bool unique = true;
+      int32_t previous = -1;
+      std::unordered_set<int32_t> destinations;
+      for (int64_t row = 0; row < rows; ++row) {
+        for (int64_t point = 0; point < points; ++point) {
+          const int64_t column = point_vectors ? literal.Get<int32_t>({row, point, 0}) :
+                                                literal.Get<int32_t>({row, point});
+          if (column < 0 || column >= columns) {
+            valid = false;
+            break;
+          }
+          const int32_t destination = static_cast<int32_t>(row * columns + column);
+          flat_indices.Set<int32_t>({row * points + point, 0}, destination);
+          sorted &= destination >= previous;
+          unique &= destinations.insert(destination).second;
+          previous = destination;
+        }
+        if (!valid) break;
+      }
+      if (!valid) continue;
+      auto* flattened = computation->AddInstruction(HloInstruction::CreateReshape(
+          ShapeUtil::MakeShape(input.element_type(), {rows * columns}), instruction->mutable_operand(0)));
+      auto* flattened_indices = computation->AddInstruction(HloInstruction::CreateConstant(std::move(flat_indices)));
+      ScatterDimensionNumbers normalized;
+      normalized.add_inserted_window_dims(0);
+      normalized.add_scatter_dims_to_operand_dims(0);
+      normalized.set_index_vector_dim(1);
+      auto* flat_updates = instruction->mutable_operand(2);
+      if (multiple_points) {
+        flat_updates = computation->AddInstruction(HloInstruction::CreateReshape(
+            ShapeUtil::MakeShape(updates.element_type(), {rows * points}), flat_updates));
+      }
+      auto* scattered = computation->AddInstruction(HloInstruction::CreateScatter(
+          flattened->shape(), flattened, flattened_indices, flat_updates,
+          scatter->to_apply(), normalized, sorted, unique));
+      auto* replacement = computation->AddInstruction(HloInstruction::CreateReshape(instruction->shape(), scattered));
+      instruction->SetupDerivedInstruction(replacement);
+      TF_ASSIGN_OR_RETURN(bool replaced,
+          computation->ReplaceInstruction(instruction, replacement, true, true));
+      if (!replaced) return absl::InternalError("Native row batched scatter replacement was rejected");
+    }
+  }
+  return absl::OkStatus();
+}
