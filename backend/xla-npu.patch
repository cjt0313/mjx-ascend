+absl::Status LegalizeNativePlaneWindowScatter(HloModule* module) {
+  for (auto* computation : module->computations()) {
+    for (auto* instruction : computation->MakeInstructionPostOrder()) {
+      if (instruction->opcode() != HloOpcode::kScatter || instruction->operand_count() != 3) continue;
+      const auto* scatter = Cast<HloScatterInstruction>(instruction);
+      const auto& dimensions = scatter->scatter_dimension_numbers();
+      const Shape& input = instruction->operand(0)->shape();
+      const Shape& update = instruction->operand(2)->shape();
+      const auto* indices = instruction->operand(1);
+      if (!input.IsArray() || !update.IsArray() || input.dimensions_size() != 3 || update.dimensions_size() != 2 ||
+          input.element_type() != F32 || update.element_type() != F32 || !ShapeUtil::Equal(input, instruction->shape()) ||
+          !input.has_layout() || !update.has_layout() || input.layout().tiles_size() != 0 || update.layout().tiles_size() != 0 ||
+          !LayoutUtil::IsMonotonicWithDim0Major(input.layout()) || !LayoutUtil::IsMonotonicWithDim0Major(update.layout()) ||
+          dimensions.update_window_dims_size() != 2 || dimensions.update_window_dims(0) != 0 ||
+          dimensions.update_window_dims(1) != 1 || dimensions.inserted_window_dims_size() != 1 ||
+          dimensions.scatter_dims_to_operand_dims_size() != 1 || dimensions.index_vector_dim() != 0 ||
+          dimensions.input_batching_dims_size() != 0 || dimensions.scatter_indices_batching_dims_size() != 0 ||
+          !scatter->unique_indices() || !scatter->indices_are_sorted() || indices->opcode() != HloOpcode::kConstant ||
+          indices->shape().dimensions_size() != 1 || indices->shape().dimensions(0) != 1 ||
+          indices->shape().element_type() != S32) continue;
+      const int64_t indexed_axis = dimensions.scatter_dims_to_operand_dims(0);
+      if (indexed_axis < 0 || indexed_axis >= 3 || dimensions.inserted_window_dims(0) != indexed_axis) continue;
+      const int32_t start = indices->literal().GetFirstElement<int32_t>();
+      if (start < 0 || start >= input.dimensions(indexed_axis)) continue;
+      std::vector<int64_t> window(input.dimensions().begin(), input.dimensions().end());
+      window[indexed_axis] = 1;
+      bool valid = true;
+      int64_t elements = 1;
+      int64_t update_axis = 0;
+      for (int64_t axis = 0; axis < 3; ++axis) {
+        if (input.dimensions(axis) <= 0 || input.dimensions(axis) > (1 << 24) / elements ||
+            input.is_dynamic_dimension(axis)) {
+          valid = false;
+          break;
+        }
+        elements *= input.dimensions(axis);
+        if (axis != indexed_axis) {
+          valid &= update.dimensions(update_axis) == input.dimensions(axis) && !update.is_dynamic_dimension(update_axis);
+          ++update_axis;
+        }
+      }
+      const auto* updater = scatter->to_apply();
+      if (!valid || updater->num_parameters() != 2 || updater->instruction_count() != 2 ||
+          updater->root_instruction()->opcode() != HloOpcode::kParameter ||
+          updater->root_instruction()->parameter_number() != 1) continue;
+      auto* reshaped = computation->AddInstruction(HloInstruction::CreateReshape(
+          ShapeUtil::MakeShape(F32, window), instruction->mutable_operand(2)));
+      std::vector<HloInstruction*> starts;
+      for (int64_t axis = 0; axis < 3; ++axis) {
+        starts.push_back(computation->AddInstruction(HloInstruction::CreateConstant(
+            LiteralUtil::CreateR0<int32_t>(axis == indexed_axis ? start : 0))));
+      }
+      auto* replacement = computation->AddInstruction(HloInstruction::CreateDynamicUpdateSlice(
+          input, instruction->mutable_operand(0), reshaped, starts));
+      instruction->SetupDerivedInstruction(replacement);
+      TF_ASSIGN_OR_RETURN(bool replaced, computation->ReplaceInstruction(instruction, replacement, true, true));
+      if (!replaced) return absl::InternalError("Native plane window replacement was rejected");
+    }
+  }
+  return absl::OkStatus();
+}
