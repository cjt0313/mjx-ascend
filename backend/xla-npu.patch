diff --git a/xla_npu/backend/runtime/npu_conditional_thunk.cc b/xla_npu/backend/runtime/npu_conditional_thunk.cc
new file mode 100644
index 0000000..0a24273
--- /dev/null
+++ b/xla_npu/backend/runtime/npu_conditional_thunk.cc
@@ -0,0 +1,125 @@
+#include "xla/xla_npu/backend/runtime/npu_conditional_thunk.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <utility>
+
+#include "xla/tsl/platform/statusor.h"
+
+namespace xla {
+
+NpuConditionalThunk::NpuConditionalThunk(
+    ThunkInfo info, BufferAllocation::Slice selector,
+    std::vector<std::unique_ptr<NpuSequentialThunk>> branches,
+    bool selector_is_pred)
+    : NpuThunk(Kind::kConditional, std::move(info)),
+      selector_(selector),
+      branches_(std::move(branches)),
+      selector_is_pred_(selector_is_pred) {}
+
+absl::Status NpuConditionalThunk::ValidateMetadata() const {
+  if (branches_.empty() || (selector_is_pred_ && branches_.size() != 2)) {
+    return absl::InvalidArgumentError(
+        "Conditional requires two branches for PRED or at least one for S32");
+  }
+  const int64_t selector_bytes =
+      selector_is_pred_ ? sizeof(uint8_t) : sizeof(int32_t);
+  if (selector_.size() != selector_bytes) {
+    return absl::InvalidArgumentError(
+        "Conditional selector must be one scalar PRED byte or S32 value");
+  }
+  for (const auto& branch : branches_) {
+    if (!branch) {
+      return absl::InvalidArgumentError("Conditional branch must not be null");
+    }
+  }
+  return absl::OkStatus();
+}
+
+absl::Status NpuConditionalThunk::Prepare(
+    const PrepareParams& params, ResourceRequestsInterface& requests) {
+  TF_RETURN_IF_ERROR(ValidateMetadata());
+  for (const auto& branch : branches_) {
+    TF_RETURN_IF_ERROR(branch->Prepare(params, requests));
+  }
+  return absl::OkStatus();
+}
+
+absl::Status NpuConditionalThunk::Initialize(const InitializeParams& params) {
+  TF_RETURN_IF_ERROR(ValidateMetadata());
+  for (const auto& branch : branches_) {
+    TF_RETURN_IF_ERROR(branch->Initialize(params));
+  }
+  return absl::OkStatus();
+}
+
+absl::Status NpuConditionalThunk::ExecuteOnStream(const ExecuteParams& params) {
+  TF_RETURN_IF_ERROR(ValidateMetadata());
+  auto selector_buffer = params.buffer_allocations->GetDeviceAddress(selector_);
+  TF_RETURN_IF_ERROR(params.stream->BlockHostUntilDone());
+  size_t branch_index = 0;
+  if (selector_is_pred_) {
+    uint8_t predicate = 0;
+    TF_RETURN_IF_ERROR(params.stream->Memcpy(&predicate, selector_buffer, sizeof(predicate)));
+    if (predicate > 1) {
+      return absl::InternalError("Conditional selector has invalid PRED encoding");
+    }
+    branch_index = predicate ? 0 : 1;
+  } else {
+    int32_t selector = 0;
+    TF_RETURN_IF_ERROR(params.stream->Memcpy(&selector, selector_buffer, sizeof(selector)));
+    if (selector < 0 || static_cast<size_t>(selector) >= branches_.size()) {
+      branch_index = branches_.size() - 1;
+    } else {
+      branch_index = static_cast<size_t>(selector);
+    }
+  }
+  return branches_[branch_index]->ExecuteOnStream(params);
+}
+
+NpuThunk::BufferUses NpuConditionalThunk::buffer_uses() const {
+  BufferUses uses{BufferUse::Read(selector_)};
+  for (const auto& branch : branches_) {
+    if (!branch) continue;
+    auto nested = branch->buffer_uses();
+    uses.insert(uses.end(), nested.begin(), nested.end());
+  }
+  return uses;
+}
+
+void NpuConditionalThunk::ForAllThunks(
+    absl::FunctionRef<void(const NpuThunk*)> function) const {
+  function(this);
+  for (const auto& branch : branches_) {
+    if (!branch) continue;
+    branch->ForAllThunks(function);
+  }
+}
+
+void NpuConditionalThunk::ForAllThunksMutable(
+    absl::FunctionRef<void(NpuThunk*)> function) {
+  function(this);
+  for (const auto& branch : branches_) {
+    if (!branch) continue;
+    branch->ForAllThunksMutable(function);
+  }
+}
+
+absl::Status NpuConditionalThunk::TransformAllNestedThunks(
+    absl::FunctionRef<absl::StatusOr<std::unique_ptr<NpuThunk>>(
+        std::unique_ptr<NpuThunk>)> function) {
+  TF_RETURN_IF_ERROR(ValidateMetadata());
+  for (auto& branch : branches_) {
+    TF_RETURN_IF_ERROR(branch->TransformAllNestedThunks(function));
+    TF_ASSIGN_OR_RETURN(std::unique_ptr<NpuThunk> transformed,
+                        function(std::move(branch)));
+    if (!transformed) {
+      return absl::InvalidArgumentError(
+          "Conditional branch transform must not return null");
+    }
+    branch = NpuSequentialThunk::FromThunk(std::move(transformed));
+  }
+  return absl::OkStatus();
+}
+
+}
