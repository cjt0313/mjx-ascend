+absl::Status NpuAclnnThunk::ExecuteTriangularSolve(const ExecuteParams& params) {
+  const auto& shapes = thunk_info().param_shapes;
+  if (params.stream == nullptr || params.buffer_allocations == nullptr) {
+    return absl::InvalidArgumentError("TriangularSolve requires a stream and buffer allocations");
+  }
+  if (args_.size() != 3 || shapes.size() != 3 || output_args_.size() != 3) {
+    return absl::InvalidArgumentError(absl::StrFormat(
+        "TriangularSolve requires three arguments and shapes (args=%d shapes=%d flags=%d)",
+        args_.size(), shapes.size(), output_args_.size()));
+  }
+  if (output_args_[0] || output_args_[1] || !output_args_[2]) {
+    return absl::InvalidArgumentError(absl::StrFormat(
+        "TriangularSolve requires read-only A/B and a distinct output (written flags: A=%d B=%d X=%d)",
+        static_cast<int>(output_args_[0]), static_cast<int>(output_args_[1]),
+        static_cast<int>(output_args_[2])));
+  }
+  if (!triangular_solve_metadata_) {
+    return absl::UnimplementedError("TriangularSolve requires typed HLO options");
+  }
+  const auto& metadata = *triangular_solve_metadata_;
+  if (!metadata.left_side ||
+      (metadata.transpose != TriangularSolveOptions::NO_TRANSPOSE &&
+       metadata.transpose != TriangularSolveOptions::TRANSPOSE)) {
+    return absl::UnimplementedError("TriangularSolve supports only left-side nonconjugate solves");
+  }
+  for (const auto& shape : shapes) {
+    if (!shape.IsArray() || shape.element_type() != F32 || shape.dimensions_size() != 2 ||
+        shape.dimensions(0) < 1 || shape.dimensions(0) > 64 ||
+        shape.dimensions(1) < 1 || shape.dimensions(1) > 64 ||
+        shape.is_dynamic_dimension(0) || shape.is_dynamic_dimension(1) ||
+        !shape.has_layout() || !LayoutUtil::IsDenseArray(shape) ||
+        shape.layout().tiles_size() != 0 || shape.layout().element_size_in_bits() != 0 ||
+        shape.layout().minor_to_major_size() != 2) {
+      return absl::UnimplementedError("TriangularSolve requires static dense rank2 f32 extents 1..64");
+    }
+    const int64_t order = shape.layout().minor_to_major(0);
+    if (!(order == 0 || order == 1) || shape.layout().minor_to_major(1) != 1 - order) {
+      return absl::UnimplementedError("TriangularSolve requires a valid dense layout permutation");
+    }
+  }
+  if (shapes[0].dimensions(0) != shapes[0].dimensions(1) ||
+      shapes[1].dimensions(0) != shapes[0].dimensions(0) ||
+      !ShapeUtil::Compatible(shapes[1], shapes[2])) {
+    return absl::UnimplementedError("TriangularSolve requires A[n,n], B[n,k], X[n,k]");
+  }
+  std::vector<void*> addresses;
+  std::vector<int64_t> bytes;
+  for (size_t argument = 0; argument < args_.size(); ++argument) {
+    addresses.push_back(params.buffer_allocations->GetDeviceAddress(args_[argument]).opaque());
+    bytes.push_back(ShapeUtil::ByteSizeOf(shapes[argument]));
+    if (addresses.back() == nullptr || args_[argument].size() < bytes[argument]) {
+      return absl::InvalidArgumentError("TriangularSolve buffer is null or too small");
+    }
+  }
+  const auto output_address = reinterpret_cast<uintptr_t>(addresses[2]);
+  for (size_t argument = 0; argument < 2; ++argument) {
+    const auto input_address = reinterpret_cast<uintptr_t>(addresses[argument]);
+    const bool overlaps = input_address <= output_address
+        ? output_address - input_address < static_cast<uintptr_t>(bytes[argument])
+        : input_address - output_address < static_cast<uintptr_t>(bytes[2]);
+    if (overlaps) {
+      return absl::UnimplementedError("TriangularSolve output must not overlap either input");
+    }
+  }
+  auto stream = static_cast<aclrtStream>(params.stream->platform_specific_handle().stream);
+  if (stream == nullptr) {
+    return absl::InvalidArgumentError("TriangularSolve requires a native stream");
+  }
+  auto destroy_tensor = [](aclTensor* tensor) { dep::aclDestroyTensor(tensor); };
+  using TensorOwner = std::unique_ptr<aclTensor, decltype(destroy_tensor)>;
+  struct Resources {
+    aclrtStream stream;
+    std::vector<TensorOwner> tensors;
+    std::vector<void*> allocations;
+    bool pending = false;
+    ~Resources() {
+      if (pending && dep::aclrtSynchronizeStream(stream) != ACL_SUCCESS) {
+        for (auto& tensor : tensors) tensor.release();
+        NPU_LOG_PRINT(ERROR, "TriangularSolve cleanup synchronization failed; retaining device resources");
+        return;
+      }
+      tensors.clear();
+      for (void* allocation : allocations) dep::aclrtFree(allocation);
+    }
+  } resources{stream, {}, {}, false};
+  auto allocate = [&resources](uint64_t size) -> absl::StatusOr<void*> {
+    void* address = nullptr;
+    const auto status = dep::aclrtMalloc(&address, size, ACL_MEM_MALLOC_HUGE_FIRST);
+    if (address != nullptr) resources.allocations.push_back(address);
+    if (status != ACL_SUCCESS || address == nullptr) {
+      return absl::InternalError(absl::StrFormat("TriangularSolve device allocation failed: %d", status));
+    }
+    return address;
+  };
+  TF_ASSIGN_OR_RETURN(void* matrix_scratch, allocate(bytes[0]));
+  addresses.push_back(matrix_scratch);
+  auto& tensors = resources.tensors;
+  for (size_t argument = 0; argument < addresses.size(); ++argument) {
+    const Shape& shape = shapes[argument == 3 ? 0 : argument];
+    int64_t dimensions[] = {shape.dimensions(0), shape.dimensions(1)};
+    int64_t strides[] = {dimensions[1], 1};
+    if (shape.layout().minor_to_major(0) == 0) {
+      strides[0] = 1;
+      strides[1] = dimensions[0];
+    }
+    tensors.emplace_back(dep::aclCreateTensor(
+        dimensions, 2, ACL_FLOAT, strides, 0, ACL_FORMAT_ND,
+        dimensions, 2, addresses[argument]), destroy_tensor);
+    if (tensors.back() == nullptr) {
+      return absl::InternalError("TriangularSolve tensor descriptor creation failed");
+    }
+  }
+  uint64_t workspace_size = 0;
+  aclOpExecutor* executor = nullptr;
+  const auto query_status = dep::aclnnTriangularSolveGetWorkspaceSize(
+      tensors[1].get(), tensors[0].get(), !metadata.lower,
+      metadata.transpose == TriangularSolveOptions::TRANSPOSE,
+      metadata.unit_diagonal, tensors[2].get(), tensors[3].get(),
+      &workspace_size, &executor);
+  if (query_status != ACL_SUCCESS || executor == nullptr) {
+    return absl::InternalError(absl::StrFormat("TriangularSolve ACLNN query failed: %d", query_status));
+  }
+  if (workspace_size > kWorkspaceMemoryPerStream) {
+    return absl::UnimplementedError("TriangularSolve workspace exceeds bounded device scope");
+  }
+  void* workspace = nullptr;
+  if (workspace_size != 0) {
+    TF_ASSIGN_OR_RETURN(workspace, allocate(workspace_size));
+  }
+  resources.pending = true;
+  const auto execute_status = dep::aclnnTriangularSolve(workspace, workspace_size, executor, stream);
+  const auto synchronize_status = dep::aclrtSynchronizeStream(stream);
+  if (synchronize_status == ACL_SUCCESS) resources.pending = false;
+  if (execute_status != ACL_SUCCESS) {
+    return absl::InternalError(absl::StrFormat("TriangularSolve ACLNN execution failed: %d", execute_status));
+  }
+  if (synchronize_status != ACL_SUCCESS) {
+    return absl::InternalError(absl::StrFormat("TriangularSolve stream synchronization failed: %d", synchronize_status));
+  }
+  return absl::OkStatus();
+}
