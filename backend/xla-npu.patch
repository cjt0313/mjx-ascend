+absl::Status LegalizeNativePointWindowGather(HloModule* module) {
+  for (HloComputation* computation : module->MakeNonfusionComputations()) {
+    std::vector<HloInstruction*> gathers;
+    for (HloInstruction* instruction : computation->instructions()) {
+      if (instruction->opcode() == HloOpcode::kGather &&
+          instruction->gather_dimension_numbers().collapsed_slice_dims_size() == 0 &&
+          instruction->operand(0)->shape().dimensions_size() == 2 &&
+          instruction->gather_slice_sizes()[0] == 1 && instruction->gather_slice_sizes()[1] == 1 &&
+          instruction->gather_dimension_numbers().start_index_map_size() == 2) {
+        gathers.push_back(instruction);
+      }
+    }
+    for (HloInstruction* instruction : gathers) {
+      const auto& dimensions = instruction->gather_dimension_numbers();
+      const Shape& indices = instruction->operand(1)->shape();
+      if (indices.dimensions_size() != 2 || indices.dimensions(1) != 2 ||
+          indices.element_type() != S32 || dimensions.index_vector_dim() != 1 ||
+          dimensions.start_index_map(0) != 0 || dimensions.start_index_map(1) != 1 ||
+          dimensions.operand_batching_dims_size() != 0 || dimensions.start_indices_batching_dims_size() != 0 ||
+          dimensions.offset_dims_size() != 2 || dimensions.offset_dims(0) != 1 || dimensions.offset_dims(1) != 2 ||
+          !LayoutUtil::IsMonotonicWithDim0Major(instruction->shape().layout()) ||
+          instruction->shape().layout().tiles_size() != 0) {
+        return absl::UnimplementedError("Native point windows require ordered two-axis singleton slices");
+      }
+      GatherDimensionNumbers normalized;
+      normalized.add_start_index_map(0);
+      normalized.add_start_index_map(1);
+      normalized.add_collapsed_slice_dims(0);
+      normalized.add_collapsed_slice_dims(1);
+      normalized.set_index_vector_dim(1);
+      HloInstruction* gathered = computation->AddInstruction(HloInstruction::CreateGather(
+          ShapeUtil::MakeShape(instruction->shape().element_type(), {indices.dimensions(0)}),
+          instruction->mutable_operand(0), instruction->mutable_operand(1), normalized,
+          instruction->gather_slice_sizes(), false));
+      TF_RETURN_IF_ERROR(computation->ReplaceWithNewInstruction(instruction,
+          HloInstruction::CreateReshape(instruction->shape(), gathered)));
+    }
+  }
+  return absl::OkStatus();
+}
