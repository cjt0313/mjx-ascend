+absl::Status LegalizeNativeMiddleTupleGather(HloModule* module) {
+  for (HloComputation* computation : module->MakeNonfusionComputations()) {
+    std::vector<HloInstruction*> gathers;
+    for (HloInstruction* instruction : computation->instructions()) {
+      if (instruction->opcode() == HloOpcode::kGather &&
+          instruction->gather_dimension_numbers().collapsed_slice_dims_size() > 1 &&
+          instruction->gather_dimension_numbers().collapsed_slice_dims(0) == 1) {
+        gathers.push_back(instruction);
+      }
+    }
+    for (HloInstruction* instruction : gathers) {
+      const auto& dimensions = instruction->gather_dimension_numbers();
+      const Shape& operand = instruction->operand(0)->shape();
+      const Shape& indices = instruction->operand(1)->shape();
+      const int64_t prefix_rank = dimensions.collapsed_slice_dims_size();
+      const int64_t operand_rank = operand.dimensions_size();
+      const int64_t index_rank = indices.dimensions_size();
+      const int64_t batch_rank = index_rank - 1;
+      if (operand_rank > 8 || operand_rank <= prefix_rank || index_rank < 1 || index_rank > 8 ||
+          dimensions.index_vector_dim() != index_rank - 1 || indices.element_type() != S32 ||
+          indices.dimensions(index_rank - 1) != prefix_rank ||
+          dimensions.start_index_map_size() != prefix_rank ||
+          dimensions.operand_batching_dims_size() != 0 || dimensions.start_indices_batching_dims_size() != 0 ||
+          dimensions.offset_dims_size() != operand_rank - prefix_rank) {
+        return absl::UnimplementedError("Native middle tuple gather requires explicit full slices");
+      }
+      std::vector<int64_t> permutation;
+      for (int64_t axis = 0; axis < prefix_rank; ++axis) {
+        if (dimensions.collapsed_slice_dims(axis) != axis + 1 ||
+            dimensions.start_index_map(axis) != axis + 1 || instruction->gather_slice_sizes()[axis + 1] != 1) {
+          return absl::UnimplementedError("Native middle tuple gather requires ordered contiguous indexed axes");
+        }
+        permutation.push_back(axis + 1);
+      }
+      permutation.push_back(0);
+      for (int64_t axis = prefix_rank + 1; axis < operand_rank; ++axis) permutation.push_back(axis);
+      std::vector<int64_t> permuted_dimensions;
+      for (int64_t axis : permutation) permuted_dimensions.push_back(operand.dimensions(axis));
+      HloInstruction* transposed = computation->AddInstruction(HloInstruction::CreateTranspose(
+          ShapeUtil::MakeShape(operand.element_type(), permuted_dimensions), instruction->mutable_operand(0),
+          permutation));
+      GatherDimensionNumbers normalized;
+      normalized.set_index_vector_dim(index_rank - 1);
+      std::vector<int64_t> slice_sizes(prefix_rank, 1);
+      std::vector<int64_t> output_dimensions(indices.dimensions().begin(), indices.dimensions().end() - 1);
+      for (int64_t axis = 0; axis < prefix_rank; ++axis) {
+        normalized.add_collapsed_slice_dims(axis);
+        normalized.add_start_index_map(axis);
+      }
+      for (int64_t axis = prefix_rank; axis < operand_rank; ++axis) {
+        if (instruction->gather_slice_sizes()[permutation[axis]] != permuted_dimensions[axis]) {
+          return absl::UnimplementedError("Native middle tuple gather requires full nonindexed slices");
+        }
+        normalized.add_offset_dims(batch_rank + axis - prefix_rank);
+        slice_sizes.push_back(permuted_dimensions[axis]);
+        output_dimensions.push_back(permuted_dimensions[axis]);
+      }
+      HloInstruction* gathered = computation->AddInstruction(HloInstruction::CreateGather(
+          ShapeUtil::MakeShape(operand.element_type(), output_dimensions), transposed,
+          instruction->mutable_operand(1), normalized, slice_sizes, false));
+      std::vector<int64_t> output_permutation(output_dimensions.size(), -1);
+      for (int64_t offset = 0; offset < dimensions.offset_dims_size(); ++offset) {
+        output_permutation[dimensions.offset_dims(offset)] = batch_rank + offset;
+      }
+      int64_t batch_axis = 0;
+      for (int64_t& axis : output_permutation) {
+        if (axis == -1) axis = batch_axis++;
+      }
+      TF_RETURN_IF_ERROR(computation->ReplaceWithNewInstruction(instruction,
+          HloInstruction::CreateTranspose(instruction->shape(), gathered, output_permutation)));
+    }
+  }
+  return absl::OkStatus();
+}
