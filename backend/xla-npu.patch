+    for (auto* instruction : computation->MakeInstructionPostOrder()) {
+      if (instruction->opcode() != HloOpcode::kScatter ||
+          instruction->operand_count() != 3 || !instruction->shape().IsArray()) continue;
+      const auto* scatter = Cast<HloScatterInstruction>(instruction);
+      const auto& dimensions = scatter->scatter_dimension_numbers();
+      const Shape& input = instruction->operand(0)->shape();
+      const Shape& update = instruction->operand(2)->shape();
+      const auto* indices = instruction->operand(1);
+      if (!input.IsArray() || !update.IsArray() || input.dimensions_size() < 1 ||
+          input.dimensions_size() > 8 || update.dimensions_size() != input.dimensions_size() ||
+          input.element_type() != update.element_type() ||
+          !ShapeUtil::Equal(input, instruction->shape()) ||
+          dimensions.update_window_dims_size() != input.dimensions_size() ||
+          dimensions.inserted_window_dims_size() != 0 ||
+          dimensions.input_batching_dims_size() != 0 ||
+          dimensions.scatter_indices_batching_dims_size() != 0 ||
+          dimensions.scatter_dims_to_operand_dims_size() != 1 ||
+          dimensions.scatter_dims_to_operand_dims(0) != 0 ||
+          dimensions.index_vector_dim() != 0 ||
+          !scatter->unique_indices() || !scatter->indices_are_sorted() ||
+          indices->opcode() != HloOpcode::kConstant || !indices->shape().IsArray() ||
+          indices->shape().dimensions_size() != 1 || indices->shape().dimensions(0) != 1 ||
+          indices->shape().element_type() != S32) continue;
+      const int32_t start = indices->literal().GetFirstElement<int32_t>();
+      bool supported = update.dimensions(0) <= input.dimensions(0);
+      for (int64_t dimension = 0; dimension < input.dimensions_size(); ++dimension) {
+        if (input.is_dynamic_dimension(dimension) || update.is_dynamic_dimension(dimension) ||
+            dimensions.update_window_dims(dimension) != dimension ||
+            (dimension > 0 && update.dimensions(dimension) != input.dimensions(dimension))) {
+          supported = false;
+        }
+      }
+      if (!supported || update.dimensions(0) > input.dimensions(0)) continue;
+      if (start < 0 || start > input.dimensions(0) - update.dimensions(0)) continue;
+      const auto* update_computation = scatter->to_apply();
+      if (update_computation->num_parameters() != 2 || update_computation->instruction_count() != 2 ||
+          !ShapeUtil::IsScalar(update_computation->parameter_instruction(0)->shape()) ||
+          !ShapeUtil::IsScalar(update_computation->parameter_instruction(1)->shape()) ||
+          update_computation->parameter_instruction(0)->shape().element_type() != input.element_type() ||
+          update_computation->parameter_instruction(1)->shape().element_type() != input.element_type() ||
+          update_computation->root_instruction()->opcode() != HloOpcode::kParameter ||
+          update_computation->root_instruction()->parameter_number() != 1) continue;
+      std::vector<HloInstruction*> starts;
+      for (int64_t dimension = 0; dimension < input.dimensions_size(); ++dimension) {
+        starts.push_back(computation->AddInstruction(
+            HloInstruction::CreateConstant(LiteralUtil::CreateR0<int32_t>(dimension == 0 ? start : 0))));
+      }
+      auto* replacement = computation->AddInstruction(HloInstruction::CreateDynamicUpdateSlice(
+          instruction->shape(), instruction->mutable_operand(0), instruction->mutable_operand(2), starts));
+      instruction->SetupDerivedInstruction(replacement);
+      TF_ASSIGN_OR_RETURN(bool replaced,
+          computation->ReplaceInstruction(instruction, replacement, true, true));
+      if (!replaced) return absl::InternalError("Native prefix scatter replacement was rejected");
+    }
+  }
+  return absl::OkStatus();
+}
+absl::Status LegalizeNativeRowScatterLayout(HloModule* module) {
+  auto bounded_matrix = [](const Shape& shape) {
+    if (!shape.IsArray() || shape.element_type() != F32 || shape.dimensions_size() != 2 ||
+        !shape.has_layout() || !LayoutUtil::IsDenseArray(shape) || shape.layout().tiles_size() != 0) {
+      return false;
+    }
+    int64_t elements = 1;
+    for (int64_t axis = 0; axis < 2; ++axis) {
+      const int64_t extent = shape.dimensions(axis);
+      if (shape.is_dynamic_dimension(axis) || extent <= 0 || elements > (1 << 24) / extent) {
+        return false;
+      }
+      elements *= extent;
+    }
+    return LayoutUtil::IsMonotonicWithDim0Major(shape.layout()) ||
+           (shape.layout().minor_to_major(0) == 0 && shape.layout().minor_to_major(1) == 1);
+  };
+  for (HloComputation* computation : module->MakeNonfusionComputations()) {
+    for (HloInstruction* instruction : computation->MakeInstructionPostOrder()) {
+      if (instruction->opcode() != HloOpcode::kScatter || instruction->operand_count() != 3) continue;
+      const auto* scatter = Cast<HloScatterInstruction>(instruction);
+      const Shape& input = instruction->operand(0)->shape();
+      const Shape& indices = instruction->operand(1)->shape();
+      const Shape& updates = instruction->operand(2)->shape();
+      const Shape& output = instruction->shape();
+      const auto& dimensions = scatter->scatter_dimension_numbers();
+      if (!bounded_matrix(input) || !bounded_matrix(updates) || !bounded_matrix(output) ||
+          !ShapeUtil::Compatible(input, output) || !indices.IsArray() ||
+          indices.dimensions_size() != 2 || indices.dimensions(1) != 1 ||
+          (indices.element_type() != S32 && indices.element_type() != S64) ||
+          !indices.has_layout() || !LayoutUtil::IsDenseArray(indices) ||
+          !LayoutUtil::IsMonotonicWithDim0Major(indices.layout()) || indices.layout().tiles_size() != 0 ||
+          updates.dimensions(0) != indices.dimensions(0) || updates.dimensions(1) != input.dimensions(1) ||
+          dimensions.update_window_dims_size() != 1 || dimensions.update_window_dims(0) != 1 ||
+          dimensions.inserted_window_dims_size() != 1 || dimensions.inserted_window_dims(0) != 0 ||
+          dimensions.scatter_dims_to_operand_dims_size() != 1 || dimensions.scatter_dims_to_operand_dims(0) != 0 ||
+          dimensions.index_vector_dim() != 1 || dimensions.input_batching_dims_size() != 0 ||
+          dimensions.scatter_indices_batching_dims_size() != 0) continue;
+      bool static_indices = true;
+      for (int64_t axis = 0; axis < 2; ++axis) {
+        if (indices.is_dynamic_dimension(axis) || indices.dimensions(axis) <= 0 ||
+            indices.dimensions(axis) > (1 << 24)) static_indices = false;
+      }
+      if (!static_indices ||
+          (LayoutUtil::IsMonotonicWithDim0Major(input.layout()) &&
+           LayoutUtil::IsMonotonicWithDim0Major(updates.layout()) &&
+           LayoutUtil::IsMonotonicWithDim0Major(output.layout()))) continue;
+      auto materialize = [&](HloInstruction* value) {
+        const Shape& shape = value->shape();
+        if (LayoutUtil::IsMonotonicWithDim0Major(shape.layout())) return value;
+        const Shape physical_shape = ShapeUtil::MakeShapeWithDenseLayout(
+            F32, {shape.dimensions(1), shape.dimensions(0)}, {1, 0});
+        const Shape row_shape = ShapeUtil::MakeShapeWithDenseLayout(
+            F32, {shape.dimensions(0), shape.dimensions(1)}, {1, 0});
+        HloInstruction* physical = computation->AddInstruction(
+            HloInstruction::CreateBitcast(physical_shape, value));
+        return computation->AddInstruction(
+            HloInstruction::CreateTranspose(row_shape, physical, {1, 0}));
+      };
+      const Shape row_shape = ShapeUtil::MakeShapeWithDenseLayout(
+          F32, {input.dimensions(0), input.dimensions(1)}, {1, 0});
+      HloInstruction* normalized = computation->AddInstruction(HloInstruction::CreateScatter(
+          row_shape, materialize(instruction->mutable_operand(0)), instruction->mutable_operand(1),
+          materialize(instruction->mutable_operand(2)), scatter->to_apply(), dimensions,
+          scatter->indices_are_sorted(), scatter->unique_indices()));
+      HloInstruction* replacement = normalized;
+      if (!LayoutUtil::IsMonotonicWithDim0Major(output.layout())) {
+        const Shape physical_shape = ShapeUtil::MakeShapeWithDenseLayout(
+            F32, {output.dimensions(1), output.dimensions(0)}, {1, 0});
+        HloInstruction* physical = computation->AddInstruction(
+            HloInstruction::CreateTranspose(physical_shape, normalized, {1, 0}));
+        replacement = computation->AddInstruction(HloInstruction::CreateBitcast(output, physical));
+      }
+      instruction->SetupDerivedInstruction(replacement);
+      TF_ASSIGN_OR_RETURN(bool replaced,
+          computation->ReplaceInstruction(instruction, replacement, true, true));
+      if (!replaced) return absl::InternalError("Native row scatter layout replacement was rejected");
+    }
+  }
+  return absl::OkStatus();
+}
+absl::Status LegalizeNativeSmallDestinationScatterAdd(HloModule* module) {
+  HloComputation* any_reducer = nullptr;
+  for (HloComputation* computation : module->MakeNonfusionComputations()) {
+    for (HloInstruction* instruction : computation->MakeInstructionPostOrder()) {
+      if (instruction->opcode() != HloOpcode::kScatter || instruction->operand_count() != 3 ||
+          instruction->operand(1)->opcode() == HloOpcode::kConstant) continue;
+      const auto* scatter = Cast<HloScatterInstruction>(instruction);
+      const Shape& input = instruction->operand(0)->shape();
+      const Shape& indices = instruction->operand(1)->shape();
+      const Shape& updates = instruction->operand(2)->shape();
+      const auto& dimensions = scatter->scatter_dimension_numbers();
+      if (!input.IsArray() || input.element_type() != F32 || input.dimensions_size() != 2 ||
+          !ShapeUtil::Equal(input, instruction->shape()) || !indices.IsArray() ||
+          indices.element_type() != S32 || indices.dimensions_size() != 2 || indices.dimensions(1) != 1 ||
+          !updates.IsArray() || updates.element_type() != F32 || updates.dimensions_size() != 2 ||
+          dimensions.update_window_dims_size() != 1 || dimensions.update_window_dims(0) != 1 ||
+          dimensions.inserted_window_dims_size() != 1 || dimensions.inserted_window_dims(0) != 0 ||
+          dimensions.scatter_dims_to_operand_dims_size() != 1 || dimensions.scatter_dims_to_operand_dims(0) != 0 ||
+          dimensions.index_vector_dim() != 1 || dimensions.input_batching_dims_size() != 0 ||
+          dimensions.scatter_indices_batching_dims_size() != 0) continue;
+      const int64_t rows = input.dimensions(0);
+      const int64_t width = input.dimensions(1);
+      const int64_t count = indices.dimensions(0);
+      if (rows < 1 || rows > 64 || width < 1 || width > 8 || count <= 256 || count > (1 << 20) ||
+          rows > (1 << 24) / width || count > (1 << 24) / width ||
+          updates.dimensions(0) != count || updates.dimensions(1) != width) continue;
+      bool dense_static_rows = true;
+      for (const Shape* shape : {&input, &indices, &updates, &instruction->shape()}) {
+        if (!shape->has_layout() || !LayoutUtil::IsDenseArray(*shape) ||
+            !LayoutUtil::IsMonotonicWithDim0Major(shape->layout()) || shape->layout().tiles_size() != 0) {
+          dense_static_rows = false;
+        }
+        for (int64_t axis = 0; axis < shape->dimensions_size(); ++axis) {
+          if (shape->is_dynamic_dimension(axis)) dense_static_rows = false;
+        }
+      }
+      HloComputation* reducer = scatter->to_apply();
+      const HloInstruction* root = reducer->root_instruction();
+      if (!dense_static_rows || reducer->num_parameters() != 2 || reducer->instruction_count() != 3 ||
+          root->opcode() != HloOpcode::kAdd || root->operand_count() != 2 ||
+          !ShapeUtil::IsScalar(root->shape()) || root->shape().element_type() != F32) continue;
+      const HloInstruction* first = reducer->parameter_instruction(0);
+      const HloInstruction* second = reducer->parameter_instruction(1);
+      if (!ShapeUtil::IsScalar(first->shape()) || !ShapeUtil::IsScalar(second->shape()) ||
+          first->shape().element_type() != F32 || second->shape().element_type() != F32 ||
+          !((root->operand(0) == first && root->operand(1) == second) ||
+            (root->operand(0) == second && root->operand(1) == first))) continue;
+      const Shape predicate_scalar = ShapeUtil::MakeShape(PRED, {});
+      if (any_reducer == nullptr) {
+        HloComputation::Builder builder("native-small-destination-scatter-any");
+        HloInstruction* lhs = builder.AddInstruction(
+            HloInstruction::CreateParameter(0, predicate_scalar, "lhs"));
+        HloInstruction* rhs = builder.AddInstruction(
+            HloInstruction::CreateParameter(1, predicate_scalar, "rhs"));
+        HloInstruction* logical_or = builder.AddInstruction(
+            HloInstruction::CreateBinary(predicate_scalar, HloOpcode::kOr, lhs, rhs));
+        any_reducer = module->AddEmbeddedComputation(builder.Build(logical_or));
+      }
+      HloInstruction* zero = computation->AddInstruction(
+          HloInstruction::CreateConstant(LiteralUtil::CreateR0<float>(0.0f)));
+      HloInstruction* false_value = computation->AddInstruction(
+          HloInstruction::CreateConstant(LiteralUtil::CreateR0<bool>(false)));
+      HloInstruction* zero_updates = computation->AddInstruction(
+          HloInstruction::CreateBroadcast(updates, zero, {}));
+      const Shape index_shape = ShapeUtil::MakeShape(S32, {count});
+      const Shape matches_shape = ShapeUtil::MakeShape(PRED, {count});
+      const Shape mask_shape = ShapeUtil::MakeShape(PRED, {count, width});
+      const Shape sum_shape = ShapeUtil::MakeShape(F32, {width});
+      const Shape row_shape = ShapeUtil::MakeShape(F32, {1, width});
+      const Shape row_predicate_shape = ShapeUtil::MakeShape(PRED, {1, width});
+      HloInstruction* runtime_indices = computation->AddInstruction(
+          HloInstruction::CreateReshape(index_shape, instruction->mutable_operand(1)));
+      std::vector<HloInstruction*> output_rows;
+      output_rows.reserve(rows);
+      for (int64_t destination = 0; destination < rows; ++destination) {
+        HloInstruction* destination_scalar = computation->AddInstruction(HloInstruction::CreateConstant(
+            LiteralUtil::CreateR0<int32_t>(static_cast<int32_t>(destination))));
+        HloInstruction* destination_indices = computation->AddInstruction(
+            HloInstruction::CreateBroadcast(index_shape, destination_scalar, {}));
+        HloInstruction* matches = computation->AddInstruction(HloInstruction::CreateCompare(
+            matches_shape, runtime_indices, destination_indices, ComparisonDirection::kEq));
+        HloInstruction* mask = computation->AddInstruction(
+            HloInstruction::CreateBroadcast(mask_shape, matches, {0}));
+        HloInstruction* masked = computation->AddInstruction(HloInstruction::CreateTernary(
+            updates, HloOpcode::kSelect, mask, instruction->mutable_operand(2), zero_updates));
+        HloInstruction* sum = computation->AddInstruction(HloInstruction::CreateReduce(
+            sum_shape, masked, zero, {0}, scatter->to_apply()));
+        HloInstruction* update_row = computation->AddInstruction(
+            HloInstruction::CreateReshape(row_shape, sum));
+        HloInstruction* original_row = computation->AddInstruction(HloInstruction::CreateSlice(
+            row_shape, instruction->mutable_operand(0), {destination, 0}, {destination + 1, width}, {1, 1}));
+        HloInstruction* added_row = computation->AddInstruction(HloInstruction::CreateBinary(
+            row_shape, HloOpcode::kAdd, original_row, update_row));
+        HloInstruction* has_match = computation->AddInstruction(HloInstruction::CreateReduce(
+            predicate_scalar, matches, false_value, {0}, any_reducer));
+        HloInstruction* row_has_match = computation->AddInstruction(
+            HloInstruction::CreateBroadcast(row_predicate_shape, has_match, {}));
+        output_rows.push_back(computation->AddInstruction(HloInstruction::CreateTernary(
+            row_shape, HloOpcode::kSelect, row_has_match, added_row, original_row)));
+      }
+      HloInstruction* replacement = computation->AddInstruction(
+          HloInstruction::CreateConcatenate(instruction->shape(), output_rows, 0));
+      instruction->SetupDerivedInstruction(replacement);
+      TF_ASSIGN_OR_RETURN(bool replaced,
+          computation->ReplaceInstruction(instruction, replacement, true, true));
+      if (!replaced) return absl::InternalError("Native small-destination scatter-add replacement was rejected");
+    }
+  }
+  return absl::OkStatus();
+}
+class NpuNativeLayoutAssignment : public LayoutAssignment {
+ public:
+  explicit NpuNativeLayoutAssignment(HloModule* module)
+      : LayoutAssignment(module->mutable_entry_computation_layout()) {
+    for (HloComputation* computation : module->MakeNonfusionComputations()) {
+      for (HloInstruction* instruction : computation->instructions()) {
+        if (!instruction->shape().IsArray() || !instruction->shape().has_layout()) continue;
+        switch (instruction->opcode()) {
+          case HloOpcode::kParameter:
+          case HloOpcode::kGetTupleElement:
+          case HloOpcode::kWhile:
+          case HloOpcode::kConditional:
+          case HloOpcode::kBitcast:
+            break;
+          default:
+            original_shapes_.emplace(instruction, instruction->shape());
+            std::vector<Shape> operands;
+            for (const HloInstruction* operand : instruction->operands()) {
+              operands.push_back(operand->shape());
+            }
+            original_operands_.emplace(instruction, std::move(operands));
+        }
+      }
+    }
+  }
+
+ protected:
+  absl::Status AddBackendConstraints(LayoutConstraints* constraints) override {
+    for (HloInstruction* instruction : constraints->computation()->instructions()) {
+      auto original = original_shapes_.find(instruction);
+      if (original != original_shapes_.end()) {
+        TF_RETURN_IF_ERROR(SetInstructionLayout(original->second, instruction));
+        const auto& operands = original_operands_.at(instruction);
+        for (int64_t operand = 0; operand < operands.size(); ++operand) {
+          TF_RETURN_IF_ERROR(SetOperandLayout(operands[operand], instruction, operand));
+        }
+      }
+    }
+    return absl::OkStatus();
+  }
+
+ private:
+  absl::flat_hash_map<const HloInstruction*, Shape> original_shapes_;
+  absl::flat_hash_map<const HloInstruction*, std::vector<Shape>> original_operands_;
+};
