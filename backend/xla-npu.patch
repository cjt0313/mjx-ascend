+      if (scatter_metadata_->index_rows != 1) {
+        return absl::UnimplementedError("dynamic dropped replacement requires one index row");
+      }
+      std::vector<int64_t> output_dimensions(shapes[0].dimensions().begin(), shapes[0].dimensions().end());
+      TF_ASSIGN_OR_RETURN(scatter_output, allocate_tensor(output_dimensions, shapes[0].element_type()));
+      se::DeviceMemoryBase candidate(scratch.addresses.back(), bytes);
+      TF_RETURN_IF_ERROR(params.stream->Memcpy(&candidate, input, bytes));
+    }
+  }
+  aclnnStatus status;
+  AclnnExecFunc execute;
+  if (scatter_metadata_->reduction == NpuScatterReduction::kSet) {
+    std::vector<int64_t> broadcast_strides(update_dimensions.size(), 0);
+    broadcast_strides[0] = 1;
+    aclTensor* broadcast_indices = make_view(update_dimensions, shapes[1].element_type(),
+        index_address, flat_dimensions, broadcast_strides);
+    if (broadcast_indices == nullptr) return absl::InternalError("scatter broadcast index creation failed");
+    owners.emplace_back(broadcast_indices, destroy_tensor);
+    status = dep::aclnnInplaceScatterGetWorkspaceSize(
+        scatter_output, 0, broadcast_indices, update_view, 0, &workspace_size, &executor);
+    execute = dep::aclnnInplaceScatter;
+  } else {
+    status = dep::aclnnTfScatterAddGetWorkspaceSize(
+        tensors[3], index_view, update_view, &workspace_size, &executor);
+    execute = dep::aclnnTfScatterAdd;
+  }
+  TF_RETURN_IF_ERROR(run(status, execute));
+  if (scatter_metadata_->needs_bounds_mask &&
+      scatter_metadata_->reduction == NpuScatterReduction::kSet) {
+    TF_RETURN_IF_ERROR(run(dep::aclnnSWhereGetWorkspaceSize(
+        valid, scatter_output, tensors[0], tensors[3], &workspace_size, &executor), dep::aclnnSWhere));
+  }
+  if (!scratch.addresses.empty()) {
+    aclError synchronized = dep::aclrtSynchronizeStream(stream);
+    if (synchronized != ACL_SUCCESS) {
+      return absl::InternalError("scatter scratch completion synchronization failed");
+    }
+    scratch.synchronized = true;
+  }
+  return SyncStreamIfEnabled(params.stream);
+}
+
+absl::Status NpuAclnnThunk::ExecuteCollisionElementwise(const ExecuteParams& params) {
+  const auto& shapes = thunk_info().param_shapes;
+  HloOpcode opcode = thunk_info().op_code;
+  if (opcode == HloOpcode::kRemainder) {
+    return absl::UnimplementedError("remainder is unsupported until exact integer and IEEE semantics are validated");
+  }
+  bool binary = opcode == HloOpcode::kMinimum || opcode == HloOpcode::kOr ||
+                opcode == HloOpcode::kRemainder || opcode == HloOpcode::kPower ||
+                opcode == HloOpcode::kAtan2;
+  size_t count = binary ? 3 : 2;
+  if (shapes.size() != count || args_.size() != count || !shapes[0].IsArray()) {
+    return absl::UnimplementedError("collision elementwise argument count/array mismatch");
+  }
+  PrimitiveType type = shapes[0].element_type();
+  if (opcode == HloOpcode::kAtan2 && type != F32) {
+    return absl::UnimplementedError("Native Atan2 requires f32 operands");
+  }
+  if (opcode == HloOpcode::kPower && type != F32) {
+    return absl::UnimplementedError("Native Power requires f32 operands");
+  }
+  bool logical = opcode == HloOpcode::kNot || opcode == HloOpcode::kOr;
+  const bool supports_strided = logical || opcode == HloOpcode::kIsFinite;
+  if (logical && type != PRED) return absl::UnimplementedError("Logical Not/Or require pred");
+  if (!logical && type != F32 && type != S32) {
+    return absl::UnimplementedError("collision numeric elementwise requires f32/s32");
+  }
+  for (size_t argument = 0; argument < shapes.size(); ++argument) {
+    const Shape& shape = shapes[argument];
+    PrimitiveType expected_type = argument == count - 1 && opcode == HloOpcode::kIsFinite ? PRED : type;
+    if (!shape.IsArray() || !shape.has_layout() || !LayoutUtil::IsDenseArray(shape) ||
+        shape.layout().tiles_size() != 0 || shape.layout().element_size_in_bits() != 0 ||
+        shape.dimensions_size() > 8 ||
+        shape.layout().minor_to_major_size() != shape.dimensions_size() ||
+        shape.dimensions() != shapes[0].dimensions() || shape.element_type() != expected_type) {
+      return absl::UnimplementedError("collision elementwise dtype/dimensions/layout mismatch");
+    }
+    bool seen_minor[8] = {};
+    for (int64_t dimension = 0; dimension < shape.dimensions_size(); ++dimension) {
+      int64_t minor = shape.layout().minor_to_major(dimension);
+      if (shape.is_dynamic_dimension(dimension) || minor < 0 || minor >= shape.dimensions_size() || seen_minor[minor]) {
+        return absl::UnimplementedError("collision elementwise requires static dense layout permutations");
+      }
+      seen_minor[minor] = true;
+    }
+    if (!supports_strided && !LayoutUtil::IsMonotonicWithDim0Major(shape.layout())) {
+      return absl::UnimplementedError("collision numeric repair requires canonical layout");
+    }
+    int64_t bytes = ShapeUtil::ByteSizeOf(shape);
+    if (bytes < 0 || args_[argument].size() < bytes) {
+      return absl::InvalidArgumentError("collision elementwise allocation is too small");
+    }
+  }
+  int64_t elements = ShapeUtil::ElementsIn(shapes[0]);
+  if (elements < 0 || elements > (1LL << 24)) {
+    return absl::UnimplementedError("collision elementwise exceeds bounded element count");
+  }
+  if (elements == 0) return absl::OkStatus();
+  auto stream = static_cast<aclrtStream>(params.stream->platform_specific_handle().stream);
+  struct TemporaryBuffers {
+    aclrtStream stream;
+    std::vector<void*> addresses;
+    bool synchronized = false;
+    ~TemporaryBuffers() {
+      if (addresses.empty()) return;
+      if (!synchronized && dep::aclrtSynchronizeStream(stream) != ACL_SUCCESS) {
+        NPU_LOG_PRINT(ERROR, "elementwise cleanup synchronization failed; retaining buffers");
+        return;
+      }
+      for (void* address : addresses) dep::aclrtFree(address);
+    }
+  } temporary{stream, {}, false};
+  TF_ASSIGN_OR_RETURN(auto tensors, ExtractAclInputOutTensorPtr(params.buffer_allocations, shapes));
+  auto destroy_tensor = [](aclTensor* tensor) { dep::aclDestroyTensor(tensor); };
+  std::vector<std::unique_ptr<aclTensor, decltype(destroy_tensor)>> tensor_owners;
+  for (aclTensor* tensor : tensors) tensor_owners.emplace_back(tensor, destroy_tensor);
+  auto destroy_scalar = [](aclScalar* scalar) { dep::aclDestroyScalar(scalar); };
+  std::vector<std::unique_ptr<aclScalar, decltype(destroy_scalar)>> scalar_owners;
+  auto make_scalar = [&](void* value, aclDataType dtype) -> absl::StatusOr<aclScalar*> {
+    aclScalar* scalar = dep::aclCreateScalar(value, dtype);
+    if (scalar == nullptr) return absl::InternalError("elementwise scalar creation failed");
+    scalar_owners.emplace_back(scalar, destroy_scalar);
+    return scalar;
+  };
+  auto integer_scalar = [&](int64_t value) { return make_scalar(&value, ACL_INT64); };
+  auto float_scalar = [&](float value) { return make_scalar(&value, ACL_FLOAT); };
+  auto allocate = [&](PrimitiveType dtype, bool scalar = false) -> absl::StatusOr<aclTensor*> {
+    std::vector<int64_t> dimensions;
+    if (!scalar) dimensions.assign(shapes[0].dimensions().begin(), shapes[0].dimensions().end());
+    std::vector<int64_t> strides(dimensions.size());
+    int64_t stride = 1;
+    for (size_t dimension = dimensions.size(); dimension > 0; --dimension) {
+      strides[dimension - 1] = stride;
+      stride *= dimensions[dimension - 1];
+    }
+    size_t size = stride * ShapeUtil::ByteSizeOfPrimitiveType(dtype);
+    void* address = nullptr;
+    if (dep::aclrtMalloc(&address, size, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS || address == nullptr) {
+      return absl::ResourceExhaustedError("elementwise scratch allocation failed");
+    }
+    temporary.addresses.push_back(address);
+    aclTensor* tensor = dep::aclCreateTensor(
+        dimensions.data(), dimensions.size(), NpuTool::ConvertXlaType2AclDataType(dtype),
+        strides.data(), 0, ACL_FORMAT_ND, dimensions.data(), dimensions.size(), address);
+    if (tensor == nullptr) return absl::InternalError("elementwise scratch descriptor creation failed");
+    tensor_owners.emplace_back(tensor, destroy_tensor);
+    return tensor;
+  };
+  uint64_t workspace_size = 0;
+  aclOpExecutor* executor = nullptr;
+  auto run = [&](aclnnStatus status, AclnnExecFunc execute) -> absl::Status {
+    if (status != ACL_SUCCESS) {
+      return absl::InternalError(absl::StrFormat("collision elementwise ACLNN query failed: %d", status));
+    }
+    return ExecuteAclnn(stream, workspace_size, executor, execute);
+  };
+  auto fill_scalar_tensor = [&](PrimitiveType dtype, aclScalar* value) -> absl::StatusOr<aclTensor*> {
+    TF_ASSIGN_OR_RETURN(auto tensor, allocate(dtype, true));
+    TF_RETURN_IF_ERROR(run(dep::aclnnInplaceFillScalarGetWorkspaceSize(
+        tensor, value, &workspace_size, &executor), dep::aclnnInplaceFillScalar));
+    return tensor;
+  };
+  aclTensor* self = tensors[0];
+  aclTensor* out = tensors.back();
+  TF_ASSIGN_OR_RETURN(auto zero_scalar, integer_scalar(0));
+  switch (opcode) {
+    case HloOpcode::kAtan2:
+      TF_RETURN_IF_ERROR(run(dep::aclnnAtan2GetWorkspaceSize(self, tensors[1], out,
+          &workspace_size, &executor), dep::aclnnAtan2));
+      break;
+    case HloOpcode::kPower:
+      TF_RETURN_IF_ERROR(run(dep::aclnnPowTensorTensorGetWorkspaceSize(self, tensors[1], out,
+          &workspace_size, &executor), dep::aclnnPowTensorTensor));
+      break;
+    case HloOpcode::kAbs:
+      TF_RETURN_IF_ERROR(run(dep::aclnnAbsGetWorkspaceSize(self, out, &workspace_size, &executor), dep::aclnnAbs));
+      break;
+    case HloOpcode::kNot:
+      TF_RETURN_IF_ERROR(run(dep::aclnnLogicalNotGetWorkspaceSize(self, out, &workspace_size, &executor), dep::aclnnLogicalNot));
+      break;
+    case HloOpcode::kOr:
+      TF_RETURN_IF_ERROR(run(dep::aclnnLogicalOrGetWorkspaceSize(self, tensors[1], out, &workspace_size, &executor), dep::aclnnLogicalOr));
+      break;
+    case HloOpcode::kIsFinite:
+      TF_RETURN_IF_ERROR(run(dep::aclnnIsFiniteGetWorkspaceSize(self, out, &workspace_size, &executor), dep::aclnnIsFinite));
+      break;
+    case HloOpcode::kSign: {
+      if (type == S32) {
+        TF_RETURN_IF_ERROR(run(dep::aclnnSignGetWorkspaceSize(self, out, &workspace_size, &executor), dep::aclnnSign));
+        break;
+      }
+      TF_ASSIGN_OR_RETURN(auto positive, allocate(PRED));
+      TF_ASSIGN_OR_RETURN(auto negative, allocate(PRED));
+      TF_ASSIGN_OR_RETURN(auto positive_float, allocate(F32));
+      TF_ASSIGN_OR_RETURN(auto negative_float, allocate(F32));
+      TF_ASSIGN_OR_RETURN(auto signed_unit, allocate(F32));
+      TF_ASSIGN_OR_RETURN(auto magnitude, allocate(F32));
+      TF_ASSIGN_OR_RETURN(auto zeroish, allocate(PRED));
+      TF_ASSIGN_OR_RETURN(auto signbit, allocate(PRED));
+      TF_ASSIGN_OR_RETURN(auto signed_zero, allocate(F32));
+      TF_ASSIGN_OR_RETURN(auto normal_result, allocate(F32));
+      TF_ASSIGN_OR_RETURN(auto nan, allocate(PRED));
+      TF_ASSIGN_OR_RETURN(auto one_scalar, integer_scalar(1));
+      TF_ASSIGN_OR_RETURN(auto normal_minimum, float_scalar(std::numeric_limits<float>::min()));
+      TF_ASSIGN_OR_RETURN(auto positive_zero_scalar, float_scalar(0.0f));
+      TF_ASSIGN_OR_RETURN(auto negative_zero_scalar, float_scalar(-0.0f));
+      TF_ASSIGN_OR_RETURN(auto positive_zero, fill_scalar_tensor(F32, positive_zero_scalar));
+      TF_ASSIGN_OR_RETURN(auto negative_zero, fill_scalar_tensor(F32, negative_zero_scalar));
+      TF_RETURN_IF_ERROR(run(dep::aclnnGtScalarGetWorkspaceSize(self, zero_scalar, positive, &workspace_size, &executor), dep::aclnnGtScalar));
+      TF_RETURN_IF_ERROR(run(dep::aclnnLtScalarGetWorkspaceSize(self, zero_scalar, negative, &workspace_size, &executor), dep::aclnnLtScalar));
+      TF_RETURN_IF_ERROR(run(dep::aclnnCastGetWorkspaceSize(positive, ACL_FLOAT, positive_float, &workspace_size, &executor), dep::aclnnCast));
+      TF_RETURN_IF_ERROR(run(dep::aclnnCastGetWorkspaceSize(negative, ACL_FLOAT, negative_float, &workspace_size, &executor), dep::aclnnCast));
+      TF_RETURN_IF_ERROR(run(dep::aclnnSubGetWorkspaceSize(positive_float, negative_float, one_scalar, signed_unit, &workspace_size, &executor), dep::aclnnSub));
+      TF_RETURN_IF_ERROR(run(dep::aclnnAbsGetWorkspaceSize(self, magnitude, &workspace_size, &executor), dep::aclnnAbs));
+      TF_RETURN_IF_ERROR(run(dep::aclnnLtScalarGetWorkspaceSize(magnitude, normal_minimum, zeroish, &workspace_size, &executor), dep::aclnnLtScalar));
+      TF_RETURN_IF_ERROR(run(dep::aclnnSignbitGetWorkspaceSize(self, signbit, &workspace_size, &executor), dep::aclnnSignbit));
+      TF_RETURN_IF_ERROR(run(dep::aclnnSWhereGetWorkspaceSize(signbit, negative_zero, positive_zero, signed_zero, &workspace_size, &executor), dep::aclnnSWhere));
+      TF_RETURN_IF_ERROR(run(dep::aclnnSWhereGetWorkspaceSize(zeroish, signed_zero, signed_unit, normal_result, &workspace_size, &executor), dep::aclnnSWhere));
+      TF_RETURN_IF_ERROR(run(dep::aclnnNeTensorGetWorkspaceSize(self, self, nan, &workspace_size, &executor), dep::aclnnNeTensor));
+      TF_RETURN_IF_ERROR(run(dep::aclnnSWhereGetWorkspaceSize(nan, self, normal_result, out, &workspace_size, &executor), dep::aclnnSWhere));
+      break;
+    }
+    case HloOpcode::kMinimum: {
+      aclTensor* other = tensors[1];
+      if (type == S32) {
+        TF_RETURN_IF_ERROR(run(dep::aclnnMinimumGetWorkspaceSize(self, other, out, &workspace_size, &executor), dep::aclnnMinimum));
+        break;
+      }
+      TF_ASSIGN_OR_RETURN(auto candidate, allocate(F32));
+      TF_ASSIGN_OR_RETURN(auto self_zero, allocate(PRED));
+      TF_ASSIGN_OR_RETURN(auto other_zero, allocate(PRED));
+      TF_ASSIGN_OR_RETURN(auto both_zero, allocate(PRED));
+      TF_ASSIGN_OR_RETURN(auto self_signbit, allocate(PRED));
+      TF_ASSIGN_OR_RETURN(auto chosen_zero, allocate(F32));
+      TF_ASSIGN_OR_RETURN(auto zero_repaired, allocate(F32));
+      TF_ASSIGN_OR_RETURN(auto self_nan, allocate(PRED));
+      TF_ASSIGN_OR_RETURN(auto other_nan, allocate(PRED));
+      TF_ASSIGN_OR_RETURN(auto self_nan_repaired, allocate(F32));
+      TF_RETURN_IF_ERROR(run(dep::aclnnMinimumGetWorkspaceSize(self, other, candidate, &workspace_size, &executor), dep::aclnnMinimum));
+      TF_RETURN_IF_ERROR(run(dep::aclnnEqScalarGetWorkspaceSize(self, zero_scalar, self_zero, &workspace_size, &executor), dep::aclnnEqScalar));
+      TF_RETURN_IF_ERROR(run(dep::aclnnEqScalarGetWorkspaceSize(other, zero_scalar, other_zero, &workspace_size, &executor), dep::aclnnEqScalar));
+      TF_RETURN_IF_ERROR(run(dep::aclnnBitwiseAndTensorGetWorkspaceSize(self_zero, other_zero, both_zero, &workspace_size, &executor), dep::aclnnBitwiseAndTensor));
+      TF_RETURN_IF_ERROR(run(dep::aclnnSignbitGetWorkspaceSize(self, self_signbit, &workspace_size, &executor), dep::aclnnSignbit));
+      TF_RETURN_IF_ERROR(run(dep::aclnnSWhereGetWorkspaceSize(self_signbit, self, other, chosen_zero, &workspace_size, &executor), dep::aclnnSWhere));
+      TF_RETURN_IF_ERROR(run(dep::aclnnSWhereGetWorkspaceSize(both_zero, chosen_zero, candidate, zero_repaired, &workspace_size, &executor), dep::aclnnSWhere));
+      TF_RETURN_IF_ERROR(run(dep::aclnnNeTensorGetWorkspaceSize(self, self, self_nan, &workspace_size, &executor), dep::aclnnNeTensor));
+      TF_RETURN_IF_ERROR(run(dep::aclnnNeTensorGetWorkspaceSize(other, other, other_nan, &workspace_size, &executor), dep::aclnnNeTensor));
+      TF_RETURN_IF_ERROR(run(dep::aclnnSWhereGetWorkspaceSize(self_nan, self, zero_repaired, self_nan_repaired, &workspace_size, &executor), dep::aclnnSWhere));
+      TF_RETURN_IF_ERROR(run(dep::aclnnSWhereGetWorkspaceSize(other_nan, other, self_nan_repaired, out, &workspace_size, &executor), dep::aclnnSWhere));
+      break;
+    }
+    default:
+      return absl::UnimplementedError("unsupported collision elementwise opcode");
+  }
+  if (!temporary.addresses.empty()) {
+    if (dep::aclrtSynchronizeStream(stream) != ACL_SUCCESS) {
+      return absl::InternalError("elementwise scratch completion synchronization failed");
+    }
+    temporary.synchronized = true;
+  }
+  return SyncStreamIfEnabled(params.stream);
+}
