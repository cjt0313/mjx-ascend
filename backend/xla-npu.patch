+absl::Status LegalizeNativeIntegerRemainder(HloModule* module) {
+  for (auto* computation : module->computations()) {
+    for (auto* instruction : computation->MakeInstructionPostOrder()) {
+      if (instruction->opcode() != HloOpcode::kRemainder) continue;
+      const Shape& shape = instruction->shape();
+      if (!shape.IsArray() || shape.element_type() != S32 ||
+          shape.dimensions_size() > 8 || instruction->operand_count() != 2 ||
+          !ShapeUtil::Equal(shape, instruction->operand(0)->shape()) ||
+          !ShapeUtil::Equal(shape, instruction->operand(1)->shape())) continue;
+      int64_t elements = 1;
+      bool supported = true;
+      for (int64_t dimension = 0; dimension < shape.dimensions_size(); ++dimension) {
+        int64_t extent = shape.dimensions(dimension);
+        if (shape.is_dynamic_dimension(dimension) || extent < 1 ||
+            elements > (1LL << 20) / extent) {
+          supported = false;
+          break;
+        }
+        elements *= extent;
+      }
+      if (!supported) continue;
+      Shape predicate_shape = ShapeUtil::ChangeElementType(shape, PRED);
+      const auto constant = [&](int32_t value) {
+        auto* scalar = computation->AddInstruction(
+            HloInstruction::CreateConstant(LiteralUtil::CreateR0<int32_t>(value)));
+        if (ShapeUtil::IsScalar(shape)) return scalar;
+        return computation->AddInstruction(HloInstruction::CreateBroadcast(shape, scalar, {}));
+      };
+      const HloInstruction* constant_divisor = instruction->operand(1);
+      if (constant_divisor->opcode() == HloOpcode::kBroadcast) {
+        constant_divisor = constant_divisor->operand(0);
+      }
+      if (constant_divisor->opcode() == HloOpcode::kConstant &&
+          constant_divisor->shape().element_type() == S32 &&
+          constant_divisor->literal().IsAll(1)) {
+        auto* replacement = constant(0);
+        instruction->SetupDerivedInstruction(replacement);
+        TF_ASSIGN_OR_RETURN(bool replaced,
+            computation->ReplaceInstruction(instruction, replacement, true, true));
+        if (!replaced) return absl::InternalError("Native remainder-by-one replacement was rejected");
+        continue;
+      }
+      const auto constant_operand = [](const HloInstruction* operand) -> const Literal* {
+        if (operand->opcode() == HloOpcode::kBroadcast) {
+          operand = operand->operand(0);
+          if (!ShapeUtil::IsScalar(operand->shape())) return nullptr;
+        }
+        if (operand->opcode() != HloOpcode::kConstant ||
+            operand->shape().element_type() != S32) return nullptr;
+        return &operand->literal();
+      };
+      const Literal* constant_dividend = constant_operand(instruction->operand(0));
+      const Literal* constant_modulus = constant_operand(instruction->operand(1));
+      if (constant_dividend != nullptr && constant_modulus != nullptr) {
+        const auto exact_remainder = [](int32_t dividend, int32_t divisor) {
+          int64_t wide_dividend = dividend;
+          int64_t wide_divisor = divisor;
+          return static_cast<int32_t>(wide_divisor == 0 ? wide_dividend : wide_dividend % wide_divisor);
+        };
+        Literal folded = Literal::CreateFromShape(shape);
+        TF_RETURN_IF_ERROR(folded.Populate<int32_t>([&](absl::Span<const int64_t> index) {
+          int32_t dividend = ShapeUtil::IsScalar(constant_dividend->shape())
+              ? constant_dividend->GetFirstElement<int32_t>() : constant_dividend->Get<int32_t>(index);
+          int32_t divisor = ShapeUtil::IsScalar(constant_modulus->shape())
+              ? constant_modulus->GetFirstElement<int32_t>() : constant_modulus->Get<int32_t>(index);
+          return exact_remainder(dividend, divisor);
+        }));
+        auto* replacement = computation->AddInstruction(HloInstruction::CreateConstant(std::move(folded)));
+        instruction->SetupDerivedInstruction(replacement);
+        TF_ASSIGN_OR_RETURN(bool replaced,
+            computation->ReplaceInstruction(instruction, replacement, true, true));
+        if (!replaced) return absl::InternalError("Native constant remainder replacement was rejected");
+        continue;
+      }
+      const auto binary = [&](HloOpcode opcode, HloInstruction* first, HloInstruction* second) {
+        return computation->AddInstruction(HloInstruction::CreateBinary(
+            opcode == HloOpcode::kAnd ? predicate_shape : shape, opcode, first, second));
+      };
+      const auto compare = [&](HloInstruction* first, HloInstruction* second,
+                               ComparisonDirection direction) {
+        return computation->AddInstruction(HloInstruction::CreateCompare(
+            predicate_shape, first, second, direction));
+      };
+      const auto select = [&](HloInstruction* predicate, HloInstruction* first,
+                              HloInstruction* second) {
+        return computation->AddInstruction(HloInstruction::CreateTernary(
+            shape, HloOpcode::kSelect, predicate, first, second));
+      };
+      auto* zero = constant(0);
+      auto* half_minimum = constant(-1073741824);
+      auto* dividend = instruction->mutable_operand(0);
+      auto* divisor = instruction->mutable_operand(1);
+      auto* positive_dividend = compare(dividend, zero, ComparisonDirection::kGt);
+      auto* positive_divisor = compare(divisor, zero, ComparisonDirection::kGt);
+      auto* negative_dividend = select(positive_dividend,
+          binary(HloOpcode::kSubtract, zero, select(positive_dividend, dividend, zero)), dividend);
+      auto* negative_divisor = select(positive_divisor,
+          binary(HloOpcode::kSubtract, zero, select(positive_divisor, divisor, zero)), divisor);
+      std::vector<HloInstruction*> levels{negative_divisor};
+      for (int64_t level = 1; level < 32; ++level) {
+        auto* valid = binary(HloOpcode::kAnd,
+            compare(levels.back(), zero, ComparisonDirection::kLt),
+            compare(levels.back(), half_minimum, ComparisonDirection::kGe));
+        auto* safe = select(valid, levels.back(), zero);
+        levels.push_back(binary(HloOpcode::kAdd, safe, safe));
+      }
+      HloInstruction* remaining = negative_dividend;
+      for (int64_t level = 31; level >= 0; --level) {
+        auto* take = binary(HloOpcode::kAnd,
+            compare(levels[level], zero, ComparisonDirection::kLt),
+            compare(remaining, levels[level], ComparisonDirection::kLe));
+        remaining = binary(HloOpcode::kSubtract, remaining, select(take, levels[level], zero));
+      }
+      auto* replacement = select(positive_dividend,
+          binary(HloOpcode::kSubtract, zero, select(positive_dividend, remaining, zero)), remaining);
+      instruction->SetupDerivedInstruction(replacement);
+      TF_ASSIGN_OR_RETURN(bool replaced,
+          computation->ReplaceInstruction(instruction, replacement, true, true));
+      if (!replaced) return absl::InternalError("Native integer remainder replacement was rejected");
+    }
+  }
+  return absl::OkStatus();
+}
