+          ShapeUtil::MakeShape(input.element_type(), {input.dimensions(0), input.dimensions(1) - 4, 3}),
+          instruction->mutable_operand(0), {0, 4, 0}, {input.dimensions(0), input.dimensions(1), 3}, {1, 1, 1}));
+      auto* replacement = computation->AddInstruction(HloInstruction::CreateConcatenate(
