+absl::Status NpuAclnnThunk::ExecuteCholesky(const ExecuteParams& params) {
+  const auto& shapes = thunk_info().param_shapes;
+  if (args_.size() != 2 || shapes.size() != 2 || output_args_.size() != 2 ||
+      output_args_[0] || !output_args_[1]) {
+    return absl::InvalidArgumentError("Cholesky requires distinct input and output buffers");
+  }
+  for (const auto& shape : shapes) {
+    if (!shape.IsArray() || shape.element_type() != F32 || shape.dimensions_size() != 2 ||
+        shape.dimensions(0) < 1 || shape.dimensions(0) > 64 || shape.dimensions(0) != shape.dimensions(1) ||
+        shape.is_dynamic_dimension(0) || shape.is_dynamic_dimension(1) ||
+        !shape.has_layout() || !LayoutUtil::IsDenseArray(shape) || shape.layout().tiles_size() != 0) {
+      return absl::UnimplementedError("Cholesky requires bounded static dense f32 square matrices");
+    }
+  }
+  if (!ShapeUtil::Compatible(shapes[0], shapes[1])) {
+    return absl::InvalidArgumentError("Cholesky input/output dimensions differ");
+  }
+  const int64_t bytes = ShapeUtil::ByteSizeOf(shapes[0]);
+  auto input = params.buffer_allocations->GetDeviceAddress(args_[0]);
+  auto output = params.buffer_allocations->GetDeviceAddress(args_[1]);
+  if (!input.opaque() || !output.opaque() || args_[0].size() < bytes || args_[1].size() < bytes) {
+    return absl::InvalidArgumentError("Cholesky buffer is null or too small");
+  }
+  const auto input_address = reinterpret_cast<uintptr_t>(input.opaque());
+  const auto output_address = reinterpret_cast<uintptr_t>(output.opaque());
+  if (input_address < output_address + bytes && output_address < input_address + bytes) {
+    return absl::InvalidArgumentError("Cholesky input/output must not overlap");
+  }
+  TF_ASSIGN_OR_RETURN(auto tensors, ExtractAclInputOutTensorPtr(params.buffer_allocations, shapes));
+  auto destroy_tensor = [](aclTensor* tensor) { dep::aclDestroyTensor(tensor); };
+  std::vector<std::unique_ptr<aclTensor, decltype(destroy_tensor)>> owners;
+  for (auto* tensor : tensors) owners.emplace_back(tensor, destroy_tensor);
+  auto stream = static_cast<aclrtStream>(params.stream->platform_specific_handle().stream);
+  uint64_t workspace_size = 0;
+  aclOpExecutor* executor = nullptr;
+  const auto query_status = dep::aclnnLinalgCholeskyGetWorkspaceSize(
+      tensors[0], false, tensors[1], &workspace_size, &executor);
+  if (query_status != ACL_SUCCESS) {
+    return absl::InternalError(absl::StrFormat("Native Cholesky ACLNN query failed: %d", query_status));
+  }
+  const auto execute_status = ExecuteAclnn(stream, workspace_size, executor, dep::aclnnLinalgCholesky);
+  const auto synchronize_status = dep::aclrtSynchronizeStream(stream);
+  TF_RETURN_IF_ERROR(execute_status);
+  if (synchronize_status != ACL_SUCCESS) {
+    return absl::InternalError(absl::StrFormat("Native Cholesky synchronization failed: %d", synchronize_status));
+  }
+  return absl::OkStatus();
+}
