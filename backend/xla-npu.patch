+#endif
diff --git a/xla_npu/backend/runtime/npu_copy_thunk.cc b/xla_npu/backend/runtime/npu_copy_thunk.cc
new file mode 100644
index 0000000..026ff17
--- /dev/null
+++ b/xla_npu/backend/runtime/npu_copy_thunk.cc
@@ -0,0 +1,18 @@
+#include "xla/xla_npu/backend/runtime/npu_copy_thunk.h"
+
+#include "xla/tsl/platform/statusor.h"
+
+namespace xla {
+
+absl::Status NpuCopyThunk::ExecuteOnStream(const ExecuteParams& params) {
+  if (bytes_ == 0 || source_ == destination_) return absl::OkStatus();
+  if (bytes_ > source_.size() || bytes_ > destination_.size()) {
+    return absl::InvalidArgumentError("Device copy exceeds allocation slice");
+  }
+  TF_RETURN_IF_ERROR(params.stream->BlockHostUntilDone());
+  auto source = params.buffer_allocations->GetDeviceAddress(source_);
+  auto destination = params.buffer_allocations->GetDeviceAddress(destination_);
+  return params.stream->Memcpy(&destination, source, bytes_);
+}
+
+}
diff --git a/xla_npu/backend/runtime/npu_copy_thunk.h b/xla_npu/backend/runtime/npu_copy_thunk.h
