+absl::Status NpuIrEmitterUnnested::EmitCopy(const HloInstruction* instr) {
+  if (!instr->shape().IsArray() ||
+      !LayoutUtil::LayoutsInShapesEqual(instr->shape(), instr->operand(0)->shape())) {
+    return absl::UnimplementedError("Device copy requires matching dense array layouts");
+  }
+  TF_ASSIGN_OR_RETURN(auto source, GetAllocationSliceForHlo(instr->operand(0)));
+  TF_ASSIGN_OR_RETURN(auto destination, GetAllocationSliceForHlo(instr));
+  AddThunkToThunkSequence(std::make_unique<NpuCopyThunk>(
+      NpuThunk::ThunkInfo::WithProfileAnnotation(instr, ir_emitter_context_->GetNextThunkId()),
+      source, destination, ShapeUtil::ByteSizeOf(instr->shape())));
+  return absl::OkStatus();
+}
