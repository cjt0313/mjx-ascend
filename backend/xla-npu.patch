diff --git a/xla_npu/backend/runtime/npu_scatter_hlo.cc b/xla_npu/backend/runtime/npu_scatter_hlo.cc
new file mode 100644
index 0000000..3b3d12a
--- /dev/null
+++ b/xla_npu/backend/runtime/npu_scatter_hlo.cc
@@ -0,0 +1,174 @@
+#include "xla/xla_npu/backend/runtime/npu_scatter_hlo.h"
+
+#include <algorithm>
+#include <limits>
+#include <optional>
+#include <unordered_set>
+#include <utility>
+
+#include "absl/status/status.h"
+#include "xla/hlo/ir/hlo_computation.h"
+#include "xla/layout_util.h"
+#include "xla/shape_util.h"
+
+namespace xla {
+namespace {
+
+using IndexRange = std::pair<int64_t, int64_t>;
+
+std::optional<IndexRange> GetIndexRange(const HloInstruction* instruction,
+                                      int depth = 0) {
+  if (depth > 32 || (instruction->shape().element_type() != S32 &&
+                     instruction->shape().element_type() != S64)) {
+    return std::nullopt;
+  }
+  switch (instruction->opcode()) {
+    case HloOpcode::kConstant: {
+      if (ShapeUtil::ElementsIn(instruction->shape()) == 0) return std::nullopt;
+      int64_t lower = INT64_MAX;
+      int64_t upper = INT64_MIN;
+      if (instruction->shape().element_type() == S32) {
+        for (int32_t value : instruction->literal().data<int32_t>()) {
+          lower = std::min(lower, static_cast<int64_t>(value));
+          upper = std::max(upper, static_cast<int64_t>(value));
+        }
+      } else {
+        for (int64_t value : instruction->literal().data<int64_t>()) {
+          lower = std::min(lower, value);
+          upper = std::max(upper, value);
+        }
+      }
+      return IndexRange{lower, upper};
+    }
+    case HloOpcode::kReshape:
+    case HloOpcode::kBroadcast:
+    case HloOpcode::kCopy:
+      return GetIndexRange(instruction->operand(0), depth + 1);
+    case HloOpcode::kClamp: {
+      auto lower = GetIndexRange(instruction->operand(0), depth + 1);
+      auto upper = GetIndexRange(instruction->operand(2), depth + 1);
+      if (!lower || !upper || lower->second > upper->first) return std::nullopt;
+      return IndexRange{lower->first, upper->second};
+    }
+    case HloOpcode::kIota: {
+      int64_t extent = instruction->shape().dimensions(instruction->dimensions(0));
+      if (extent <= 0 || (instruction->shape().element_type() == S32 &&
+                          extent - 1 > std::numeric_limits<int32_t>::max())) {
+        return std::nullopt;
+      }
+      return IndexRange{0, extent - 1};
+    }
+    default:
+      return std::nullopt;
+  }
+}
+
+bool IsDenseStaticArray(const Shape& shape) {
+  if (!shape.IsArray() || !shape.has_layout() || !LayoutUtil::IsDenseArray(shape) ||
+      shape.layout().tiles_size() != 0) return false;
+  for (int64_t dimension = 0; dimension < shape.dimensions_size(); ++dimension) {
+    if (shape.is_dynamic_dimension(dimension) ||
+        shape.layout().minor_to_major(dimension) != shape.dimensions_size() - 1 - dimension) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}
+
+absl::StatusOr<NpuScatterMetadata> ExtractNpuScatterMetadata(
+    const HloInstruction* instruction) {
+  if (instruction == nullptr || instruction->opcode() != HloOpcode::kScatter ||
+      instruction->operand_count() != 3 || !instruction->shape().IsArray()) {
+    return absl::UnimplementedError("scatter requires exactly one operand/index/update and array result");
+  }
+  for (const HloInstruction* operand : instruction->operands()) {
+    if (!IsDenseStaticArray(operand->shape())) {
+      return absl::UnimplementedError("scatter requires static untiled row-major arrays: " + instruction->ToString());
+    }
+  }
+  const Shape& operand = instruction->operand(0)->shape();
+  const Shape& indices = instruction->operand(1)->shape();
+  const Shape& updates = instruction->operand(2)->shape();
+  if (!IsDenseStaticArray(instruction->shape()) ||
+      !ShapeUtil::Equal(operand, instruction->shape()) ||
+      operand.element_type() != updates.element_type() ||
+      (indices.element_type() != S32 && indices.element_type() != S64)) {
+    return absl::UnimplementedError("scatter output/update/index type or layout mismatch");
+  }
+  const auto& dimensions = instruction->scatter_dimension_numbers();
+  NpuScatterSpec spec;
+  spec.operand_dims.assign(operand.dimensions().begin(), operand.dimensions().end());
+  spec.indices_dims.assign(indices.dimensions().begin(), indices.dimensions().end());
+  spec.updates_dims.assign(updates.dimensions().begin(), updates.dimensions().end());
+  spec.update_window_dims.assign(dimensions.update_window_dims().begin(), dimensions.update_window_dims().end());
+  spec.inserted_window_dims.assign(dimensions.inserted_window_dims().begin(), dimensions.inserted_window_dims().end());
+  spec.scatter_dims_to_operand_dims.assign(dimensions.scatter_dims_to_operand_dims().begin(), dimensions.scatter_dims_to_operand_dims().end());
+  spec.index_vector_dim = dimensions.index_vector_dim();
+  spec.has_batching = dimensions.input_batching_dims_size() != 0 ||
+                      dimensions.scatter_indices_batching_dims_size() != 0;
+  spec.unique_indices = instruction->unique_indices();
+  bool full_row_windows = indices.dimensions_size() == 2 && indices.dimensions(1) == 1 &&
+      indices.dimensions(0) <= (1 << 20) && operand.dimensions_size() >= 1 &&
+      updates.dimensions_size() == operand.dimensions_size() && updates.dimensions(0) == indices.dimensions(0) &&
+      dimensions.update_window_dims_size() == operand.dimensions_size() - 1 &&
+      dimensions.inserted_window_dims_size() == 1 && dimensions.inserted_window_dims(0) == 0 &&
+      dimensions.scatter_dims_to_operand_dims_size() == 1 && dimensions.scatter_dims_to_operand_dims(0) == 0 &&
+      dimensions.index_vector_dim() == 1 && !spec.has_batching;
+  for (int64_t axis = 1; full_row_windows && axis < operand.dimensions_size(); ++axis) {
+    full_row_windows &= dimensions.update_window_dims(axis - 1) == axis &&
+                        updates.dimensions(axis) == operand.dimensions(axis);
+  }
+  if (!spec.unique_indices && full_row_windows && instruction->operand(1)->opcode() == HloOpcode::kConstant) {
+    std::unordered_set<int64_t> destinations;
+    bool unique = true;
+    const auto& literal = instruction->operand(1)->literal();
+    if (indices.element_type() == S32) {
+      for (int32_t value : literal.data<int32_t>()) unique &= destinations.insert(value).second;
+    } else {
+      for (int64_t value : literal.data<int64_t>()) unique &= destinations.insert(value).second;
+    }
+    spec.unique_indices = unique;
+  }
+  auto range = GetIndexRange(instruction->operand(1));
+  spec.indices_in_bounds = operand.dimensions_size() > 0 && range &&
+                           range->first >= 0 && range->second < operand.dimensions(0);
+  switch (operand.element_type()) {
+    case F32: spec.element_type = NpuScatterElementType::kF32; break;
+    case S32: spec.element_type = NpuScatterElementType::kS32; break;
+    case S64: spec.element_type = NpuScatterElementType::kS64; break;
+    case PRED: spec.element_type = NpuScatterElementType::kPred; break;
+    default: spec.element_type = NpuScatterElementType::kUnsupported;
+  }
+  const HloComputation* computation = instruction->to_apply();
+  if (computation->num_parameters() != 2 ||
+      !ShapeUtil::IsScalar(computation->parameter_instruction(0)->shape()) ||
+      !ShapeUtil::IsScalar(computation->parameter_instruction(1)->shape()) ||
+      computation->parameter_instruction(0)->shape().element_type() != operand.element_type() ||
+      computation->parameter_instruction(1)->shape().element_type() != operand.element_type()) {
+    return absl::UnimplementedError("scatter requires a scalar two-parameter update computation");
+  }
+  const HloInstruction* root = computation->root_instruction();
+  spec.reduction = NpuScatterReduction::kUnsupported;
+  if (root == computation->parameter_instruction(1)) {
+    spec.reduction = NpuScatterReduction::kSet;
+  } else if (root->opcode() == HloOpcode::kAdd && root->operand_count() == 2 &&
+             ((root->operand(0) == computation->parameter_instruction(0) &&
+               root->operand(1) == computation->parameter_instruction(1)) ||
+              (root->operand(1) == computation->parameter_instruction(0) &&
+               root->operand(0) == computation->parameter_instruction(1)))) {
+    spec.reduction = NpuScatterReduction::kAdd;
+  }
+  for (const HloInstruction* update_instruction : computation->instructions()) {
+    if (update_instruction != root && update_instruction->opcode() != HloOpcode::kParameter) {
+      return absl::UnimplementedError("scatter update computation contains extra operations");
+    }
+  }
+  NpuScatterMetadata metadata;
+  std::string error = ValidateNpuScatter(spec, &metadata);
+  if (!error.empty()) return absl::UnimplementedError(error + ": " + instruction->ToString());
+  return metadata;
+}
+
+}
