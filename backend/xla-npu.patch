+absl::Status LegalizeNativeColumnWindowScatter(HloModule* module) {
+  for (auto* computation : module->computations()) {
+    for (auto* instruction : computation->MakeInstructionPostOrder()) {
+      if (instruction->opcode() != HloOpcode::kScatter || instruction->operand_count() != 3 ||
+          !instruction->shape().IsArray()) continue;
+      const auto* scatter = Cast<HloScatterInstruction>(instruction);
+      const auto& dimensions = scatter->scatter_dimension_numbers();
+      const Shape& input = instruction->operand(0)->shape();
+      const Shape& update = instruction->operand(2)->shape();
+      const auto* indices = instruction->operand(1);
+      const bool single_column = update.dimensions_size() == 1 &&
+          dimensions.update_window_dims_size() == 1 && dimensions.update_window_dims(0) == 0 &&
+          dimensions.inserted_window_dims_size() == 1 && dimensions.inserted_window_dims(0) == 1;
+      const bool column_window = update.dimensions_size() == 2 &&
+          dimensions.update_window_dims_size() == 2 && dimensions.update_window_dims(0) == 0 &&
+          dimensions.update_window_dims(1) == 1 && dimensions.inserted_window_dims_size() == 0;
+      if (input.dimensions_size() != 2 || (!single_column && !column_window) ||
+          input.element_type() != update.element_type() || !ShapeUtil::Equal(input, instruction->shape()) ||
+          dimensions.input_batching_dims_size() != 0 || dimensions.scatter_indices_batching_dims_size() != 0 ||
+          dimensions.scatter_dims_to_operand_dims_size() != 1 || dimensions.scatter_dims_to_operand_dims(0) != 1 ||
+          dimensions.index_vector_dim() != 0 || !scatter->unique_indices() || !scatter->indices_are_sorted() ||
+          indices->opcode() != HloOpcode::kConstant || indices->shape().dimensions_size() != 1 ||
+          indices->shape().dimensions(0) != 1 || indices->shape().element_type() != S32 ||
+          update.dimensions(0) != input.dimensions(0)) continue;
+      const int32_t column = indices->literal().GetFirstElement<int32_t>();
+      const int64_t update_columns = single_column ? 1 : update.dimensions(1);
+      if (column < 0 || update_columns > input.dimensions(1) ||
+          column > input.dimensions(1) - update_columns ||
+          input.is_dynamic_dimension(0) || input.is_dynamic_dimension(1) ||
+          update.is_dynamic_dimension(0) || (column_window && update.is_dynamic_dimension(1))) continue;
+      const auto* update_computation = scatter->to_apply();
+      const auto* addition = update_computation->root_instruction();
+      const bool additive = update_computation->num_parameters() == 2 &&
+          update_computation->instruction_count() == 3 &&
+          addition->opcode() == HloOpcode::kAdd && addition->operand_count() == 2 &&
+          ((addition->operand(0) == update_computation->parameter_instruction(0) &&
+            addition->operand(1) == update_computation->parameter_instruction(1)) ||
+           (addition->operand(1) == update_computation->parameter_instruction(0) &&
+            addition->operand(0) == update_computation->parameter_instruction(1)));
+      if (!additive && (update_computation->num_parameters() != 2 || update_computation->instruction_count() != 2 ||
+          update_computation->root_instruction()->opcode() != HloOpcode::kParameter ||
+          update_computation->root_instruction()->parameter_number() != 1)) continue;
+      std::vector<HloInstruction*> starts;
+      starts.push_back(computation->AddInstruction(HloInstruction::CreateConstant(LiteralUtil::CreateR0<int32_t>(0))));
+      starts.push_back(computation->AddInstruction(HloInstruction::CreateConstant(LiteralUtil::CreateR0<int32_t>(column))));
+      auto* reshaped_update = instruction->mutable_operand(2);
+      if (single_column) {
+        reshaped_update = computation->AddInstruction(HloInstruction::CreateReshape(
+            ShapeUtil::MakeShape(update.element_type(), {update.dimensions(0), 1}), reshaped_update));
+      }
+      if (additive) {
+        const std::vector<int64_t> start{0, column};
+        const std::vector<int64_t> limit{input.dimensions(0), column + update_columns};
+        const std::vector<int64_t> strides{1, 1};
+        auto* original_window = computation->AddInstruction(HloInstruction::CreateSlice(
+            reshaped_update->shape(), instruction->mutable_operand(0), start, limit, strides));
+        reshaped_update = computation->AddInstruction(HloInstruction::CreateBinary(
+            reshaped_update->shape(), HloOpcode::kAdd, original_window, reshaped_update));
+      }
+      auto* replacement = computation->AddInstruction(HloInstruction::CreateDynamicUpdateSlice(
+          instruction->shape(), instruction->mutable_operand(0), reshaped_update, starts));
+      instruction->SetupDerivedInstruction(replacement);
+      TF_ASSIGN_OR_RETURN(bool replaced, computation->ReplaceInstruction(instruction, replacement, true, true));
+      if (!replaced) return absl::InternalError("Native column window replacement was rejected");
+    }
+  }
+  return absl::OkStatus();
