diff --git a/xla_npu/backend/runtime/npu_dynamic_update_slice_metadata.h b/xla_npu/backend/runtime/npu_dynamic_update_slice_metadata.h
new file mode 100644
index 0000000..ef6db7a
--- /dev/null
+++ b/xla_npu/backend/runtime/npu_dynamic_update_slice_metadata.h
@@ -0,0 +1,124 @@
+#ifndef XLA_XLA_NPU_BACKEND_RUNTIME_NPU_DYNAMIC_UPDATE_SLICE_METADATA_H_
+#define XLA_XLA_NPU_BACKEND_RUNTIME_NPU_DYNAMIC_UPDATE_SLICE_METADATA_H_
+
+#include <cstdint>
+#include <limits>
+#include <string>
+#include <vector>
+
+namespace xla {
+
+enum class NpuDynamicUpdateSliceElementType {
+  kF32,
+  kS32,
+  kS64,
+  kPred,
+  kUnsupported
+};
+
+struct NpuDynamicUpdateSliceSpec {
+  std::vector<int64_t> input_dims;
+  std::vector<int64_t> update_dims;
+  NpuDynamicUpdateSliceElementType element_type =
+      NpuDynamicUpdateSliceElementType::kUnsupported;
+};
+
+struct NpuDynamicUpdateSliceMetadata {
+  std::vector<int64_t> input_strides;
+  std::vector<int64_t> clamped_starts;
+  int64_t storage_offset = 0;
+  int64_t input_elements = 0;
+  int64_t update_elements = 0;
+};
+
+inline bool NpuDynamicUpdateSliceHasOverlap(int64_t first_offset,
+                                            int64_t first_size,
+                                            int64_t second_offset,
+                                            int64_t second_size) {
+  if (first_size == 0 || second_size == 0) return false;
+  if (first_offset > std::numeric_limits<int64_t>::max() - first_size ||
+      second_offset > std::numeric_limits<int64_t>::max() - second_size) {
+    return true;
+  }
+  int64_t first_end = first_offset + first_size;
+  int64_t second_end = second_offset + second_size;
+  return first_offset < second_end && second_offset < first_end;
+}
+
+inline std::string ValidateNpuDynamicUpdateSlice(
+    const NpuDynamicUpdateSliceSpec& spec, const std::vector<int64_t>& starts,
+    NpuDynamicUpdateSliceMetadata* metadata) {
+  if (metadata == nullptr) {
+    return "dynamic-update-slice metadata destination is null";
+  }
+  if (spec.input_dims.empty() || spec.input_dims.size() > 8 ||
+      spec.update_dims.size() != spec.input_dims.size() ||
+      starts.size() != spec.input_dims.size()) {
+    return "dynamic-update-slice supports rank 1..8 with one scalar start per dimension";
+  }
+  if (spec.element_type != NpuDynamicUpdateSliceElementType::kF32 &&
+      spec.element_type != NpuDynamicUpdateSliceElementType::kS32 &&
+      spec.element_type != NpuDynamicUpdateSliceElementType::kS64 &&
+      spec.element_type != NpuDynamicUpdateSliceElementType::kPred) {
+    return "dynamic-update-slice supports only f32/s32/s64/pred";
+  }
+  int64_t input_elements = 1;
+  int64_t update_elements = 1;
+  std::vector<int64_t> input_strides(spec.input_dims.size(), 1);
+  for (int64_t dimension = static_cast<int64_t>(spec.input_dims.size()) - 1;
+       dimension >= 0; --dimension) {
+    int64_t input_dim = spec.input_dims[dimension];
+    int64_t update_dim = spec.update_dims[dimension];
+    if (input_dim <= 0 || update_dim < 0 || update_dim > input_dim) {
+      return "dynamic-update-slice requires static update dimensions within input dimensions";
+    }
+    if (dimension + 1 < static_cast<int64_t>(spec.input_dims.size())) {
+      int64_t next_dim = spec.input_dims[dimension + 1];
+      if (next_dim != 0 &&
+          input_strides[dimension + 1] >
+              std::numeric_limits<int64_t>::max() / next_dim) {
+        return "dynamic-update-slice stride arithmetic overflows";
+      }
+      input_strides[dimension] = input_strides[dimension + 1] * next_dim;
+    }
+    if (input_elements > std::numeric_limits<int64_t>::max() / input_dim) {
+      return "dynamic-update-slice input size overflows metadata arithmetic";
+    }
+    input_elements *= input_dim;
+    if (update_dim != 0 &&
+        update_elements > std::numeric_limits<int64_t>::max() / update_dim) {
+      return "dynamic-update-slice update size overflows metadata arithmetic";
+    }
+    update_elements *= update_dim;
+  }
+  if (input_elements > (1LL << 24) || update_elements > (1LL << 24)) {
+    return "dynamic-update-slice exceeds bounded tensor/update size limits";
+  }
+  std::vector<int64_t> clamped_starts;
+  clamped_starts.reserve(starts.size());
+  int64_t storage_offset = 0;
+  for (size_t dimension = 0; dimension < spec.input_dims.size(); ++dimension) {
+    int64_t upper = spec.input_dims[dimension] - spec.update_dims[dimension];
+    int64_t clamped_start = starts[dimension] < 0 ? 0 : starts[dimension];
+    if (clamped_start > upper) clamped_start = upper;
+    clamped_starts.push_back(clamped_start);
+    if (clamped_start != 0 &&
+        input_strides[dimension] >
+            std::numeric_limits<int64_t>::max() / clamped_start) {
+      return "dynamic-update-slice offset arithmetic overflows";
+    }
+    int64_t offset_delta = input_strides[dimension] * clamped_start;
+    if (storage_offset >
+        std::numeric_limits<int64_t>::max() - offset_delta) {
+      return "dynamic-update-slice offset arithmetic overflows";
+    }
+    storage_offset += offset_delta;
+  }
+  *metadata = {input_strides, clamped_starts, storage_offset, input_elements,
+               update_elements};
+  return {};
+}
+
+}  // namespace xla
+
+#endif
diff --git a/xla_npu/backend/runtime/npu_dynamic_update_slice_thunk.cc b/xla_npu/backend/runtime/npu_dynamic_update_slice_thunk.cc
new file mode 100644
index 0000000..9866263
--- /dev/null
+++ b/xla_npu/backend/runtime/npu_dynamic_update_slice_thunk.cc
@@ -0,0 +1,332 @@
+#include "xla/xla_npu/backend/runtime/npu_dynamic_update_slice_thunk.h"
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "absl/status/status.h"
+#include "absl/status/statusor.h"
+#include "absl/strings/str_format.h"
+#include "xla/layout_util.h"
+#include "xla/shape.h"
+#include "xla/shape_util.h"
+#include "xla/stream_executor/device_memory.h"
+#include "xla/tsl/platform/errors.h"
+#include "xla/tsl/platform/statusor.h"
+#include "xla/xla_data.pb.h"
+#include "xla/xla_npu/backend/runtime/npu_dynamic_update_slice_metadata.h"
+#include "xla/xla_npu/backend/runtime/npu_workspace_memory_pool.h"
+#include "xla/xla_npu/dependency/interface/acl_interface.h"
+#include "xla/xla_npu/dependency/interface/acl_nn_interface.h"
+#include "xla/xla_npu/dependency/interface/acl_nn_op_interface.h"
+#include "xla/xla_npu/service/npu_buffer_allocations.h"
+
+namespace xla {
+namespace {
+
+NpuDynamicUpdateSliceElementType DynamicUpdateSliceElementType(
+    PrimitiveType element_type) {
+  switch (element_type) {
+    case F32:
+      return NpuDynamicUpdateSliceElementType::kF32;
+    case S32:
+      return NpuDynamicUpdateSliceElementType::kS32;
+    case S64:
+      return NpuDynamicUpdateSliceElementType::kS64;
+    case PRED:
+      return NpuDynamicUpdateSliceElementType::kPred;
+    default:
+      return NpuDynamicUpdateSliceElementType::kUnsupported;
+  }
+}
+
+aclDataType DynamicUpdateSliceAclType(PrimitiveType element_type) {
+  switch (element_type) {
+    case F32:
+      return aclDataType::ACL_FLOAT;
+    case S32:
+      return aclDataType::ACL_INT32;
+    case S64:
+      return aclDataType::ACL_INT64;
+    case PRED:
+      return aclDataType::ACL_BOOL;
+    default:
+      return aclDataType::ACL_FLOAT;
+  }
+}
+
+std::vector<int64_t> ShapeDimensions(const Shape& shape) {
+  return std::vector<int64_t>(shape.dimensions().begin(),
+                              shape.dimensions().end());
+}
+
+std::vector<int64_t> RowMajorStrides(const std::vector<int64_t>& dimensions) {
+  std::vector<int64_t> strides(dimensions.size(), 1);
+  for (int64_t dimension = static_cast<int64_t>(dimensions.size()) - 2;
+       dimension >= 0; --dimension) {
+    strides[dimension] = strides[dimension + 1] * dimensions[dimension + 1];
+  }
+  return strides;
+}
+
+bool IsDenseRowMajorArray(const Shape& shape) {
+  if (!shape.IsArray() || !shape.has_layout() ||
+      !LayoutUtil::IsDenseArray(shape)) {
+    return false;
+  }
+  for (int64_t dimension = 0; dimension < shape.dimensions_size();
+       ++dimension) {
+    if (shape.is_dynamic_dimension(dimension)) return false;
+  }
+  if (shape.layout().tiles_size() != 0 ||
+      shape.layout().element_size_in_bits() != 0) {
+    return false;
+  }
+  if (shape.layout().minor_to_major_size() != shape.dimensions_size()) {
+    return false;
+  }
+  for (int64_t layout_index = 0;
+       layout_index < shape.layout().minor_to_major_size(); ++layout_index) {
+    if (shape.layout().minor_to_major(layout_index) !=
+        shape.dimensions_size() - 1 - layout_index) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool SameSlice(const BufferAllocation::Slice& first,
+               const BufferAllocation::Slice& second) {
+  return first.index() == second.index() && first.offset() == second.offset() &&
+         first.size() == second.size();
+}
+
+bool SliceOverlap(const BufferAllocation::Slice& first,
+                  const BufferAllocation::Slice& second) {
+  if (first.index() != second.index()) return false;
+  return NpuDynamicUpdateSliceHasOverlap(first.offset(), first.size(),
+                                        second.offset(), second.size());
+}
+
+absl::Status ValidateSliceAliases(const BufferAllocation::Slice& input,
+                                  const BufferAllocation::Slice& update,
+                                  const BufferAllocation::Slice& output) {
+  if (!SameSlice(input, output) && SliceOverlap(input, output)) {
+    return absl::InvalidArgumentError(
+        "dynamic-update-slice rejects partial input/output overlap");
+  }
+  if (SliceOverlap(update, output)) {
+    return absl::InvalidArgumentError(
+        "dynamic-update-slice rejects update/output overlap before write");
+  }
+  return absl::OkStatus();
+}
+
+absl::StatusOr<int64_t> ReadScalarStart(se::Stream* stream,
+                                        const NpuBufferAllocations* allocations,
+                                        const BufferAllocation::Slice& slice,
+                                        PrimitiveType element_type) {
+  se::DeviceMemoryBase address = allocations->GetDeviceAddress(slice);
+  if (element_type == S32) {
+    if (slice.size() < sizeof(int32_t) || address.opaque() == nullptr) {
+      return absl::InvalidArgumentError(
+          "dynamic-update-slice malformed s32 start index slice");
+    }
+    int32_t value = 0;
+    TF_RETURN_IF_ERROR(stream->Memcpy(&value, address, sizeof(value)));
+    return static_cast<int64_t>(value);
+  }
+  if (element_type == S64) {
+    if (slice.size() < sizeof(int64_t) || address.opaque() == nullptr) {
+      return absl::InvalidArgumentError(
+          "dynamic-update-slice malformed s64 start index slice");
+    }
+    int64_t value = 0;
+    TF_RETURN_IF_ERROR(stream->Memcpy(&value, address, sizeof(value)));
+    return value;
+  }
+  return absl::InvalidArgumentError(
+      "dynamic-update-slice start index must be scalar s32/s64");
+}
+
+absl::Status ValidateStartShape(const Shape& shape) {
+  if (!shape.IsArray() || shape.dimensions_size() != 0 ||
+      (shape.element_type() != S32 && shape.element_type() != S64)) {
+    return absl::InvalidArgumentError(
+        "dynamic-update-slice start index must be scalar s32/s64");
+  }
+  return absl::OkStatus();
+}
+
+absl::StatusOr<NpuDynamicUpdateSliceMetadata> BuildMetadata(
+    const std::vector<Shape>& param_shapes,
+    const std::vector<int64_t>& starts,
+    size_t start_index_count) {
+  if (param_shapes.size() != start_index_count + 3) {
+    return absl::InvalidArgumentError(
+        "dynamic-update-slice requires input, update, starts, and output shapes");
+  }
+  const Shape& input_shape = param_shapes[0];
+  const Shape& update_shape = param_shapes[1];
+  const Shape& output_shape = param_shapes.back();
+  if (!IsDenseRowMajorArray(input_shape) || !IsDenseRowMajorArray(update_shape) ||
+      !IsDenseRowMajorArray(output_shape)) {
+    return absl::UnimplementedError(
+        "dynamic-update-slice requires static dense untiled row-major arrays");
+  }
+  if (input_shape.dimensions() != output_shape.dimensions() ||
+      input_shape.element_type() != update_shape.element_type() ||
+      input_shape.element_type() != output_shape.element_type()) {
+    return absl::InvalidArgumentError(
+        "dynamic-update-slice input/update/output shape contract is invalid");
+  }
+  NpuDynamicUpdateSliceSpec spec;
+  spec.input_dims = ShapeDimensions(input_shape);
+  spec.update_dims = ShapeDimensions(update_shape);
+  spec.element_type = DynamicUpdateSliceElementType(input_shape.element_type());
+  NpuDynamicUpdateSliceMetadata metadata;
+  std::string error = ValidateNpuDynamicUpdateSlice(spec, starts, &metadata);
+  if (!error.empty()) return absl::UnimplementedError(error);
+  return metadata;
+}
+
+absl::Status ExecuteAclnnInplaceCopy(aclrtStream stream, uint64_t workspace_size,
+                                     aclOpExecutor* executor) {
+  void* workspace = nullptr;
+  if (workspace_size > 0) {
+    NpuWorkspaceMemoryPool* pool = NpuWorkspaceMemoryPool::GetInstance();
+    if (pool == nullptr) {
+      return absl::InternalError("Workspace memory pool not available");
+    }
+    TF_ASSIGN_OR_RETURN(workspace,
+                        pool->AllocateForStream(stream, workspace_size));
+  }
+  aclnnStatus status =
+      dep::aclnnInplaceCopy(workspace, workspace_size, executor, stream);
+  if (status != ACL_SUCCESS) {
+    return absl::InternalError(
+        absl::StrFormat("aclnnInplaceCopy failed: %d", status));
+  }
+  return absl::OkStatus();
+}
+
+}  // namespace
+
+NpuDynamicUpdateSliceThunk::NpuDynamicUpdateSliceThunk(
+    ThunkInfo info, BufferAllocation::Slice input,
+    BufferAllocation::Slice update,
+    std::vector<BufferAllocation::Slice> start_indices,
+    BufferAllocation::Slice output)
+    : NpuThunk(Kind::kKernel, std::move(info)),
+      input_(input),
+      update_(update),
+      start_indices_(std::move(start_indices)),
+      output_(output) {}
+
+NpuThunk::BufferUses NpuDynamicUpdateSliceThunk::buffer_uses() const {
+  BufferUses uses;
+  uses.reserve(start_indices_.size() + 3);
+  uses.push_back(BufferUse::Read(input_));
+  uses.push_back(BufferUse::Read(update_));
+  for (const BufferAllocation::Slice& start_index : start_indices_) {
+    uses.push_back(BufferUse::Read(start_index));
+  }
+  uses.push_back(BufferUse::Write(output_));
+  return uses;
+}
+
+absl::Status NpuDynamicUpdateSliceThunk::ExecuteOnStream(
+    const ExecuteParams& params) {
+  if (params.stream == nullptr || params.buffer_allocations == nullptr) {
+    return absl::InvalidArgumentError(
+        "dynamic-update-slice requires stream and buffer allocations");
+  }
+  auto stream_handle = params.stream->platform_specific_handle();
+  if (stream_handle.stream == nullptr) {
+    return absl::InternalError(
+        "dynamic-update-slice requires an initialized stream");
+  }
+  TF_RETURN_IF_ERROR(ValidateSliceAliases(input_, update_, output_));
+  const std::vector<Shape>& param_shapes = thunk_info().param_shapes;
+  if (param_shapes.size() != start_indices_.size() + 3) {
+    return absl::InvalidArgumentError(
+        "dynamic-update-slice ThunkInfo.param_shapes mismatch");
+  }
+  std::vector<int64_t> starts;
+  starts.reserve(start_indices_.size());
+  for (size_t start_index_number = 0; start_index_number < start_indices_.size();
+       ++start_index_number) {
+    const Shape& start_shape = param_shapes[start_index_number + 2];
+    TF_RETURN_IF_ERROR(ValidateStartShape(start_shape));
+    TF_ASSIGN_OR_RETURN(
+        int64_t start,
+        ReadScalarStart(params.stream, params.buffer_allocations,
+                        start_indices_[start_index_number],
+                        start_shape.element_type()));
+    starts.push_back(start);
+  }
+  TF_ASSIGN_OR_RETURN(NpuDynamicUpdateSliceMetadata metadata,
+                      BuildMetadata(param_shapes, starts, start_indices_.size()));
+  const Shape& input_shape = param_shapes[0];
+  const Shape& update_shape = param_shapes[1];
+  int64_t element_bytes =
+      ShapeUtil::ByteSizeOfPrimitiveType(input_shape.element_type());
+  int64_t input_bytes = metadata.input_elements * element_bytes;
+  int64_t update_bytes = metadata.update_elements * element_bytes;
+  if (input_bytes > input_.size() || input_bytes > output_.size() ||
+      update_bytes > update_.size()) {
+    return absl::InvalidArgumentError(
+        "dynamic-update-slice buffer slice is smaller than tensor payload");
+  }
+  se::DeviceMemoryBase input_address =
+      params.buffer_allocations->GetDeviceAddress(input_);
+  se::DeviceMemoryBase update_address =
+      params.buffer_allocations->GetDeviceAddress(update_);
+  se::DeviceMemoryBase output_address =
+      params.buffer_allocations->GetDeviceAddress(output_);
+  if (!SameSlice(input_, output_) && input_bytes != 0) {
+    TF_RETURN_IF_ERROR(params.stream->Memcpy(&output_address, input_address,
+                                             input_bytes));
+  }
+  if (metadata.update_elements == 0) return absl::OkStatus();
+  aclDataType data_type =
+      DynamicUpdateSliceAclType(input_shape.element_type());
+  std::vector<int64_t> update_dims = ShapeDimensions(update_shape);
+  std::vector<int64_t> update_strides = RowMajorStrides(update_dims);
+  std::unique_ptr<aclTensor, decltype(&dep::aclDestroyTensor)> update_tensor(
+      dep::aclCreateTensor(update_dims.data(), update_dims.size(), data_type,
+                           update_strides.data(), 0,
+                           aclFormat::ACL_FORMAT_ND, update_dims.data(),
+                           update_dims.size(), update_address.opaque()),
+      dep::aclDestroyTensor);
+  if (update_tensor == nullptr) {
+    return absl::InternalError(
+        "dynamic-update-slice failed to create update tensor");
+  }
+  std::vector<int64_t> input_dims = ShapeDimensions(input_shape);
+  std::unique_ptr<aclTensor, decltype(&dep::aclDestroyTensor)> output_view(
+      dep::aclCreateTensor(update_dims.data(), update_dims.size(), data_type,
+                           metadata.input_strides.data(),
+                           metadata.storage_offset, aclFormat::ACL_FORMAT_ND,
+                           input_dims.data(), input_dims.size(),
+                           output_address.opaque()),
+      dep::aclDestroyTensor);
+  if (output_view == nullptr) {
+    return absl::InternalError(
+        "dynamic-update-slice failed to create output view tensor");
+  }
+  uint64_t workspace_size = 0;
+  aclOpExecutor* executor = nullptr;
+  aclnnStatus status = dep::aclnnInplaceCopyGetWorkspaceSize(
+      output_view.get(), update_tensor.get(), &workspace_size, &executor);
+  if (status != ACL_SUCCESS) {
+    return absl::InternalError(absl::StrFormat(
+        "aclnnInplaceCopyGetWorkspaceSize failed: %d", status));
+  }
+  return ExecuteAclnnInplaceCopy(
+      static_cast<aclrtStream>(stream_handle.stream), workspace_size, executor);
+}
+
+}  // namespace xla
