+absl::Status LegalizeNativeBatchedGather(HloModule* module) {
+  TF_RETURN_IF_ERROR(NormalizeNativeBatchedRowWindowGather(module));
+  TF_RETURN_IF_ERROR(NormalizeNativeBatchedIntegerColumnGather(module));
+  for (HloComputation* computation : module->MakeNonfusionComputations()) {
+    std::vector<HloInstruction*> gathers;
+    for (HloInstruction* instruction : computation->instructions()) {
+      if (instruction->opcode() == HloOpcode::kGather &&
+          instruction->gather_dimension_numbers().operand_batching_dims_size() != 0) {
+        gathers.push_back(instruction);
+      }
+    }
+    for (HloInstruction* instruction : gathers) {
+      const auto& dimensions = instruction->gather_dimension_numbers();
+      const Shape& operand = instruction->operand(0)->shape();
+      const Shape& indices = instruction->operand(1)->shape();
+      const int64_t rank = indices.dimensions_size();
+      const int64_t operand_rank = operand.dimensions_size();
+      const int64_t batch_rank = dimensions.operand_batching_dims_size();
+      if (batch_rank < 1 || operand_rank <= batch_rank || operand_rank > 8 ||
+          rank <= batch_rank || rank > 8 || indices.element_type() != S32 ||
+          instruction->gather_slice_sizes().size() != operand_rank ||
+          dimensions.index_vector_dim() != rank - 1 ||
+          dimensions.start_indices_batching_dims_size() != batch_rank) {
+        return absl::UnimplementedError("Native batched gather requires bounded explicit leading batches");
+      }
+      for (int64_t axis = 0; axis < batch_rank; ++axis) {
+        if (dimensions.operand_batching_dims(axis) != axis ||
+            dimensions.start_indices_batching_dims(axis) != axis ||
+            operand.dimensions(axis) != indices.dimensions(axis) ||
+            indices.dimensions(axis) > (1 << 24) || instruction->gather_slice_sizes()[axis] != 1) {
+          return absl::UnimplementedError("Native batched gather requires matching leading batch axes");
+        }
+      }
+      bool full_vertex_window = rank == batch_rank + 1 &&
+          indices.dimensions(rank - 1) == operand_rank - batch_rank &&
+          dimensions.start_index_map_size() == operand_rank - batch_rank &&
+          dimensions.collapsed_slice_dims_size() == 0 &&
+          dimensions.offset_dims_size() == operand_rank - batch_rank &&
+          LayoutUtil::IsMonotonicWithDim0Major(instruction->shape().layout()) &&
+          instruction->shape().layout().tiles_size() == 0;
+      if (full_vertex_window) {
+        for (int64_t axis = batch_rank; axis < operand_rank; ++axis) {
+          if (dimensions.start_index_map(axis - batch_rank) != axis ||
+              dimensions.offset_dims(axis - batch_rank) != axis ||
+              (axis > batch_rank && instruction->gather_slice_sizes()[axis] != operand.dimensions(axis))) {
+            full_vertex_window = false;
+          }
+        }
+      }
+      const bool collapsed_column = indices.dimensions(rank - 1) == 1 &&
+          dimensions.start_index_map_size() == 1 && dimensions.start_index_map(0) == batch_rank &&
+          dimensions.collapsed_slice_dims_size() == 1 && dimensions.collapsed_slice_dims(0) == batch_rank;
+      const Shape& output = instruction->shape();
+      bool multi_index_prefix = batch_rank == 1 && operand_rank == 4 && rank == 3 &&
+          operand.element_type() == F32 && output.element_type() == F32 &&
+          indices.dimensions(2) == 2 && dimensions.start_index_map_size() == 2 &&
+          dimensions.start_index_map(0) == 1 && dimensions.start_index_map(1) == 2 &&
+          dimensions.collapsed_slice_dims_size() == 2 &&
+          dimensions.collapsed_slice_dims(0) == 1 && dimensions.collapsed_slice_dims(1) == 2 &&
+          dimensions.offset_dims_size() == 1 && dimensions.offset_dims(0) == 2 &&
+          output.dimensions_size() == 3 && output.dimensions(0) == operand.dimensions(0) &&
+          output.dimensions(1) == indices.dimensions(1) && output.dimensions(2) == operand.dimensions(3) &&
+          instruction->gather_slice_sizes()[2] == 1 &&
+          instruction->gather_slice_sizes()[3] == operand.dimensions(3);
+      if (multi_index_prefix) {
+        for (const Shape* shape : {&operand, &indices, &output}) {
+          if (!shape->has_layout() || !LayoutUtil::IsDenseArray(*shape) ||
+              !LayoutUtil::IsMonotonicWithDim0Major(shape->layout()) ||
+              shape->layout().tiles_size() != 0) {
+            multi_index_prefix = false;
+          }
+          for (int64_t axis = 0; axis < shape->dimensions_size(); ++axis) {
+            if (shape->is_dynamic_dimension(axis) || shape->dimensions(axis) <= 0) {
+              multi_index_prefix = false;
+            }
+          }
+        }
+        if (multi_index_prefix) {
+          int64_t prefix_size = 1;
+          for (int64_t axis = 0; axis < 3; ++axis) {
+            if (prefix_size > INT32_MAX / operand.dimensions(axis)) {
+              multi_index_prefix = false;
+              break;
+            }
+            prefix_size *= operand.dimensions(axis);
+          }
+        }
+      }
+      if ((!full_vertex_window && !collapsed_column && !multi_index_prefix) ||
+          instruction->gather_slice_sizes()[batch_rank] != 1) {
+        return absl::UnimplementedError(absl::StrCat(
+            "Native batched gather requires leading batches and one sliced index axis: ",
+            instruction->ToString()));
+      }
+      HloInstruction* columns = instruction->mutable_operand(1);
+      std::vector<int64_t> component_dimensions(indices.dimensions().begin(), indices.dimensions().end());
+      component_dimensions.back() = 1;
+      const Shape component_shape = ShapeUtil::MakeShape(S32, component_dimensions);
+      if (full_vertex_window) {
+        std::vector<int64_t> starts(rank, 0);
+        std::vector<int64_t> strides(rank, 1);
+        columns = computation->AddInstruction(HloInstruction::CreateSlice(
+            component_shape, columns, starts, component_dimensions, strides));
+      }
+      std::vector<HloInstruction*> components;
+      for (int64_t axis = 0; axis < batch_rank; ++axis) {
+        HloInstruction* batch_axis = computation->AddInstruction(HloInstruction::CreateIota(
+            ShapeUtil::MakeShape(S32, {indices.dimensions(axis)}), 0));
+        components.push_back(computation->AddInstruction(
+            HloInstruction::CreateBroadcast(component_shape, batch_axis, {axis})));
+      }
+      components.push_back(columns);
+      const int64_t indexed_axes = multi_index_prefix ? 2 : 1;
+      std::vector<int64_t> explicit_dimensions(indices.dimensions().begin(), indices.dimensions().end());
+      explicit_dimensions.back() = batch_rank + indexed_axes;
+      HloInstruction* explicit_indices = computation->AddInstruction(HloInstruction::CreateConcatenate(
+          ShapeUtil::MakeShape(S32, explicit_dimensions), components, rank - 1));
+      GatherDimensionNumbers normalized;
+      for (int64_t axis = 0; axis < batch_rank + indexed_axes; ++axis) {
+        normalized.add_start_index_map(axis);
+        normalized.add_collapsed_slice_dims(axis);
+      }
+      normalized.set_index_vector_dim(rank - 1);
+      if (full_vertex_window) {
+        std::vector<int64_t> window_dimensions(operand.dimensions().begin(), operand.dimensions().begin() + batch_rank);
+        window_dimensions.insert(window_dimensions.end(), operand.dimensions().begin() + batch_rank + 1,
+                                 operand.dimensions().end());
+        for (int64_t axis = batch_rank; axis < window_dimensions.size(); ++axis) normalized.add_offset_dims(axis);
+        HloInstruction* gathered = computation->AddInstruction(HloInstruction::CreateGather(
+            ShapeUtil::MakeShape(operand.element_type(), window_dimensions),
+            instruction->mutable_operand(0), explicit_indices, normalized,
+            instruction->gather_slice_sizes(), false));
+        TF_RETURN_IF_ERROR(computation->ReplaceWithNewInstruction(instruction,
+            HloInstruction::CreateReshape(instruction->shape(), gathered)));
+      } else {
+        for (int64_t axis : dimensions.offset_dims()) normalized.add_offset_dims(axis);
+        TF_RETURN_IF_ERROR(computation->ReplaceWithNewInstruction(instruction,
+            HloInstruction::CreateGather(instruction->shape(), instruction->mutable_operand(0),
+                                         explicit_indices, normalized, instruction->gather_slice_sizes(), false)));
+      }
+    }
+  }
+  return absl::OkStatus();
+}
