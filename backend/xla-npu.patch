+}
+
+absl::Status NpuCumsumThunk::ExecuteOnStream(const ExecuteParams& params) {
+  const auto& shapes = thunk_info().param_shapes;
+  if (params.stream == nullptr || params.buffer_allocations == nullptr ||
+      shapes.size() != 3 || !ShapeUtil::Equal(shapes.front(), shapes.back())) {
+    return absl::InvalidArgumentError("Cumsum requires initialized stream and matching input/output");
+  }
+  const Shape& shape = shapes.front();
+  if (!shape.IsArray() || shape.element_type() != S32 || shape.dimensions_size() != 1 ||
+      shape.is_dynamic_dimension(0) || !shape.has_layout() ||
+      !LayoutUtil::IsDenseArray(shape) || shape.layout().tiles_size() != 0 ||
+      shape.layout().element_size_in_bits() != 0 ||
+      shape.layout().minor_to_major_size() != 1 || shape.layout().minor_to_major(0) != 0) {
+    return absl::UnimplementedError("Cumsum requires static dense untiled rank-one s32");
+  }
+  int64_t extent = shape.dimensions(0);
+  if (extent < 1 || extent > (1LL << 24)) {
+    return absl::UnimplementedError("Cumsum extent exceeds bounded prefix scope");
+  }
+  int64_t bytes = extent * sizeof(int32_t);
+  if (input_.size() < bytes || output_.size() < bytes) {
+    return absl::InvalidArgumentError("Cumsum payload exceeds allocation slice");
+  }
+  if (input_.index() == output_.index() && input_.offset() < output_.offset() + output_.size() &&
+      output_.offset() < input_.offset() + input_.size()) {
+    return absl::UnimplementedError("Cumsum input/output may not overlap");
+  }
+  auto input_address = params.buffer_allocations->GetDeviceAddress(input_);
+  auto output_address = params.buffer_allocations->GetDeviceAddress(output_);
+  auto stream = static_cast<aclrtStream>(params.stream->platform_specific_handle().stream);
+  if (stream == nullptr || input_address.opaque() == nullptr || output_address.opaque() == nullptr) {
+    return absl::InvalidArgumentError("Cumsum device stream/address is null");
+  }
+  auto destroy_tensor = [](aclTensor* tensor) { dep::aclDestroyTensor(tensor); };
+  std::unique_ptr<aclTensor, decltype(destroy_tensor)> input_tensor(
+      NpuTool::CreateAclTensorPtr(shape, S32, input_address.opaque()), destroy_tensor);
+  std::unique_ptr<aclTensor, decltype(destroy_tensor)> output_tensor(
+      NpuTool::CreateAclTensorPtr(shape, S32, output_address.opaque()), destroy_tensor);
+  if (!input_tensor || !output_tensor) {
+    return absl::InternalError("Cumsum tensor descriptor creation failed");
+  }
+  uint64_t workspace_size = 0;
+  aclOpExecutor* executor = nullptr;
+  if (dep::aclnnCumsumGetWorkspaceSize(input_tensor.get(), 0, ACL_INT32,
+      output_tensor.get(), &workspace_size, &executor) != ACL_SUCCESS) {
+    return absl::InternalError("Cumsum workspace query failed");
+  }
+  void* workspace = nullptr;
+  if (workspace_size != 0) {
+    auto* pool = NpuWorkspaceMemoryPool::GetInstance();
+    if (pool == nullptr) return absl::InternalError("Cumsum workspace pool unavailable");
+    TF_ASSIGN_OR_RETURN(workspace, pool->AllocateForStream(stream, workspace_size));
+  }
+  if (dep::aclnnCumsum(workspace, workspace_size, executor, stream) != ACL_SUCCESS) {
+    return absl::InternalError("Cumsum native execution failed");
+  }
+  return absl::OkStatus();
+}
+
+}
