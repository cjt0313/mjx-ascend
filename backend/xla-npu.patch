+        index_view, lower.get(), nonnegative, &workspace_size, &executor), dep::aclnnGeScalar));
+    TF_RETURN_IF_ERROR(run(dep::aclnnLtScalarGetWorkspaceSize(
+        index_view, limit.get(), below_extent, &workspace_size, &executor), dep::aclnnLtScalar));
+    TF_RETURN_IF_ERROR(run(dep::aclnnBitwiseAndTensorGetWorkspaceSize(
+        nonnegative, below_extent, valid, &workspace_size, &executor), dep::aclnnBitwiseAndTensor));
