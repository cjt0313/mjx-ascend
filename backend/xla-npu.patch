+absl::Status NpuIrEmitterUnnested::EmitDynamicUpdateSlice(const HloInstruction* instr) {
+  if (!instr->shape().IsArray() || instr->shape().dimensions_size() < 1 ||
+      instr->operand_count() != instr->shape().dimensions_size() + 2) {
+    return absl::UnimplementedError("DynamicUpdateSlice requires array and one start per axis");
+  }
+  TF_ASSIGN_OR_RETURN(auto input, GetAllocationSliceForHlo(instr->operand(0)));
+  TF_ASSIGN_OR_RETURN(auto update, GetAllocationSliceForHlo(instr->operand(1)));
+  std::vector<BufferAllocation::Slice> starts;
+  for (int64_t operand = 2; operand < instr->operand_count(); ++operand) {
+    TF_ASSIGN_OR_RETURN(auto start, GetAllocationSliceForHlo(instr->operand(operand)));
+    starts.push_back(start);
+  }
+  TF_ASSIGN_OR_RETURN(auto output, GetAllocationSliceForHlo(instr));
+  AddThunkToThunkSequence(std::make_unique<NpuDynamicUpdateSliceThunk>(
+      NpuThunk::ThunkInfo::WithProfileAnnotation(instr, ir_emitter_context_->GetNextThunkId()),
+      input, update, std::move(starts), output));
+  return absl::OkStatus();
+}
