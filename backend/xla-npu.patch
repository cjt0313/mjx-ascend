+absl::Status LegalizeNativeIntegerArgIndex(HloModule* module) {
+  for (auto* computation : module->computations()) {
+    for (auto* instruction : computation->MakeInstructionPostOrder()) {
+      if (instruction->opcode() != HloOpcode::kReduce || !instruction->shape().IsTuple() ||
+          instruction->shape().tuple_shapes_size() != 2 || instruction->operand_count() != 4 ||
+          instruction->dimensions().size() != 1 || instruction->dimensions()[0] != 0 ||
+          instruction->user_count() == 0 || instruction == computation->root_instruction()) continue;
+      const Shape& input = instruction->operand(0)->shape();
+      const auto* indices = instruction->operand(1);
+      const auto* value_init = instruction->operand(2);
+      const auto* index_init = instruction->operand(3);
+      if (input.element_type() != S32) continue;
+      if (!input.IsArray() || input.element_type() != S32 || input.dimensions_size() != 1 ||
+          input.is_dynamic_dimension(0) || input.dimensions(0) < 1 || input.dimensions(0) > 64 ||
+          !indices->shape().IsArray() || indices->shape().element_type() != S32 ||
+          !ShapeUtil::SameDimensions(input, indices->shape()) || indices->opcode() != HloOpcode::kIota ||
+          Cast<HloIotaInstruction>(indices)->iota_dimension() != 0 ||
+          value_init->opcode() != HloOpcode::kConstant || index_init->opcode() != HloOpcode::kConstant ||
+          !ShapeUtil::IsScalar(value_init->shape()) || !ShapeUtil::IsScalar(index_init->shape()) ||
+          value_init->shape().element_type() != S32 || index_init->shape().element_type() != S32 ||
+          index_init->literal().GetFirstElement<int32_t>() != 0 ||
+          !ShapeUtil::IsScalar(instruction->shape().tuple_shapes(0)) ||
+          !ShapeUtil::IsScalar(instruction->shape().tuple_shapes(1)) ||
+          instruction->shape().tuple_shapes(0).element_type() != S32 ||
+          instruction->shape().tuple_shapes(1).element_type() != S32) {
+        return absl::UnimplementedError(absl::StrCat(
+            "S32 ArgIndex metadata rejected: ", instruction->ToString()));
+      }
+      bool supported = true;
+      for (const auto* user : instruction->users()) {
+        if (user->opcode() != HloOpcode::kGetTupleElement || user->tuple_index() != 1) supported = false;
+      }
+      if (!supported) return absl::UnimplementedError("S32 ArgIndex non-index user");
+      int32_t initial = value_init->literal().GetFirstElement<int32_t>();
+      bool is_max = initial == std::numeric_limits<int32_t>::min();
+      if (!is_max && initial != std::numeric_limits<int32_t>::max()) {
+        return absl::UnimplementedError("S32 ArgIndex value initializer");
+      }
+      const auto* reducer = instruction->to_apply();
+      const auto* root = reducer->root_instruction();
+      if (reducer->num_parameters() != 4 || reducer->instruction_count() != 12 ||
+          root->opcode() != HloOpcode::kTuple || root->operand_count() != 2) {
+        return absl::UnimplementedError(absl::StrCat(
+            "S32 ArgIndex reducer arity/count rejected: ", reducer->num_parameters(), "/",
+            reducer->instruction_count()));
+      }
+      const auto* lhs = reducer->parameter_instruction(0);
+      const auto* lhs_index = reducer->parameter_instruction(1);
+      const auto* rhs = reducer->parameter_instruction(2);
+      const auto* rhs_index = reducer->parameter_instruction(3);
+      for (const auto* parameter : {lhs, lhs_index, rhs, rhs_index}) {
+        if (!ShapeUtil::IsScalar(parameter->shape()) || parameter->shape().element_type() != S32) {
+          supported = false;
+        }
+      }
+      if (!supported) return absl::UnimplementedError("S32 ArgIndex parameter types");
+      const auto matches_compare = [](const HloInstruction* node, const HloInstruction* first,
+                                      const HloInstruction* second, ComparisonDirection direction) {
+        return node->opcode() == HloOpcode::kCompare && node->operand_count() == 2 &&
+               node->operand(0) == first && node->operand(1) == second &&
+               node->comparison_direction() == direction;
+      };
+      const auto* values = root->operand(0);
+      const auto* result_indices = root->operand(1);
+      if (values->opcode() != HloOpcode::kSelect || values->operand_count() != 3 ||
+          values->operand(1) != lhs || values->operand(2) != rhs ||
+          result_indices->opcode() != HloOpcode::kSelect || result_indices->operand_count() != 3 ||
+          result_indices->operand(1) != lhs_index || result_indices->operand(2) != rhs_index) {
+        return absl::UnimplementedError("S32 ArgIndex select graph");
+      }
+      const auto* value_predicate = values->operand(0);
+      const auto* index_predicate = result_indices->operand(0);
+      if (!matches_compare(value_predicate, lhs, rhs,
+                           is_max ? ComparisonDirection::kGt : ComparisonDirection::kLt) ||
+          index_predicate->opcode() != HloOpcode::kOr || index_predicate->operand_count() != 2 ||
+          index_predicate->operand(0) != value_predicate) {
+        return absl::UnimplementedError("S32 ArgIndex predicate graph");
+      }
+      const auto* tie = index_predicate->operand(1);
+      if (tie->opcode() != HloOpcode::kAnd || tie->operand_count() != 2 ||
+          !matches_compare(tie->operand(0), lhs, rhs, ComparisonDirection::kEq) ||
+          !matches_compare(tie->operand(1), lhs_index, rhs_index, ComparisonDirection::kLt)) {
+        return absl::UnimplementedError("S32 ArgIndex tie graph");
+      }
+      Shape scalar = ShapeUtil::MakeShape(S32, {});
+      Shape predicate = ShapeUtil::MakeShape(PRED, {});
+      HloInstruction* best_value = instruction->mutable_operand(2);
+      HloInstruction* best_index = instruction->mutable_operand(3);
+      for (int64_t index = 0; index < input.dimensions(0); ++index) {
+        auto* slice = computation->AddInstruction(HloInstruction::CreateSlice(
+            ShapeUtil::MakeShape(S32, {1}), instruction->mutable_operand(0),
+            {index}, {index + 1}, {1}));
+        auto* value = computation->AddInstruction(HloInstruction::CreateReshape(scalar, slice));
+        auto* improves = computation->AddInstruction(HloInstruction::CreateCompare(
+            predicate, value, best_value,
+            is_max ? ComparisonDirection::kGt : ComparisonDirection::kLt));
+        auto* index_value = computation->AddInstruction(HloInstruction::CreateConstant(
+            LiteralUtil::CreateR0<int32_t>(static_cast<int32_t>(index))));
+        best_index = computation->AddInstruction(HloInstruction::CreateTernary(
+            scalar, HloOpcode::kSelect, improves, index_value, best_index));
+        best_value = computation->AddInstruction(HloInstruction::CreateTernary(
+            scalar, HloOpcode::kSelect, improves, value, best_value));
+      }
+      auto* replacement = computation->AddInstruction(HloInstruction::CreateTuple({best_value, best_index}));
+      instruction->SetupDerivedInstruction(replacement);
+      TF_ASSIGN_OR_RETURN(bool replaced,
+          computation->ReplaceInstruction(instruction, replacement, true, true));
+      if (!replaced) return absl::InternalError("Native integer arg-index replacement was rejected");
+    }
+  }
+  return absl::OkStatus();
+}
