+absl::Status NormalizeNativeBatchedIntegerColumnQueries(HloModule* module) {
+  for (HloComputation* computation : module->MakeNonfusionComputations()) {
+    std::vector<HloInstruction*> gathers;
+    for (HloInstruction* instruction : computation->instructions()) {
+      if (instruction->opcode() == HloOpcode::kGather) gathers.push_back(instruction);
+    }
+    for (HloInstruction* instruction : gathers) {
+      const auto& dimensions = instruction->gather_dimension_numbers();
+      const Shape& operand = instruction->operand(0)->shape();
+      const Shape& indices = instruction->operand(1)->shape();
+      const Shape& output = instruction->shape();
+      if (operand.dimensions_size() != 3 || indices.dimensions_size() != 4 ||
+          output.dimensions_size() != 4 || operand.element_type() != S32 ||
+          indices.element_type() != S32 || output.element_type() != S32 ||
+          dimensions.operand_batching_dims_size() != 1 || dimensions.operand_batching_dims(0) != 0 ||
+          dimensions.start_indices_batching_dims_size() != 1 ||
+          dimensions.start_indices_batching_dims(0) != 0 || dimensions.index_vector_dim() != 3 ||
+          dimensions.start_index_map_size() != 1 || dimensions.start_index_map(0) != 2 ||
+          dimensions.collapsed_slice_dims_size() != 1 || dimensions.collapsed_slice_dims(0) != 2 ||
+          dimensions.offset_dims_size() != 1 || dimensions.offset_dims(0) != 1 ||
+          instruction->gather_slice_sizes().size() != 3 ||
+          instruction->gather_slice_sizes()[0] != 1 ||
+          instruction->gather_slice_sizes()[1] != operand.dimensions(1) ||
+          instruction->gather_slice_sizes()[2] != 1 ||
+          indices.dimensions(0) != operand.dimensions(0) || indices.dimensions(3) != 1 ||
+          output.dimensions(0) != operand.dimensions(0) || output.dimensions(1) != operand.dimensions(1) ||
+          output.dimensions(2) != indices.dimensions(1) || output.dimensions(3) != indices.dimensions(2) ||
+          operand.dimensions(0) > (1 << 24)) {
+        continue;
+      }
+      bool bounded_static = true;
+      for (const Shape* shape : {&operand, &indices, &output}) {
+        if (!shape->has_layout() || !LayoutUtil::IsDenseArray(*shape) ||
+            !LayoutUtil::IsMonotonicWithDim0Major(shape->layout()) || shape->layout().tiles_size() != 0) {
+          bounded_static = false;
+        }
+        for (int64_t axis = 0; axis < shape->dimensions_size(); ++axis) {
+          if (shape->is_dynamic_dimension(axis) || shape->dimensions(axis) <= 0) bounded_static = false;
+        }
+      }
+      if (!bounded_static || indices.dimensions(1) > INT32_MAX / indices.dimensions(2)) continue;
+      const int64_t queries = indices.dimensions(1) * indices.dimensions(2);
+      HloInstruction* flattened_indices = computation->AddInstruction(HloInstruction::CreateReshape(
+          ShapeUtil::MakeShape(S32, {indices.dimensions(0), queries, 1}), instruction->mutable_operand(1)));
+      GatherDimensionNumbers normalized = dimensions;
+      normalized.set_index_vector_dim(2);
+      HloInstruction* gathered = computation->AddInstruction(HloInstruction::CreateGather(
+          ShapeUtil::MakeShape(S32, {output.dimensions(0), output.dimensions(1), queries}),
+          instruction->mutable_operand(0), flattened_indices, normalized, instruction->gather_slice_sizes(), false));
+      TF_RETURN_IF_ERROR(computation->ReplaceWithNewInstruction(instruction,
+          HloInstruction::CreateReshape(output, gathered)));
+    }
+  }
+  return absl::OkStatus();
+}
