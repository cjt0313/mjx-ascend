new file mode 100644
index 0000000..6c38d79
--- /dev/null
+++ b/xla_npu/common/npu_tensor_strides.h
@@ -0,0 +1,36 @@
+#ifndef XLA_XLA_NPU_COMMON_NPU_TENSOR_STRIDES_H_
+#define XLA_XLA_NPU_COMMON_NPU_TENSOR_STRIDES_H_
+
+#include <cstdint>
+#include <limits>
+#include <optional>
+#include <vector>
+
+namespace xla {
+
+inline std::optional<std::vector<int64_t>> NpuTensorElementStrides(
+    const std::vector<int64_t>& dimensions,
+    const std::vector<int64_t>& minor_to_major) {
+  if (dimensions.size() != minor_to_major.size()) return std::nullopt;
+  std::vector<int64_t> strides(dimensions.size());
+  std::vector<bool> seen(dimensions.size(), false);
+  int64_t running_stride = 1;
+  for (int64_t dimension : minor_to_major) {
+    if (dimension < 0 || static_cast<uint64_t>(dimension) >= dimensions.size() ||
+        seen[dimension] || dimensions[dimension] < 0) {
+      return std::nullopt;
+    }
+    seen[dimension] = true;
+    strides[dimension] = running_stride;
+    if (dimensions[dimension] != 0 &&
+        running_stride > std::numeric_limits<int64_t>::max() / dimensions[dimension]) {
+      return std::nullopt;
+    }
+    running_stride *= dimensions[dimension];
+  }
+  return strides;
+}
+
+}
+
+#endif
