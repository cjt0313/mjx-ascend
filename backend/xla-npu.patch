+absl::Status LegalizeNativeColumnGather(HloModule* module) {
+  for (HloComputation* computation : module->MakeNonfusionComputations()) {
+    std::vector<HloInstruction*> gathers;
+    for (HloInstruction* instruction : computation->instructions()) {
+      if (instruction->opcode() == HloOpcode::kGather &&
+          instruction->gather_dimension_numbers().start_index_map_size() == 1 &&
+          instruction->gather_dimension_numbers().start_index_map(0) == 1) {
+        gathers.push_back(instruction);
+      }
+    }
+    for (HloInstruction* instruction : gathers) {
+      const auto& dimensions = instruction->gather_dimension_numbers();
+      const Shape& operand = instruction->operand(0)->shape();
+      const Shape& indices = instruction->operand(1)->shape();
+      const int64_t operand_rank = operand.dimensions_size();
+      const int64_t index_rank = indices.dimensions_size();
+      const int64_t batch_rank = index_rank - 1;
+      if (operand_rank < 2 || operand_rank > 8 || index_rank < 1 || index_rank > 8 ||
+          indices.element_type() != S32 || indices.dimensions(index_rank - 1) != 1 ||
+          dimensions.index_vector_dim() != index_rank - 1 || dimensions.collapsed_slice_dims_size() != 1 ||
+          dimensions.collapsed_slice_dims(0) != 1 || dimensions.offset_dims_size() != operand_rank - 1 ||
+          dimensions.operand_batching_dims_size() != 0 ||
+          dimensions.start_indices_batching_dims_size() != 0 ||
+          instruction->gather_slice_sizes()[1] != 1) {
+        return absl::UnimplementedError(absl::StrCat(
+            "Native column gather requires bounded full axis-one slices: ", instruction->ToString()));
+      }
+      std::vector<int64_t> permutation = {1, 0};
+      std::vector<int64_t> trailing_dimensions = {operand.dimensions(0)};
+      for (int64_t axis = 0; axis < operand_rank; ++axis) {
+        if (axis != 1 && instruction->gather_slice_sizes()[axis] != operand.dimensions(axis)) {
+          return absl::UnimplementedError("Native column gather requires full nonindexed dimensions");
+        }
+        if (axis >= 2) {
+          permutation.push_back(axis);
+          trailing_dimensions.push_back(operand.dimensions(axis));
+        }
+      }
+      HloInstruction* transposed = computation->AddInstruction(HloInstruction::CreateTranspose(
+          ShapeUtil::PermuteDimensions(permutation, operand), instruction->mutable_operand(0), permutation));
+      GatherDimensionNumbers normalized;
+      normalized.add_start_index_map(0);
+      normalized.add_collapsed_slice_dims(0);
+      normalized.set_index_vector_dim(index_rank - 1);
+      std::vector<int64_t> output_dimensions(indices.dimensions().begin(), indices.dimensions().end() - 1);
+      output_dimensions.insert(output_dimensions.end(), trailing_dimensions.begin(), trailing_dimensions.end());
+      std::vector<int64_t> slice_sizes = {1};
+      slice_sizes.insert(slice_sizes.end(), trailing_dimensions.begin(), trailing_dimensions.end());
+      for (int64_t axis = 0; axis < trailing_dimensions.size(); ++axis) {
+        normalized.add_offset_dims(batch_rank + axis);
+      }
+      HloInstruction* gathered = computation->AddInstruction(HloInstruction::CreateGather(
+          ShapeUtil::MakeShape(operand.element_type(), output_dimensions), transposed,
+          instruction->mutable_operand(1), normalized, slice_sizes, false));
+      std::vector<int64_t> output_permutation(output_dimensions.size(), -1);
+      for (int64_t offset = 0; offset < dimensions.offset_dims_size(); ++offset) {
+        output_permutation[dimensions.offset_dims(offset)] = batch_rank + offset;
+      }
+      int64_t batch_axis = 0;
+      for (int64_t& axis : output_permutation) {
+        if (axis == -1) axis = batch_axis++;
+      }
+      TF_RETURN_IF_ERROR(computation->ReplaceWithNewInstruction(instruction,
+          HloInstruction::CreateTranspose(instruction->shape(), gathered, output_permutation)));
+    }
+  }
+  return absl::OkStatus();
+}
