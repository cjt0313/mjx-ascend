+absl::Status LegalizeNativePrefixGather(HloModule* module) {
+  for (HloComputation* computation : module->MakeNonfusionComputations()) {
+    std::vector<HloInstruction*> gathers;
+    for (HloInstruction* instruction : computation->instructions()) {
+      if (instruction->opcode() == HloOpcode::kGather &&
+          instruction->gather_dimension_numbers().collapsed_slice_dims_size() > 1) {
+        gathers.push_back(instruction);
+      }
+    }
+    for (HloInstruction* instruction : gathers) {
+      const auto& dimensions = instruction->gather_dimension_numbers();
+      const Shape& operand = instruction->operand(0)->shape();
+      const Shape& indices = instruction->operand(1)->shape();
+      const int64_t prefix_rank = dimensions.collapsed_slice_dims_size();
+      const int64_t operand_rank = operand.dimensions_size();
+      const int64_t index_rank = indices.dimensions_size();
+      if (operand_rank > 8 || prefix_rank > operand_rank || index_rank < 1 || index_rank > 8 ||
+          !LayoutUtil::IsMonotonicWithDim0Major(instruction->shape().layout()) ||
+          operand.layout().tiles_size() != 0 || instruction->shape().layout().tiles_size() != 0 ||
+          indices.element_type() != S32 || dimensions.index_vector_dim() != index_rank - 1 ||
+          indices.dimensions(index_rank - 1) != prefix_rank ||
+          dimensions.start_index_map_size() != prefix_rank ||
+          dimensions.operand_batching_dims_size() != 0 ||
+          dimensions.start_indices_batching_dims_size() != 0 ||
+          dimensions.offset_dims_size() != operand_rank - prefix_rank) {
+        return absl::UnimplementedError(absl::StrCat(
+            "Native tuple gather requires a collapsed leading prefix: ", instruction->ToString(),
+            "; operand=", ShapeUtil::HumanStringWithLayout(operand),
+            "; indices=", ShapeUtil::HumanStringWithLayout(indices)));
+      }
+      int64_t prefix_size = 1;
+      for (int64_t axis = 0; axis < operand_rank; ++axis) {
+        if (operand.dimensions(axis) <= 0 || operand.is_dynamic_dimension(axis)) {
+          return absl::UnimplementedError("Native tuple gather requires positive static dimensions");
+        }
+        if (axis < prefix_rank) {
+          if (dimensions.collapsed_slice_dims(axis) != axis ||
+              dimensions.start_index_map(axis) != axis ||
+              instruction->gather_slice_sizes()[axis] != 1 ||
+              prefix_size > INT32_MAX / operand.dimensions(axis)) {
+            return absl::UnimplementedError("Native tuple gather requires bounded ordered prefix axes");
+          }
+          prefix_size *= operand.dimensions(axis);
+        } else if (instruction->gather_slice_sizes()[axis] != operand.dimensions(axis) ||
+                   dimensions.offset_dims(axis - prefix_rank) != index_rank - 1 + axis - prefix_rank) {
+          return absl::UnimplementedError("Native tuple gather requires full trailing slices");
+        }
+      }
+      std::vector<int64_t> index_dimensions(indices.dimensions().begin(), indices.dimensions().end());
+      index_dimensions.back() = 1;
+      const Shape component_shape = ShapeUtil::MakeShape(S32, index_dimensions);
+      auto bound = [&](int32_t value) {
+        HloInstruction* scalar = computation->AddInstruction(HloInstruction::CreateConstant(
+            LiteralUtil::CreateR0<int32_t>(value)));
+        return computation->AddInstruction(HloInstruction::CreateBroadcast(component_shape, scalar, {}));
+      };
+      HloInstruction* linear = bound(0);
+      for (int64_t axis = 0; axis < prefix_rank; ++axis) {
+        std::vector<int64_t> starts(index_rank, 0);
+        std::vector<int64_t> limits(indices.dimensions().begin(), indices.dimensions().end());
+        std::vector<int64_t> strides(index_rank, 1);
+        starts.back() = axis;
+        limits.back() = axis + 1;
+        HloInstruction* component = computation->AddInstruction(HloInstruction::CreateSlice(
+            component_shape, instruction->mutable_operand(1), starts, limits, strides));
+        component = computation->AddInstruction(HloInstruction::CreateBinary(
+            component_shape, HloOpcode::kMaximum, component, bound(0)));
+        component = computation->AddInstruction(HloInstruction::CreateBinary(
+            component_shape, HloOpcode::kMinimum, component, bound(operand.dimensions(axis) - 1)));
+        linear = computation->AddInstruction(HloInstruction::CreateBinary(
+            component_shape, HloOpcode::kMultiply, linear, bound(operand.dimensions(axis))));
+        linear = computation->AddInstruction(HloInstruction::CreateBinary(
+            component_shape, HloOpcode::kAdd, linear, component));
+      }
+      std::vector<int64_t> flat_dimensions = {prefix_size};
+      flat_dimensions.insert(flat_dimensions.end(), operand.dimensions().begin() + prefix_rank,
+                             operand.dimensions().end());
+      HloInstruction* materialized_operand = instruction->mutable_operand(0);
+      if (!LayoutUtil::IsMonotonicWithDim0Major(operand.layout())) {
+        std::vector<int64_t> identity_dimensions;
+        for (int64_t axis = 0; axis < operand_rank; ++axis) identity_dimensions.push_back(axis);
+        std::vector<int64_t> dense_dimensions(operand.dimensions().begin(), operand.dimensions().end());
+        materialized_operand = computation->AddInstruction(HloInstruction::CreateTranspose(
+            ShapeUtil::MakeShape(operand.element_type(), dense_dimensions), materialized_operand,
+            identity_dimensions));
+      }
+      HloInstruction* flattened = computation->AddInstruction(HloInstruction::CreateReshape(
+          ShapeUtil::MakeShape(operand.element_type(), flat_dimensions), materialized_operand));
+      GatherDimensionNumbers normalized;
+      normalized.add_start_index_map(0);
+      normalized.add_collapsed_slice_dims(0);
+      normalized.set_index_vector_dim(index_rank - 1);
+      std::vector<int64_t> slice_sizes = flat_dimensions;
+      slice_sizes[0] = 1;
+      for (int64_t axis = 1; axis < flat_dimensions.size(); ++axis) {
+        normalized.add_offset_dims(index_rank - 1 + axis - 1);
+      }
+      TF_RETURN_IF_ERROR(computation->ReplaceWithNewInstruction(instruction,
+          HloInstruction::CreateGather(instruction->shape(), flattened, linear, normalized,
+                                       slice_sizes, false)));
+    }
+  }
+  return absl::OkStatus();
+}
